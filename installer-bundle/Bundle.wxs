<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    YemekhaneProKurulum-<sürüm>.exe: MSI'yi saran bootstrapper.

    MSI cift tiklandiginda UAC yukseltmesi isteyemez; perMachine paket oldugu icin kurulum
    Error 1925 ile sessizce iptal olur ve kullanici yalnizca dolan bir ilerleme cubugu gorur.
    Bootstrapper yukseltmeyi kendisi ister ve lisans/ilerleme ekranlarini gosterir.
  -->
  <!-- Name surum icerir: kurulum penceresi basliginda ve Programlar listesinde gorunur. -->
  <Bundle Name="YemekhanePro $(var.ProductVersion)"
          Manufacturer="YemekhanePro"
          Version="$(var.ProductVersion)"
          UpgradeCode="B7E4A1C2-9D35-4E88-8F1A-3C6D0B5E7A44"
          Compressed="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="License.rtf"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <!--
        MSIFASTINSTALL=7: SISTEM GERI YUKLEME NOKTASI OLUSTURULMAZ.

        Windows Installer varsayilan olarak her kurulumdan once bir geri yukleme
        noktasi olusturur. Bu adim ("Creating system restore point") ESKI ya da
        yavas diskli bir bilgisayarda 15+ dakika surebiliyor ve kullanici ilerleme
        cubugu hic kimildamadigi icin kurulumun dondugunu saniyor (sahada goruldu).

        Deger 7 = 1 (geri yukleme noktasi yok) + 2 (rollback verisi tutma)
                + 4 (dosya maliyeti hesabini atla).

        Guvenli: bu program SISTEM dosyalarina dokunmaz, yalnizca Program Files
        altina yazar ve MSI'nin kendi kaldirma mekanizmasi calismaya devam eder.
        Geri yukleme noktasinin korudugu senaryo (bozuk kurulum sistemi etkiler)
        burada zaten olusmaz.
      -->
      <MsiPackage SourceFile="$(var.MsiPath)"
                  Vital="yes"
                  Compressed="yes">
        <MsiProperty Name="MSIFASTINSTALL" Value="7" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
