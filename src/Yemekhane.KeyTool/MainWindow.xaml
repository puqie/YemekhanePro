<Window x:Class="Yemekhane.KeyTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro — Lisans Üretici" Height="640" Width="880"
        MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C33A02"/>
        <SolidColorBrush x:Key="Ink" Color="#18212A"/>
        <SolidColorBrush x:Key="Muted" Color="#5D6975"/>
        <SolidColorBrush x:Key="Line" Color="#DCE1E7"/>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="Primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="#B9C0C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Secondary" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Baslik -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Lisans Üretici" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Müşteriye vereceğiniz lisans anahtarlarını üretir. Bu programı müşteriye vermeyin."
                       Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Imza sirri -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" x:Name="SecretEntry">
                    <TextBlock Style="{StaticResource Label}"
                               Text="İmza sırrı — kurulumu üretirken kullandığınız sır ile aynı olmalı"/>
                    <PasswordBox x:Name="SecretBox" MinWidth="380"/>
                </StackPanel>

                <StackPanel Grid.Column="0" x:Name="SecretSaved" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="İmza sırrı kayıtlı" FontWeight="SemiBold" Foreground="#1B7B3A"/>
                    <TextBlock x:Name="SecretHint" Style="{StaticResource Label}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Button x:Name="SaveSecretButton" Style="{StaticResource Primary}" Content="Kaydet"
                            Click="SaveSecretClick"/>
                    <Button x:Name="ChangeSecretButton" Style="{StaticResource Secondary}" Content="Değiştir"
                            Visibility="Collapsed" Margin="8,0,0,0" Click="ChangeSecretClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Uretim -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Label}" Text="Okul / müşteri adı"/>
                    <TextBox x:Name="CustomerBox"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Label}" Text="Not (telefon, fatura no…)"/>
                    <TextBox x:Name="NoteBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Label}" Text="Adet"/>
                    <TextBox x:Name="CountBox" Text="1" Width="56" TextAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="3" x:Name="GenerateButton" Style="{StaticResource Primary}"
                        Content="Anahtar üret" VerticalAlignment="Bottom" IsDefault="True"
                        Click="GenerateClick"/>
            </Grid>
        </Border>

        <!-- Sonuc + gecmis -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="LatestPanel" Background="#FFF6F1" Padding="16"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Üretilen anahtar"/>
                            <TextBox x:Name="LatestKeyBox" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" FontFamily="Consolas" FontSize="18"
                                     FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                     TextWrapping="Wrap" Padding="0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CopyButton" Style="{StaticResource Secondary}"
                                Content="Kopyala" VerticalAlignment="Center" Click="CopyClick"/>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1">
                    <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock Text="Satış geçmişi" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CountLabel" Style="{StaticResource Label}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Secondary}" Content="Klasörü aç" Padding="12,5"
                                    Click="OpenFolderClick"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="White" RowHeight="30"
                              HorizontalGridLinesBrush="{StaticResource Line}"
                              CanUserAddRows="False" Margin="16,0,16,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Anahtar" Binding="{Binding Key}" Width="Auto"
                                                FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="*"/>
                            <DataGridTextColumn Header="Tarih" Width="Auto"
                                                Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}"/>
    </Grid>
</Window>
