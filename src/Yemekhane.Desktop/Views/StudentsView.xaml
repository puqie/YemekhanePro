<UserControl x:Class="Yemekhane.Desktop.Views.StudentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Yemekhane.Desktop"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:StatusBadgeConverter x:Key="StatusBadge"/>
        <converters:StatusBrushConverter x:Key="StatusBrush"/>
            </ResourceDictionary>
</UserControl.Resources>
    <Border Background="{StaticResource CanvasBrush}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Öğrenciler" Style="{StaticResource PageTitle}"/><TextBlock Text="Öğrenci, kart ve günlük kullanım yönetimi" Style="{StaticResource PageSubtitle}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Style="{StaticResource Action}" Content="Yeni Öğrenci" Command="{Binding NewStudentCommand}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Yeni öğrenci oluştur"/>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,14,0,10">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Genel arama" Margin="0,0,0,4"/><TextBox x:Name="StudentSearchBox" Style="{StaticResource FieldCompact}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Genel arama, en az 2 karakter" AutomationProperties.Name="Genel öğrenci arama"/></StackPanel>
                    <StackPanel Width="104" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Öğrenci no" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding StudentNo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam öğrenci numarası" AutomationProperties.Name="Öğrenci numarası"/></StackPanel>
                    <StackPanel Width="112" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Kart no" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam kart numarası" AutomationProperties.Name="Kart numarası"/></StackPanel>
                    <StackPanel Width="112" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Ad" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ad"/></StackPanel>
                    <StackPanel Width="112" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Soyad" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Soyad"/></StackPanel>
                    <StackPanel Width="104" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Durum" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Statuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding IsActive}" AutomationProperties.Name="Durum filtresi"/></StackPanel>
                    <Button Style="{StaticResource Action}" Content="Filtrele" Command="{Binding SearchCommand}" IsDefault="True" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Width="190" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Sınıf" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding ClassId}" ToolTip="Sınıf adı" AutomationProperties.Name="Sınıf filtresi"/></StackPanel>
                    <StackPanel Width="190" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Şube" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding SectionId}" ToolTip="Şube adı" AutomationProperties.Name="Şube filtresi"/></StackPanel>
                    <StackPanel Width="190" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Bölüm" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding DepartmentId}" ToolTip="Bölüm adı" AutomationProperties.Name="Bölüm filtresi"/></StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="StudentsGrid" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                        GridLinesVisibility="Horizontal"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Öğrenci listesi">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenQuickDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenFullDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                            <KeyBinding Key="Enter" Command="{Binding OpenFullDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="82"/>
                            <DataGridTextColumn Header="KART NO" Binding="{Binding CardNumber}" Width="105"/>
                            <DataGridTextColumn Header="AD" Binding="{Binding FirstName}" Width="*" MinWidth="105"/>
                            <DataGridTextColumn Header="SOYAD" Binding="{Binding LastName}" Width="*" MinWidth="105"/>
                            <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="82"/>
                            <DataGridTextColumn Header="ŞUBE" Binding="{Binding SectionName}" Width="68"/>
                            <DataGridTextColumn Header="BÖLÜM" Binding="{Binding DepartmentName}" Width="95"/>
                            <DataGridTextColumn Header="VELİ TEL" Binding="{Binding ParentPhone}" Width="110"/>
                            <DataGridTemplateColumn Header="DURUM" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource StatusBrush}}"
                                                Style="{StaticResource BadgeNeutral}">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusBadge}}"
                                                       FontSize="{StaticResource FontXs}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="BUGÜNKÜ HAK" Binding="{Binding TodayEntitlement}" Width="100"/>
                            <DataGridCheckBoxColumn Header="BUGÜN GİRİŞ" Binding="{Binding HasEnteredToday}" Width="88"/>
                            <DataGridTextColumn Header="SON GİRİŞ" Binding="{Binding LastEntryAt, StringFormat={}{0:dd.MM HH:mm}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Öğrenciler yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    <TextBlock Text="Filtrelerle eşleşen öğrenci bulunamadı." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <Border x:Name="StudentFormPanel" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Öğrenci Formu" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Button Grid.Column="1" Style="{StaticResource Action}" Content="Düzenle" Command="{Binding EditStudentCommand}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <TextBlock Text="Öğrenci NO" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding FormStudentNo, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormOpen, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="Ad" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormOpen, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="Soyad" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormOpen, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="Sınıf" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding SelectedStudent.ClassName, Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Text="Şube" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding SelectedStudent.SectionName, Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Text="Kart No" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding SelectedStudent.CardNumber, Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Text="Veli Tel" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding SelectedStudent.ParentPhone, Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Text="Not" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding FormNotes}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" IsReadOnly="{Binding IsFormOpen, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="Durum" Style="{StaticResource Label}"/>
                        <Border Background="{Binding SelectedStudent.IsActive, Converter={StaticResource StatusBrush}}" Style="{StaticResource BadgeNeutral}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedStudent.IsActive, Converter={StaticResource StatusBadge}}" FontSize="{StaticResource FontXs}"/>
                        </Border>

                        <Button Content="Kaydet" Command="{Binding SaveStudentCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldError}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel><Button Style="{StaticResource Action}" Content="Pasifleştir" Command="{Binding DeactivateCommand}" Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource Action}" Content="İzin Ver" Command="{Binding GiveLeaveCommand}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource Action}" Content="SMS Gönder" Command="{Binding OpenSmsCommand}" Visibility="{Binding CanSendSms, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource Action}" Content="Hakediş Ver" Command="{Binding GrantEntitlementCommand}" Visibility="{Binding CanGrantEntitlement, Converter={StaticResource BoolToVisibility}}"/></WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0"><TextBox Width="105" Text="{Binding NewCardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Yeni kart numarası" Visibility="{Binding CanManageCards, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource Action}" Content="Okuyucudan Al" Command="{Binding ReadCardCommand}" Visibility="{Binding CanManageCards, Converter={StaticResource BoolToVisibility}}" ToolTip="Bağlı aktif okuyucu yoksa F3 kart akışı ayrıntılı durum gösterir" ToolTipService.ShowOnDisabled="True"/><Button Style="{StaticResource Action}" Content="Kart Değiştir" Command="{Binding ReplaceCardCommand}" Visibility="{Binding CanManageCards, Converter={StaticResource BoolToVisibility}}"/></WrapPanel>
                    </Grid>

                    <!-- Detay sekmeleri (Kartlar, Veliler, Hakedisler, Giris Gecmisi, Izinler vb.):
                         eskiden detay cekmecesinde yasiyordu. Form artik kalici oldugu icin
                         cekmece yok; sekmeler formun ALTINA, secili ogrencinin gecmis/iliskili
                         verisini gostermek uzere tasindi. "Liste altinda bolum" alternatifi
                         listenin dikey alanini bogardigi icin secilmedi; formla ayni sutunda
                         kalmasi secili ogrenciyle olan iliskiyi daha net kurar. -->
                    <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                            <TabControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ListBox ItemsSource="{Binding Items}" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4"/></DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Yükleniyor..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,9,0,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/><Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/></StackPanel></Grid>

        <Border x:Name="CardWorkflowHost" Grid.RowSpan="4" Visibility="{Binding IsCardWorkflowOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="40">
          <Grid>
            <Border Background="{StaticResource ScrimBrush}"/>
            <Border Width="510" Padding="22" Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid><TextBlock Text="Kart Oku" FontSize="20" FontWeight="SemiBold"/><Button Content="Kapat" Command="{Binding CloseCardWorkflowCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right"/></Grid>
                    <TextBlock Text="Aktif cihazdan gerçek kart olayı beklenir; kart numarası uydurulmaz." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,10"/>
                    <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" Height="32" AutomationProperties.Name="Okunan veya aranacak kart numarası"/>
                    <TextBlock Text="{Binding CardWorkflowMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,9,0,12"/>
                    <WrapPanel><Button Content="Okuyucuyu Bekle" Command="{Binding OpenCardWorkflowCommand}" Style="{StaticResource Action}"/><Button Content="Kartla Ara" Command="{Binding SearchByReadCardCommand}" Style="{StaticResource Action}"/></WrapPanel>
                    <TextBlock Text="Eşleşme yoksa pencereyi kapatıp öğrenci detayından bu kartı atayabilirsiniz." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
          </Grid>
        </Border>
    </Grid>
    </Border>
</UserControl>
