<UserControl x:Class="Yemekhane.Desktop.Views.StudentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Yemekhane.Desktop"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    xmlns:vm="clr-namespace:Yemekhane.Desktop.ViewModels"
    xmlns:services="clr-namespace:Yemekhane.Desktop.Services"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
                <!-- Ogrenci Karti cekmecesi DrawerWide stilini kullanir; Drawer.xaml BURADA
                     merge edilmezse StaticResource cozulemez ve ekran hic acilmaz. -->
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/Drawer.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/Modal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:StatusBadgeConverter x:Key="StatusBadge"/>
        <converters:StatusBrushConverter x:Key="StatusBrush"/>
        <converters:SameStudentConverter x:Key="SameStudent"/>
        <!-- Sekme "cipi": sabit sirali serit icin ListBoxItem. Secili olan turuncu alt
             cizgiyle isaretlenir (TabItem stiliyle ayni gorsel dil), ama yer DEGISTIRMEZ. -->
        <Style x:Key="TabChip" TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="{StaticResource FontSm}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2.5" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sicil karti acilir kutusu + yesil "+" (eski programdaki anlik tanim ekleme).
             "+" tiklaninca satir ici kucuk bir kutu acilir; ad girilip Ekle denince sunucuya
             yazilir, listeye eklenir ve SECILIR. Cakisma (409) mesaji kutunun altinda gorunur. -->
        <!-- Salt okunur ozet degeri: alanla ayni olcu, ama TextBox DEGIL. Kullanicinin
             yazamayacagi bir deger yazilabilir gibi gorunmemeli; ayrica salt okunur bir
             ozellige bagli TextBox WPF'te calisma zamaninda hata verir. -->
        <Style x:Key="ReadOnlyValue" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <DataTemplate x:Key="LookupPicker" DataType="{x:Type vm:LookupPickerViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource FieldCombo}" MinWidth="0" ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                              SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}"/>
                    <Button Grid.Column="2" Content="+" Command="{Binding OpenAddCommand}" Width="32" MinWidth="0" Padding="0" Margin="0,0,0,4"
                            Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"
                            ToolTip="{Binding AddPlaceholder}" AutomationProperties.Name="{Binding AddPlaceholder}"/>
                </Grid>
                <Grid Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource FieldCompact}" MinWidth="0" Margin="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding AddPlaceholder}" ToolTip="{Binding AddPlaceholder}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Ekle" Command="{Binding AddCommand}" Margin="0"/>
                    <Button Grid.Column="4" Style="{StaticResource Action}" Content="Vazgeç" Command="{Binding CancelAddCommand}" Margin="0"/>
                </Grid>
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>
            </ResourceDictionary>
</UserControl.Resources>
    <Border Background="{StaticResource CanvasBrush}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Öğrenciler" Style="{StaticResource PageTitle}"/><TextBlock Text="Öğrenci, kart ve günlük kullanım yönetimi" Style="{StaticResource PageSubtitle}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Style="{StaticResource Action}" Content="Yeni Öğrenci" Command="{Binding NewStudentCommand}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Yeni öğrenci oluştur"/>
                <Button Style="{StaticResource Action}" Content="Dışa Aktar" Command="{Binding ExportCommand}" Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" ToolTip="Sicil Listesi raporunu açar; Excel, PDF veya CSV olarak kaydedin" AutomationProperties.Name="Sicil listesini dışa aktar"/>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Filtreler TEK satira sigacak genislikte (1440'ta ~1160px): eskiden iki sabit
             satir ~170px yiyor, sagdaki panelde form + dugmeler + sekmelere yer kalmiyordu.
             Dar pencerede WrapPanel kendiliginden ikinci satira sarar. -->
        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,14,0,10">
            <WrapPanel>
                <!-- TEK ARAMA: once "Öğrenci no", "Kart no", "Ad" ve "Soyad" ayri kutulardaydi.
                     Sunucu zaten hepsini tek "search" ile ariyor (numara ve kart bastan, ad ile
                     soyad kelime basindan); ayri kutular hem daha DAR (tam esitlik) hem de kart
                     numarasini yanlis kutuya yazan kullaniciya sessizce bos sonuc veriyordu.
                     Sinif/Sube/Bolum/Durum daraltma filtresi olarak kalir. -->
                <StackPanel Width="300" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Ara" Margin="0,0,0,4"/><TextBox x:Name="StudentSearchBox" Style="{StaticResource FieldCompact}" Margin="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ad, soyad, öğrenci no veya kart no (en az 2 karakter)" AutomationProperties.Name="Genel öğrenci arama"/></StackPanel>
                <StackPanel Width="88" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Sınıf" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Margin="0" Text="{Binding ClassId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sınıf adı" AutomationProperties.Name="Sınıf filtresi"/></StackPanel>
                <StackPanel Width="88" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Şube" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Margin="0" Text="{Binding SectionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Şube adı" AutomationProperties.Name="Şube filtresi"/></StackPanel>
                <StackPanel Width="100" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Bölüm" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Margin="0" Text="{Binding DepartmentId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bölüm adı" AutomationProperties.Name="Bölüm filtresi"/></StackPanel>
                <StackPanel Width="96" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Durum" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" Margin="0" MinWidth="0" ItemsSource="{Binding Statuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding IsActive}" AutomationProperties.Name="Durum filtresi"/></StackPanel>
                <Button Style="{StaticResource Action}" Content="Filtrele" Command="{Binding SearchCommand}" IsDefault="True" VerticalAlignment="Bottom" Margin="0"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- Sag panel 460px: form alanlari iki sutuna sigsin (2 x ~205px) diye 420'den
                 genisletildi. Liste 1440'ta yine ~705px alir; sabit sutunlar 300px, AD/SOYAD
                 en az 110'ar px; kesilme yok (bkz. ListeSutunlariTasmadanSigar testi). -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="460"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="StudentsGrid" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                        GridLinesVisibility="Horizontal"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Öğrenci listesi">
                        <DataGrid.InputBindings>
                            <!-- Tek tiklama da TAM detayi yukler (OpenFullDetailCommand): form artik
                                 kalici oldugundan yarim dolu bir form (Details bos, SelectedStudent dolu)
                                 hicbir zaman ekranda gorunmemeli. OpenQuickDetailCommand bu ekranda
                                 artik kullanilmiyor; ViewModel'e dokunulmadi, komut hala mevcut. -->
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFullDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenFullDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                            <KeyBinding Key="Enter" Command="{Binding OpenFullDetailCommand}" CommandParameter="{Binding SelectedItem, ElementName=StudentsGrid}"/>
                        </DataGrid.InputBindings>
                        <!-- 12 sutundan 7'ye indirildi. Onceki halde sabit genislikler toplami
                             911px idi ama liste sutunu 1440x900'de yalnizca ~745px; DataGrid
                             hepsini orantili kucultunce HER sutunun icerigi kesiliyordu:
                             "5001" -> "500'", "8350001" -> "835(", "Aktif" -> "Ak", ve
                             "BUGÜNKÜ HAK" ile "BUGÜN GİRİŞ" basliklari ikisi de "BUGÜ" olarak
                             gorunup ayirt edilemiyordu. Bu kritikti: veritabaninda ayni ad-soyada
                             sahip ogrenciler var (iki ayri ALİ ÖZTÜRK, 7-E ve 7-B) ve onlari
                             ayirt eden sutunlar tam da kesilenlerdi.
                             BÖLÜM, VELİ TEL, BUGÜNKÜ HAK, BUGÜN GİRİŞ ve SON GİRİŞ kaldirildi;
                             bunlarin hepsi zaten sagdaki form panelinde ve detay sekmelerinde
                             gorulebiliyor. Kalan sabit genislikler toplami 300px, geri kalan
                             ~445px AD ve SOYAD sutunlarina "*" ile paylastiriliyor; ikisi de en uzun
                             Turkce isimleri (HÜSEYİN, SÜMEYYE, HAŞLAMACI, ÖZDEMİR) rahat alir. -->
                        <!-- Sabit sutunlar "Auto" + MinWidth: sabit Width ile 7 haneli numara
                             ("9060542" -> "9060!") ve 8+ haneli kart no ("T2060602") kesiliyordu;
                             hucre dolgusu 22px oldugu icin Auto, en uzun gorunen degere gore acilir. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="58"/>
                            <DataGridTextColumn Header="AD" Binding="{Binding FirstName}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="SOYAD" Binding="{Binding LastName}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="52"/>
                            <DataGridTextColumn Header="ŞUBE" Binding="{Binding SectionName}" Width="Auto" MinWidth="52"/>
                            <DataGridTextColumn Header="KART NO" Binding="{Binding CardNumber}" Width="Auto" MinWidth="80"/>
                            <DataGridTemplateColumn Header="DURUM" Width="Auto" MinWidth="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource StatusBrush}}"
                                                Style="{StaticResource BadgeNeutral}">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusBadge}}"
                                                       FontSize="{StaticResource FontXs}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Öğrenciler yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    <TextBlock Text="Filtrelerle eşleşen öğrenci bulunamadı." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <Border x:Name="StudentFormPanel" Grid.Column="2" Style="{StaticResource Card}">
                <!-- Sag panel BES satir: baslik / form (kayar) / eylem dugmeleri / sekme seridi /
                     sekme icerigi (kayar). Onceki iki satirli duzen (form+dugmeler tek ScrollViewer
                     icinde "*", sekmeler Auto+MinHeight) 1440x900'de su hatayi uretiyordu: sekme
                     satiri "Auto" oldugundan kalabalik bir sekme (14 hakedis) tum yuksekligi
                     aliyor, form satiri sifira yakin kaliyor ve Pasiflestir / Izin Ver / SMS /
                     Hakedis / Kart dugmeleri ScrollViewer'in dibinde HIC gorunmuyordu.
                     Simdi dugmeler kaymayan kendi "Auto" satirindadir; form ve sekme icerigi
                     kalan alani 3:2 paylasir ve her biri kendi icinde kayar. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Form satiri yalnizca icerigi kadar (en cok 250px), kalan alan sekme
                             icerigine: once 5*:3* payla 900px yukseklikte "Not" kutusu ortadan
                             kesiliyor, sekme icerigine 105px kaliyordu. -->
                        <RowDefinition Height="Auto" MaxHeight="215"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Öğrenci Formu" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <!-- Okulun kullanmadigi alanlar KALICI olarak gizlenebilir; secim diske
                             yazilir, her acilista yeniden kapatmak gerekmez. Gizlenen alanin
                             kayitli degerine dokunulmaz. -->
                        <ToggleButton Content="Alanlar" IsChecked="{Binding IsFieldChooserOpen}" Margin="10,0,0,0" Padding="8,3"
                                      VerticalAlignment="Center" AutomationProperties.Name="Form alanlarını seç"/>
                        <!-- Durum rozeti: yalnizca Details ve secim AYNI ogrenciyken (SameStudent). -->
                        <Border Grid.Column="1" Margin="0,0,10,0" Background="{Binding SelectedStudent.IsActive, Converter={StaticResource StatusBrush}}" Style="{StaticResource BadgeNeutral}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource SameStudent}" FallbackValue="Collapsed">
                                    <Binding Path="Details.Id"/>
                                    <Binding Path="SelectedStudent.Id"/>
                                </MultiBinding>
                            </Border.Visibility>
                            <TextBlock Text="{Binding SelectedStudent.IsActive, Converter={StaticResource StatusBadge}}" FontSize="{StaticResource FontXs}"/>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource Action}" Content="Düzenle" Command="{Binding EditStudentCommand}" Margin="0" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,6,0">
                        <!-- Kimlik alanlari iki sutunda (NO | Ad, Soyad tek basina): 460px
                             panelde her kutu ~205px, "HÜSEYİN"/"HAŞLAMACI" rahat sigar. Dikeyde
                             bir satir kazanilir; form 900px yukseklikte kaydirmadan okunur. -->
                        <!-- Kimlik alanlari TEK satirda (NO 96px | Ad | Soyad): 900px yukseklikte
                             sag panel dolup "Not" kutusu ortadan kesiliyor, sekme icerigine 105px
                             kaliyordu. Bir satir kazanmak formu kaydirmadan sigdirir. -->
                        <!-- Sag panel artik yalnizca OZET: NO/Ad/Soyad/Not her zaman salt okunur.
                             Duzenleme ve yeni kayit "Ogrenci Karti" cekmecesinde (StudentCardDrawer)
                             yapilir; eski programdaki Sicil Karti'nin tum alanlari oradadir. -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Öğrenci NO" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                            <TextBox Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormStudentNo, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="2" Text="Ad" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormFirstName, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="4" Text="Soyad" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormLastName, Mode=OneWay}" IsReadOnly="True"/>
                        </Grid>

                        <!-- Bu blok SADECE Details ve SelectedStudent AYNI ogrenciye ait olunca gorunur
                             (Kritik 2 duzeltmesi). Iki kaynak farkli anlarda farkli ogrencileri
                             gosterebilir: (1) OpenCreate() Details'i null yapip SelectedStudent'a
                             dokunmaz; "Yeni Ogrenci" tiklaninca onceki secimin Kart No/Durum'u
                             ekranda KALIRDI. (2) satir A'ya tiklanip api yaniti gelmeden satir B'ye
                             tiklanirsa SelectedStudent aninda B olur, ama Details bir sure A'yi tasir;
                             iki farkli ogrenci ayni panelde bir arada gorunurdu. SameStudent, Id'leri
                             karsilastirip eslesmedigi HER an (null dahil) blogu gizler.
                             Salt okunur kisa degerler (sinif "8B", sube "B", kart, telefon) iki
                             sutunda: form dikeyde yariya iner, eylem dugmeleri ve sekmelere yer kalir. -->
                        <Grid>
                            <Grid.Visibility>
                                <MultiBinding Converter="{StaticResource SameStudent}" FallbackValue="Collapsed">
                                    <Binding Path="Details.Id"/>
                                    <Binding Path="SelectedStudent.Id"/>
                                </MultiBinding>
                            </Grid.Visibility>
                            <!-- Sinif "8B" ve sube "B" iki-uc karakterdir: dar sutunlar yeter; kart
                                 ve telefon kalan alani paylasir. Tek satirda dort deger, form
                                 kaydirmadan tamamen gorunur. -->
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="8"/><ColumnDefinition Width="50"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Sınıf" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <TextBox Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding SelectedStudent.ClassName, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="2" Text="Şube" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" Text="{Binding SelectedStudent.SectionName, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="4" Text="Kart No" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Field}" MinWidth="0" Text="{Binding SelectedStudent.CardNumber, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Column="6" Text="Veli Tel" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="6" Style="{StaticResource Field}" MinWidth="0" Text="{Binding SelectedStudent.ParentPhone, Mode=OneWay}" IsReadOnly="True"/>
                        </Grid>

                        <!-- HAKEDIS DONEMI: "veli arayip kac ogun kaldi, yuklemesi ne zaman
                             bitiyor diye soruyor" ihtiyaci. Once bu bilgi hicbir ekranda yoktu;
                             kullanici tarih araligini genisletip satirlari tek tek sayiyordu.
                             Her ogun ayri satirdir (ogle ve kahvalti ayri biter). -->
                        <ItemsControl ItemsSource="{Binding Periods}" Margin="0,10,0,0"
                                      Visibility="{Binding HasPeriods, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SunkenBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MealName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <!-- Kalan ogun: velinin sordugu rakam, en buyuk punto. -->
                                                <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="18" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InfoBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding UsageText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding PeriodText}" Margin="0,4,0,0"/>
                                            <!-- Son gun ve "kac gun kaldi": yenileme karari bu iki satirdan verilir. -->
                                            <TextBlock Margin="0,2,0,0">
                                                <Run Text="Son gün:"/>
                                                <Run Text="{Binding LastDateText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding DaysLeftText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding RenewFromText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <!-- Yanan hak varsa gorunur: kullanilmadan gecen gunler "kalan"a sayilmaz. -->
                                            <TextBlock Text="{Binding ExpiredText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding HasExpiredQuantity, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bolum / Gorev ozeti (eski programdaki Sicil Karti alanlari). Adlar tanim
                             listelerinden cozulur; ikisi de bosken satir yer kaplamasin diye kisa tutulur. -->
                        <Grid>
                            <Grid.Visibility>
                                <MultiBinding Converter="{StaticResource SameStudent}" FallbackValue="Collapsed">
                                    <Binding Path="Details.Id"/>
                                    <Binding Path="SelectedStudent.Id"/>
                                </MultiBinding>
                            </Grid.Visibility>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Bölüm" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <Border Grid.Row="1" Background="{StaticResource SunkenBrush}" Padding="10" Margin="0,6,0,0" CornerRadius="6"
                            Visibility="{Binding IsFieldChooserOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Formda görünecek alanlar" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FormFields}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible}" Width="150" Margin="0,2,8,2"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ad ve soyad her zaman görünür. Gizlenen alanın kayıtlı değeri silinmez." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ReadOnlyValue}"><TextBlock Text="{Binding DetailDepartmentName}" AutomationProperties.Name="Bölüm"/></Border>
                            <TextBlock Grid.Column="2" Text="Görev" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ReadOnlyValue}"><TextBlock Text="{Binding DetailJobName}" AutomationProperties.Name="Görev"/></Border>
                        </Grid>

                        <TextBlock Text="Not" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                        <TextBox Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormNotes, Mode=OneWay}" AcceptsReturn="True" Height="40" TextWrapping="Wrap" VerticalContentAlignment="Top" IsReadOnly="True"/>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Eylem dugmeleri KAYMAZ: form ne kadar uzun olursa olsun burada gorunur. -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldError}" Margin="0,0,0,6" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- Kaydet/Iptal cekmecededir (StudentCardDrawer); panelde yalnizca kayit eylemleri. -->
                        <WrapPanel>
                            <Button Style="{StaticResource Action}" Content="Pasifleştir" Command="{Binding DeactivateCommand}" Margin="0,0,7,6" ToolTip="Öğrenci pasif olur; Pasif filtresinde görünür ve geri alınabilir" Visibility="{Binding ShowDeactivate, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource Action}" Content="Aktifleştir" Command="{Binding ActivateCommand}" Margin="0,0,7,6" Visibility="{Binding ShowActivate, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource Action}" Content="İzin Ver" Command="{Binding GiveLeaveCommand}" Margin="0,0,7,6" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource Action}" Content="SMS Gönder" Command="{Binding OpenSmsCommand}" Margin="0,0,7,6" Visibility="{Binding CanSendSms, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource Action}" Content="Hakediş Ver" Command="{Binding GrantEntitlementCommand}" Margin="0,0,7,6" Visibility="{Binding CanGrantEntitlement, Converter={StaticResource BoolToVisibility}}"/>
                            <!-- Silme iki adimli: "Sil" -> "Silmeyi Onayla" + "Vazgeç". Kayit tum listelerden kaybolur. -->
                            <Button Style="{StaticResource Destructive}" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" Margin="0,0,7,6" ToolTip="Kayıt silinir ve listelerden kaybolur; Sicil Aktar ile yeniden içe aktarılırsa geri gelir" Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource Action}" Content="Vazgeç" Command="{Binding CancelDeleteCommand}" Margin="0,0,7,6" Visibility="{Binding IsDeleteArmed, Converter={StaticResource BoolToVisibility}}"/>
                        </WrapPanel>
                        <StackPanel Visibility="{Binding CanManageCards, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Yeni kart no" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                        <WrapPanel>
                            <TextBox Width="118" Margin="0,0,7,0" Text="{Binding NewCardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Yeni kart numarası (çip numarası, kartın arkasında)" AutomationProperties.Name="Yeni kart numarası"/>
                            <TextBox Width="88" Margin="0,0,7,0" Text="{Binding NewPrintedNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Baskı no: kartın ön yüzündeki basılı numara (örn. 6296), isteğe bağlı; kayıp kartı bulmak için" AutomationProperties.Name="Baskı numarası"/>
                            <Button Style="{StaticResource Action}" Content="Okuyucudan Al" Command="{Binding ReadCardCommand}" Visibility="{Binding HasCardReader, Converter={StaticResource BoolToVisibility}}" ToolTip="Masa tipi okuyucudan kart numarasını alır"/>
                            <Button Style="{StaticResource Action}" Content="{Binding CardActionText}" Command="{Binding ReplaceCardCommand}" Margin="0"/>
                        </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Detay sekmeleri (Kartlar, Veliler, Hakedisler, Gecis Gecmisi, Izinler vb.):
                         formla ayni sutunda, secili ogrencinin gecmis/iliskili verisi.
                         TabControl KULLANILMAZ: on sekme 380px'e uc satira sariyor ve WPF'in
                         TabPanel'i secilen satiri en alta tasidigi icin her tiklamada
                         basliklar yer degistiriyordu. Serit sabit sirali bir ListBox+WrapPanel;
                         icerik ayri bir satirda, kendi icinde kayar. -->
                    <Border Grid.Row="3" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <!-- Serit + tarih satiri TEK Border icinde: yeni Grid SATIRI eklenmez,
                             cunku alttaki icerik Grid.Row="4" diye SABIT indeksler. -->
                        <StackPanel>
                        <ListBox x:Name="DetailTabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                                 ItemContainerStyle="{StaticResource TabChip}" AutomationProperties.Name="Öğrenci detay sekmeleri"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>

                        <!-- TARIH ARALIGI: yalnizca gecmis sekmelerinde (Hakedisler, Gecis Gecmisi).
                             Once hakedisler bugunun etrafinda dar bir pencereye, gecis gecmisi ise
                             YALNIZCA BUGUNE sabitti; gecen yila bakmak mumkun degildi. -->
                        <Border Background="{StaticResource SunkenBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Tarih aralığı" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker SelectedDate="{Binding HistoryFrom}" Width="120"
                                                AutomationProperties.Name="Geçmiş başlangıç tarihi"/>
                                    <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/>
                                    <DatePicker SelectedDate="{Binding HistoryTo}" Width="120"
                                                AutomationProperties.Name="Geçmiş bitiş tarihi"/>
                                </WrapPanel>
                                <!-- Hazir araliklar: "gecen yil" demek icin iki tarih yazmaya gerek kalmasin.
                                     Ogretim yili 1 Eylul - 31 Agustos olarak hesaplanir. -->
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Bu öğretim yılı" Command="{Binding HistoryThisYearCommand}" Padding="8,3"/>
                                    <Button Content="Geçen öğretim yılı" Command="{Binding HistoryLastYearCommand}" Padding="8,3" Margin="6,0,0,0"/>
                                    <Button Content="Tümü" Command="{Binding HistoryAllCommand}" Padding="8,3" Margin="6,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Border>

                    <ContentControl Grid.Row="4" x:Name="DetailTabContent" Content="{Binding SelectedTab}" Margin="0,6,0,0">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ListBox ItemsSource="{Binding Items}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <!-- Sablon tipe gore secilir: sekmelerin ortak satiri (StudentDetailRow) tek metin,
                                             Bakiye sekmesinin ilk satiri (StudentBalanceHeadline) buyuk yazili bakiye. -->
                                        <ListBox.Resources>
                                            <DataTemplate DataType="{x:Type services:StudentDetailRow}">
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4"/>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type services:StudentBalanceHeadline}">
                                                <StackPanel Margin="4,4,4,10" AutomationProperties.Name="Güncel bakiye">
                                                    <TextBlock Text="GÜNCEL BAKİYE" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding BalanceText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.Resources>
                                    </ListBox>
                                    <!-- FallbackValue: secili sekme yokken (ilk acilis, silme sonrasi) DataContext
                                         null'dur; baglanti cozulemeyince Visibility varsayilan Visible kalir ve
                                         ekranda sahte bir "Yükleniyor..." asili dururdu. -->
                                    <TextBlock Text="Yükleniyor..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                                    <!-- Bos sekmede daha once bomboş beyaz alan kaliyordu; kullanici
                                         verinin henuz yuklenmedigini mi yoksa hic kayit olmadigini mi
                                         anlayamiyordu. IsEmpty yalnizca yukleme bitip hata da yokken dogrudur. -->
                                    <TextBlock Text="{Binding EmptyText}" Margin="4" Foreground="{StaticResource MutedBrush}"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Hata metni artik formun icinde (dugmelerin hemen ustunde) gosterilir; burada
             yalnizca sayfalama var. Uzun bir hata sayfalama dugmelerinin ustune binmesin diye
             genislik sinirlanir ve kesilir. -->
        <Grid Grid.Row="3" Margin="0,9,0,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,320,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/><Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/></StackPanel></Grid>

        <!-- Kart okuma: ortak Modal (once elle yazilmis Border + karartma). -->
        <controls:Modal x:Name="CardWorkflowHost" Grid.RowSpan="4" Panel.ZIndex="40" Style="{StaticResource ModalMedium}" Title="Kartla Öğrenci Bul"
                        Subtitle="Kart numarasını yazın ve Ara'ya basın. Masa tipi okuyucu bağlıysa Okuyucuyu Bekle ile okutabilirsiniz."
                        IsOpen="{Binding IsCardWorkflowOpen, Mode=OneWay}" CloseCommand="{Binding CloseCardWorkflowCommand}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Kart numarası"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kart numarası"/>
                <TextBlock Text="{Binding CardWorkflowMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="Ara" Command="{Binding SearchByReadCardCommand}" Style="{StaticResource Primary}" IsDefault="True"/>
                    <Button Content="Okuyucuyu Bekle" Command="{Binding OpenCardWorkflowCommand}" Style="{StaticResource Action}" Visibility="{Binding HasCardReader, Converter={StaticResource BoolToVisibility}}"/>
                </WrapPanel>
                <TextBlock Text="Eşleşme yoksa pencereyi kapatıp öğrenci kartındaki Kart No alanına bu numarayı yazın." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </controls:Modal>

        <!-- OGRENCI KARTI: eski programdaki "Sicil Karti" formunun tamami. "Yeni Ogrenci" ve
             "Duzenle" bu genis cekmeceyi acar; sag panel ozet/eylem/sekme olarak kalir.
             IsOpen tek yonlu: Drawer kendini kapatirken CancelEditCommand ViewModel'i kapatir. -->
        <controls:Drawer x:Name="StudentCardDrawer" Grid.RowSpan="4" Style="{StaticResource DrawerWide}" Title="Öğrenci Kartı"
                         IsOpen="{Binding IsFormOpen, Mode=OneWay}" CloseCommand="{Binding CancelEditCommand}" Panel.ZIndex="50">
            <StackPanel>
                <TextBlock Text="{Binding FormSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <!-- Numara artik ZORUNLU DEGIL; kalin "zorunlu alan" stili kaldirildi. -->
                            <TextBlock Text="Öğrenci NO" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                            <TextBox Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormStudentNo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Öğrenci NO"/>
                            <TextBlock Visibility="{Binding ShowNationalId, Converter={StaticResource BoolToVisibility}}" Grid.Column="2" Text="TC Kimlik No" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                            <TextBox Visibility="{Binding ShowNationalId, Converter={StaticResource BoolToVisibility}}" Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" MaxLength="11" Text="{Binding FormNationalId, UpdateSourceTrigger=PropertyChanged}" ToolTip="11 rakam; boş bırakılabilir" AutomationProperties.Name="TC Kimlik No"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Ad" Style="{StaticResource RequiredLabel}" Margin="0,6,0,3"/>
                            <TextBox Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ad"/>
                            <TextBlock Grid.Column="2" Text="Soyad" Style="{StaticResource RequiredLabel}" Margin="0,6,0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Soyad"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Visibility="{Binding ShowBirthDate, Converter={StaticResource BoolToVisibility}}" Text="Doğum tarihi" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                            <DatePicker Visibility="{Binding ShowBirthDate, Converter={StaticResource BoolToVisibility}}" Grid.Row="1" SelectedDate="{Binding FormBirthDate}" MinWidth="0" Margin="0,0,0,4" AutomationProperties.Name="Doğum tarihi"/>
                            <TextBlock Grid.Column="2" Text="Kart No (isteğe bağlı)" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                            <!-- Kart numarasi ELLE GIRILEBILIR ve kayitla AYNI ANDA atanir.
                                 Once salt okunur bir kutuydu ve "sag panelden yapilir" diyordu;
                                 ama sag panel ogrenci KAYDEDILDIKTEN sonra acildigi icin yeni
                                 ogrenciye kart vermek iki ayri adim gerektiriyordu ve kullanici
                                 alani "kapali" saniyordu. Bos birakilirsa kart islemi yapilmaz. -->
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0"
                                     Text="{Binding FormCardNumber, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="İsteğe bağlı. Kartı olmayan öğrenci (anasınıfı gibi) için BOŞ bırakın; öğrenci kartsız kaydedilir, sayımlarda ve hakedişlerde görünür. Kart sonradan da verilebilir."
                                     AutomationProperties.Name="Kart No"/>
                            <!-- Kartin ON yuzundeki basili kisa numara (6296): cip numarasi DEGIL. Kayip kart
                                 bulununca elde yalnizca bu numara vardir; arama kutusu bununla da eslesir. -->
                            <TextBlock Visibility="{Binding ShowPrintedNumber, Converter={StaticResource BoolToVisibility}}" Grid.Row="2" Grid.Column="2" Text="Baskı No" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                            <TextBox Visibility="{Binding ShowPrintedNumber, Converter={StaticResource BoolToVisibility}}" Grid.Row="3" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0"
                                     Text="{Binding FormPrintedNumber, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Kartın ön yüzündeki basılı numara (örn. 6296). Çip numarası değildir; kayıp kart bulununca sahibini bulmak için aranır. İsteğe bağlı."
                                     AutomationProperties.Name="Baskı No"/>
                        </Grid>
                    </StackPanel>
                    <!-- Fotograf: 96px onizleme; yoksa gri siluet. Dosya bellekten gosterilir, disk kilidi kalmaz. -->
                    <StackPanel Grid.Column="2" Width="112">
                        <TextBlock Visibility="{Binding ShowPhoto, Converter={StaticResource BoolToVisibility}}" Text="Fotoğraf" Style="{StaticResource Label}" Margin="0,2,0,3"/>
                        <Border Visibility="{Binding ShowPhoto, Converter={StaticResource BoolToVisibility}}" Width="96" Height="112" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                            <Grid>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPhoto}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image x:Name="StudentPhotoPreview" Source="{Binding PhotoImage}" Stretch="UniformToFill" Width="94" Height="110"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource Action}" Content="Resim Seç" Command="{Binding SelectPhotoCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="96"/>
                        <Button Style="{StaticResource Action}" Content="Kaldır" Command="{Binding RemovePhotoCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" MinWidth="96" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding PhotoError}" Style="{StaticResource FieldError}" Visibility="{Binding HasPhotoError, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ContentControl Content="{Binding FormClass}" ContentTemplate="{StaticResource LookupPicker}"/>
                    <ContentControl Grid.Column="2" Content="{Binding FormSection}" ContentTemplate="{StaticResource LookupPicker}"/>
                    <ContentControl Grid.Row="1" Content="{Binding FormDepartment}" ContentTemplate="{StaticResource LookupPicker}"/>
                    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding FormJob}" ContentTemplate="{StaticResource LookupPicker}"/>
                </Grid>

                <!-- Veli: otomatik SMS bu telefona gider; onceden yalnizca CSV ice aktarimindan girilebiliyordu. -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Veli adı" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                    <TextBox Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormParentName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Veli adı"/>
                    <TextBlock Grid.Column="2" Text="Veli telefonu" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormParentPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Veli telefonu" ToolTip="Örn. 5321234567 — otomatik SMS bu numaraya gider"/>
                </Grid>

                <TextBlock Visibility="{Binding ShowAddress, Converter={StaticResource BoolToVisibility}}" Text="Adres" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                <TextBox Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Adres"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Visibility="{Binding ShowFingerprint, Converter={StaticResource BoolToVisibility}}" Text="Parmak izi ID" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                    <TextBox Visibility="{Binding ShowFingerprint, Converter={StaticResource BoolToVisibility}}" Grid.Row="1" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormFingerprintId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Parmak izi ID"/>
                    <TextBlock Visibility="{Binding ShowPid, Converter={StaticResource BoolToVisibility}}" Grid.Column="2" Text="PI ID" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                    <TextBox Visibility="{Binding ShowPid, Converter={StaticResource BoolToVisibility}}" Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormPid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PI ID"/>
                </Grid>
                <TextBlock Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVisibility}}" Text="Not" Style="{StaticResource Label}" Margin="0,6,0,3"/>
                <TextBox Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Field}" MinWidth="0" Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Not"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldError}" Margin="0,8,0,4" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Kaydet" Command="{Binding SaveStudentCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0" IsDefault="True"/>
                    <Button Content="İptal" Command="{Binding CancelEditCommand}" Style="{StaticResource Action}" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </controls:Drawer>
    </Grid>
    </Border>
</UserControl>
