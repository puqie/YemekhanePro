<UserControl x:Class="Yemekhane.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Yemekhane.Desktop"
    Background="#F4F5F7" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <Style x:Key="Field" TargetType="Control"><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,3,0,9"/></Style>
        <Style x:Key="Button" TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DDE2"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#65717E"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    </UserControl.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Sistem Ayarları" FontSize="22" FontWeight="SemiBold" Foreground="#17202A"/><TextBlock Text="Okul, sağlayıcı, yedekleme, senkronizasyon ve günlük yapılandırması" Foreground="#65717E" Margin="0,4,0,12"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="#FFF3E5" CornerRadius="12" Padding="9,4" Margin="0,0,8,0" Visibility="{Binding IsOffline, Converter={StaticResource Bool}}"><TextBlock Text="Çevrimdışı" Foreground="#8A681D"/></Border><Button Style="{StaticResource Button}" Content="Yenile" Command="{Binding RefreshCommand}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <TabControl IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <TabItem Header="Okul">
                    <ScrollViewer><StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Okul bilgileri" FontSize="16" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Label}" Text="Okul adı"/><TextBox Style="{StaticResource Field}" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Adres"/><TextBox Height="70" Margin="0,3,0,9" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding SchoolAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Style="{StaticResource Label}" Text="İletişim"/><TextBox Style="{StaticResource Field}" Text="{Binding SchoolContact, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Logo dosya yolu"/><TextBox Style="{StaticResource Field}" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Bağlantılar">
                    <StackPanel Margin="18"><TextBlock Text="Yönetim ekranları" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource Button}" Command="{Binding NavigateDevicesCommand}" Content="Cihazlar / Kart Okuyucular"/><TextBlock Text="{Binding DeviceCount, StringFormat={}  {0} kayıt}" VerticalAlignment="Center"/></WrapPanel><ItemsControl ItemsSource="{Binding DeviceSummaries}" Margin="12,0,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#65717E"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource Button}" Command="{Binding NavigateMealsCommand}" Content="Yemek Türleri"/><TextBlock Text="{Binding MealTypeCount, StringFormat={}  {0} aktif tür}" VerticalAlignment="Center"/></WrapPanel><ItemsControl ItemsSource="{Binding MealTypes}" Margin="12,0,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#65717E"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Style="{StaticResource Button}" Command="{Binding NavigateHolidaysCommand}" Content="Tatiller / Takvim" HorizontalAlignment="Left" Margin="0,10,0,0"/><Button Style="{StaticResource Button}" Command="{Binding NavigateUsersCommand}" Content="Kullanıcılar / Roller" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding CanNavigateUsers, Converter={StaticResource Bool}}"/><TextBlock Text="Cihaz yapılandırması ilgili yönetim ekranında yapılır." Foreground="#65717E" Margin="0,16,0,0"/></StackPanel>
                </TabItem>
                <TabItem Header="SMS">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="SMS sağlayıcısı" FontSize="16" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Label}" Text="Endpoint"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsEndpoint, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Label}" Text="Kimlik doğrulama"/><ComboBox Style="{StaticResource Field}" ItemsSource="{Binding SmsAuthTypes}" SelectedItem="{Binding SmsAuthType}"/><TextBlock Style="{StaticResource Label}" Text="Kullanıcı adı"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsUsername, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Label}" Text="Gönderici"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsSender, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Label}" Text="Zaman aşımı (saniye)"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsTimeoutSeconds}"/><TextBlock Style="{StaticResource Label}" Text="Gizli bilgi (boş bırakırsanız değişmez)"/><PasswordBox x:Name="SmsSecretBox" Height="30" Margin="0,3,0,3" PasswordChanged="SmsSecretChanged"/><TextBlock Text="Gizli bilgi yapılandırıldı" Foreground="#156B63" Visibility="{Binding SmsSecretConfigured, Converter={StaticResource Bool}}"/><TextBlock Text="Sağlayıcı değişiklikleri API yeniden başlatıldığında uygulanır." Foreground="#8A681D" Margin="0,12,0,0"/></StackPanel>
                </TabItem>
                <TabItem Header="Yedekleme">
                    <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><CheckBox Content="Otomatik yedeklemeyi etkinleştir" IsChecked="{Binding BackupEnabled}"/><WrapPanel Margin="0,10,0,0"><StackPanel Width="180"><TextBlock Style="{StaticResource Label}" Text="Sıklık"/><ComboBox Style="{StaticResource Field}" ItemsSource="{Binding BackupFrequencies}" SelectedItem="{Binding BackupFrequency}"/></StackPanel><StackPanel Width="180" Margin="10,0"><TextBlock Style="{StaticResource Label}" Text="Haftanın günü"/><ComboBox Style="{StaticResource Field}" ItemsSource="{Binding WeekDays}" SelectedItem="{Binding BackupWeeklyDay}"/></StackPanel><StackPanel Width="120"><TextBlock Style="{StaticResource Label}" Text="Saat (HH:mm)"/><TextBox Style="{StaticResource Field}" Text="{Binding BackupTime}"/></StackPanel></WrapPanel><TextBlock Style="{StaticResource Label}" Text="Saklanacak yedek sayısı"/><TextBox Style="{StaticResource Field}" Width="140" HorizontalAlignment="Left" Text="{Binding BackupRetentionCount}"/><TextBlock Style="{StaticResource Label}" Text="Yedek klasörü"/><TextBox Style="{StaticResource Field}" Text="{Binding BackupPath}"/><WrapPanel Margin="0,10"><Button Style="{StaticResource Button}" Content="Şimdi Yedekle" Command="{Binding BackupNowCommand}"/><Button Style="{StaticResource Button}" Content="Yedek Dosyası Seç" Command="{Binding ChooseRestoreCommand}"/><Button Style="{StaticResource Button}" Content="Yedeği Doğrula" Command="{Binding ValidateBackupCommand}"/></WrapPanel><TextBlock Text="{Binding RestorePath}" Foreground="#65717E" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Label}" Text="Geri yükleme onayı: GERI YUKLE"/><TextBox Style="{StaticResource Field}" Text="{Binding RestoreConfirmation, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource Button}" Content="Geri Yükle" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Background="#A4403A" Foreground="White"/><TextBlock Text="Geri yükleme önce güvenlik yedeği alır ve uygulamanın yeniden başlatılmasını gerektirir." Foreground="#8A681D" Margin="0,10,0,0"/></StackPanel>
                </TabItem>
                <TabItem Header="Sync">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left"><CheckBox Content="Senkronizasyonu etkinleştir" IsChecked="{Binding SyncEnabled}"/><TextBlock Style="{StaticResource Label}" Text="Endpoint"/><TextBox Style="{StaticResource Field}" Text="{Binding SyncEndpoint, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Label}" Text="Cihaz kimliği"/><TextBox Style="{StaticResource Field}" Text="{Binding SyncDeviceId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Label}" Text="Çalışma aralığı (dakika)"/><TextBox Style="{StaticResource Field}" Text="{Binding SyncIntervalMinutes}"/><TextBlock Style="{StaticResource Label}" Text="Erişim gizlisi (boş bırakırsanız değişmez)"/><PasswordBox x:Name="SyncSecretBox" Height="30" Margin="0,3,0,3" PasswordChanged="SyncSecretChanged"/><TextBlock Text="Gizli bilgi yapılandırıldı" Foreground="#156B63" Visibility="{Binding SyncSecretConfigured, Converter={StaticResource Bool}}"/><TextBlock Text="{Binding SyncStatusText}" Margin="0,14,0,8"/><Button Style="{StaticResource Button}" Content="Şimdi Senkronize Et" Command="{Binding SyncNowCommand}" HorizontalAlignment="Left"/><TextBlock Text="Zamanlama değişiklikleri servis yeniden başlatıldığında uygulanır; elle çalıştırma kaydedilmiş endpoint'i hemen kullanır." Foreground="#8A681D" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
                </TabItem>
                <TabItem Header="Loglar">
                    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Seviye" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="150" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/><TextBlock Text="Saklama günü" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox Width="70" Text="{Binding LogRetentionDays}"/><TextBlock Text="Dosya yolu" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox Width="220" Text="{Binding LogPath}"/><Button Style="{StaticResource Button}" Content="Logları Yenile" Command="{Binding RefreshLogsCommand}" Margin="12,0,0,0"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="145"/><DataGridTextColumn Header="Seviye" Binding="{Binding Level}" Width="85"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="160"/><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="Özellikler" Binding="{Binding Properties}" Width="220"/></DataGrid.Columns></DataGrid></Grid>
                </TabItem>
            </TabControl>
            <ProgressBar IsIndeterminate="True" Width="220" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Bool}}"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="#A4403A" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusMessage}" Foreground="#156B63" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,22,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding CanManage, Converter={StaticResource Bool}}"><TextBlock Text="Kaydedilmemiş değişiklikler" Foreground="#8A681D" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsDirty, Converter={StaticResource Bool}}"/><Button Style="{StaticResource Button}" Content="İptal" Command="{Binding CancelCommand}"/><Button Style="{StaticResource Button}" Content="Kaydet" Command="{Binding SaveCommand}" Background="#156B63" Foreground="White"/></StackPanel></Grid>
    </Grid>
</UserControl>
