<UserControl x:Class="Yemekhane.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Yemekhane.Desktop"
    xmlns:vm="clr-namespace:Yemekhane.Desktop.ViewModels"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    xmlns:services="clr-namespace:Yemekhane.Desktop.Services"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Bool"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <!-- Ham API kodlarini (Information, Error...) ekranda Turkce gosterir. -->
        <converters:EnumTextConverter x:Key="EnumText"/>
        <!-- Sekme icerigi: sabit 760px yerine genis ekranda 1100px'e kadar esner, kucuk
             ekranda daralir. Once sag taraf bos kaliyor, Yedekleme sekmesi dikey
             kaydiriyordu; iki sutunlu kart yerlesimiyle icerik tek ekrana sigar. -->
        <Style x:Key="TabBody" TargetType="StackPanel"><Setter Property="Margin" Value="18"/><Setter Property="MaxWidth" Value="1100"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
            </ResourceDictionary>
</UserControl.Resources>
    <controls:PageShell Title="Sistem Ayarları" Subtitle="Okul, sağlayıcı, yedekleme, senkronizasyon ve günlük yapılandırması">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,8,0" Visibility="{Binding IsOffline, Converter={StaticResource Bool}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Content="Yenile" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.FooterLeft>
            <StackPanel><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel>
        </controls:PageShell.FooterLeft>
        <controls:PageShell.FooterRight>
            <StackPanel Orientation="Horizontal" Visibility="{Binding CanManage, Converter={StaticResource Bool}}"><TextBlock Text="Kaydedilmemiş değişiklikler" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsDirty, Converter={StaticResource Bool}}"/><Button Content="İptal" Command="{Binding CancelCommand}"/><Button Content="Kaydet" Command="{Binding SaveCommand}" Style="{StaticResource Primary}"/></StackPanel>
        </controls:PageShell.FooterRight>

        <Grid>
            <TabControl IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <TabItem Header="Okul">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource TabBody}">
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="Okul bilgileri" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Raporların ve fişlerin başlığında görünür." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,6"/>
                            <TextBlock Style="{StaticResource Label}" Text="Okul adı"/><TextBox Style="{StaticResource Field}" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Adres"/><TextBox Style="{StaticResource Field}" Height="70" Margin="0,3,0,9" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding SchoolAddress, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource Label}" Text="İletişim (telefon / e-posta)"/><TextBox Style="{StaticResource Field}" Text="{Binding SchoolContact, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Logo dosya yolu"/><TextBox Style="{StaticResource Field}" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}"/></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Bağlantılar">
                    <StackPanel Style="{StaticResource TabBody}"><TextBlock Text="Yönetim ekranları" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource Action}" Command="{Binding NavigateDevicesCommand}" Content="Cihazlar / Kart Okuyucular"/><TextBlock Text="{Binding DeviceCount, StringFormat={}  {0} kayıt}" VerticalAlignment="Center"/></WrapPanel><ItemsControl ItemsSource="{Binding DeviceSummaries}" Margin="12,0,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource Action}" Command="{Binding NavigateMealsCommand}" Content="Yemek Türleri"/><TextBlock Text="{Binding MealTypeCount, StringFormat={}  {0} aktif tür}" VerticalAlignment="Center"/></WrapPanel><ItemsControl ItemsSource="{Binding MealTypes}" Margin="12,0,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Command="{Binding NavigateHolidaysCommand}" Content="Tatiller / Takvim" HorizontalAlignment="Left" Margin="0,10,0,0"/><Button Command="{Binding NavigateUsersCommand}" Content="Kullanıcılar / Roller" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding CanNavigateUsers, Converter={StaticResource Bool}}"/><TextBlock Text="Cihaz yapılandırması ilgili yönetim ekranında yapılır." Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/></StackPanel>
                </TabItem>
                <TabItem Header="SMS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource TabBody}">
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="SMS sağlayıcısı" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Veli bildirimlerinin gönderileceği SMS servisi. Sağlayıcıyı seçip bilgileri girin; boş bırakılırsa SMS gönderilmez." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,6" TextWrapping="Wrap"/>
                            <!-- Saglayici: Mutlucell (XML ag gecidi) ya da genel HTTP/JSON. Alan etiketleri saglayiciya gore degisir. -->
                            <TextBlock Style="{StaticResource Label}" Text="Sağlayıcı"/><ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding SmsProviders}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SmsProvider}" IsEnabled="{Binding CanManage}" AutomationProperties.Name="SMS sağlayıcısı"/>
                            <TextBlock Text="Mutlucell: panelinizdeki API kullanıcı adı (ka), API şifresi (pwd) ve onaylı başlık (org) girilir. Adres boş bırakılırsa smsgw.mutlucell.com ağ geçidi kullanılır; Türkçe karakter (charset=turkish) açıktır, tek SMS 150 karakterdir." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6" TextWrapping="Wrap" Visibility="{Binding IsMutlucell, Converter={StaticResource Bool}}"/>
                            <StackPanel Visibility="{Binding IsGenericHttp, Converter={StaticResource Bool}}">
                                <TextBlock Style="{StaticResource Label}" Text="Sunucu adresi (https://...)"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsEndpoint, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource Label}" Text="{Binding SmsUsernameLabel}"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMS kullanıcı adı"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="{Binding SmsSenderLabel}"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsSender, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SMS başlık"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- Kimlik dogrulama yalnizca genel HTTP icin: ekranda Turkce ad, API'ye "None/Basic/Bearer/ApiKey". -->
                                <StackPanel Visibility="{Binding IsGenericHttp, Converter={StaticResource Bool}}"><TextBlock Style="{StaticResource Label}" Text="Kimlik doğrulama"/><ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding SmsAuthTypes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SmsAuthType}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Zaman aşımı (saniye, 1-300)"/><TextBox Style="{StaticResource Field}" Text="{Binding SmsTimeoutText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding SmsSecretLabel}"/><PasswordBox x:Name="SmsSecretBox" Height="30" Margin="0,3,0,3" PasswordChanged="SmsSecretChanged"/>
                            <TextBlock Text="Gizli bilgi yapılandırıldı" Foreground="{StaticResource AccentBrush}" Visibility="{Binding SmsSecretConfigured, Converter={StaticResource Bool}}"/>
                            <TextBlock Text="Kuyruk gönderimi için sağlayıcı değişiklikleri uygulama yeniden başlatıldığında uygulanır; Test SMS ise kaydedilmiş ayarlarla hemen gider." Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <!-- Test SMS: kuyruga girmez, kayitli ayarlarla gider; saglayicinin ham yaniti aynen gosterilir. -->
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="SMS sınama" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Test SMS kuyruğa girmeden, KAYDEDİLMİŞ ayarlarla gönderilir; sağlayıcının verdiği yanıt aşağıda aynen gösterilir. Değişiklik yaptıysanız önce Kaydet'e basın." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Alıcı GSM (05xx xxx xx xx)"/><TextBox Style="{StaticResource Field}" Text="{Binding TestSmsPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Test SMS alıcısı"/></StackPanel>
                                <Button Content="Test SMS Gönder" Command="{Binding SendTestSmsCommand}" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="0,0,8,3"/>
                                <Button Content="Kontör Sorgula" Command="{Binding QuerySmsCreditCommand}" Style="{StaticResource Action}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding IsMutlucell, Converter={StaticResource Bool}}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Sonuç ve sağlayıcı yanıtı" Margin="0,8,0,0"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TestSmsResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top" AutomationProperties.Name="Test SMS sonucu"/>
                            <TextBlock Text="{Binding SmsCreditText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding IsMutlucell, Converter={StaticResource Bool}}"/>
                        </StackPanel></Border>
                        <!-- Otomatik SMS kurallari (eski programdaki "Sms Sistemi Tanımları" sag paneli): uc kural
                             yan yana; her biri onay kutusu + alanlar + sablon. Kaydet/Iptal sayfanin ortak
                             dugmeleridir (kirli izleme otomasyonu da kapsar). -->
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <Grid><TextBlock Text="Otomatik SMS" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ServerTimeText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Sunucu saati"/></Grid>
                            <TextBlock Text="Kurallar sunucuda çalışır; SMS'ler kuyruğa alınır ve sağlayıcı üzerinden gönderilir. Geçmişi SMS Merkezi → Geçmiş'te 'Kaynak' sütunundan izleyebilirsiniz." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Veliye yemek hakkı uyarısı" FontWeight="SemiBold"/>
                                    <CheckBox Content="Her gün belirlenen saatte gönder" IsChecked="{Binding AutoEntitlementEnabled}" Margin="0,6,0,4" IsEnabled="{Binding CanManage}"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{StaticResource Label}" Text="Gönderim saati (SS:dd)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding AutoEntitlementSendAt, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Hak uyarısı gönderim saati"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Kaç gün hak kaldığında (1-30)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding AutoEntitlementDaysText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Hak uyarısı gün eşiği"/></StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="Mesaj şablonu"/>
                                    <TextBox Style="{StaticResource Field}" Height="86" Margin="0,3,0,3" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Text="{Binding AutoEntitlementTemplate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Hak uyarısı mesaj şablonu"/>
                                    <TextBlock Text="{x:Static vm:SettingsViewModel.EntitlementVariablesHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="Şimdi gönder (hak uyarısı)" Command="{Binding RunEntitlementWarningCommand}" Style="{StaticResource Action}"/></WrapPanel>
                                    <TextBlock Text="Kayıtlı eşik ve şablonla çalışır; önce kaydedin. Aynı gün aynı öğrenciye ikinci SMS gitmez." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding EntitlementRunText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding LastEntitlementRunText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gelir girişinde yetkiliye bildirim" FontWeight="SemiBold"/>
                                    <CheckBox Content="Kasaya gelir girildiğinde SMS gönder" IsChecked="{Binding AutoIncomeEnabled}" Margin="0,6,0,4" IsEnabled="{Binding CanManage}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Yetkili GSM no"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding AutoIncomePhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Gelir bildirimi yetkili GSM no"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Mesaj şablonu"/>
                                    <TextBox Style="{StaticResource Field}" Height="86" Margin="0,3,0,3" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Text="{Binding AutoIncomeTemplate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Gelir bildirimi mesaj şablonu"/>
                                    <TextBlock Text="{x:Static vm:SettingsViewModel.IncomeVariablesHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Kart yenileme" FontWeight="SemiBold"/>
                                    <CheckBox Content="Kart atanınca/değişince veliye SMS gönder" IsChecked="{Binding AutoCardEnabled}" Margin="0,6,0,4" IsEnabled="{Binding CanManage}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Yetkiliye de gönder (GSM no, isteğe bağlı)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding AutoCardPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Kart yenileme yetkili GSM no"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Mesaj şablonu"/>
                                    <TextBox Style="{StaticResource Field}" Height="86" Margin="0,3,0,3" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Text="{Binding AutoCardTemplate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Kart yenileme mesaj şablonu"/>
                                    <TextBlock Text="{x:Static vm:SettingsViewModel.CardVariablesHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Yedekleme">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource TabBody}">
                        <!-- Iki kart yan yana: Zamanlama (sol) ve Elle islemler (sag). Tek sutunda
                             1366x768 ekranda dikey kaydirma cikiyordu. -->
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Zamanlama" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Otomatik yedekleme burada ayarlanır; sağdaki elle işlemler her zaman kullanılabilir." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                <CheckBox Content="Otomatik yedeklemeyi etkinleştir" IsChecked="{Binding BackupEnabled}"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Sıklık"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding BackupFrequencies}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding BackupFrequency}"/></StackPanel>
                                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsWeeklyBackup}"><TextBlock Style="{StaticResource Label}" Text="Haftanın günü (haftalıkta)"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding WeekDays}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding BackupWeeklyDay}"/></StackPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Saat (SS:dd)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding BackupTime, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Saklanacak yedek sayısı (1-365)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding BackupRetentionText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Bu sayıyı aşan en eski DÜZENLİ yedekler otomatik silinir. Geri yükleme öncesi alınan güvenlik yedekleri AYRI bir kotada tutulur (son 3), bu sayacı tüketmez." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Label}" Text="Yedek klasörü (boşsa veritabanının yanındaki Backups klasörü)"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Zamanlama değişiklikleri uygulama yeniden başlatıldığında uygulanır." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Elle işlemler" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Anlık yedek alın, bir yedek dosyasını doğrulayın veya geri yükleyin." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                <Button Content="Şimdi Yedekle" Command="{Binding BackupNowCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding LastBackupFile, StringFormat=Son alınan yedek: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Separator Margin="0,12,0,10"/>
                                <TextBlock Text="Geri yükleme" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,6"><Button Style="{StaticResource Action}" Content="Yedek Dosyası Seç" Command="{Binding ChooseRestoreCommand}"/><Button Style="{StaticResource Action}" Content="Yedeği Doğrula" Command="{Binding ValidateBackupCommand}"/></WrapPanel>
                                <TextBlock Text="{Binding RestoreFileText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <!-- Onay metni ASCII "GERI YUKLE" (Turkce harf YOK); kasitli: klavye
                                     duzeni ve buyuk/kucuk I/ı farki onayi engellemesin. Ipucu metni
                                     bunu acikca soyler; yanlis yazimda dugme pasif kalir. -->
                                <TextBlock Style="{StaticResource Label}" Text="Geri yükleme onayı"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding RestoreConfirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Geri yükleme onayı"/>
                                <TextBlock Text="{Binding RestoreConfirmationHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="Geri Yükle" Command="{Binding RestoreCommand}" Style="{StaticResource Destructive}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                <TextBlock Text="Geri yükleme önce güvenlik yedeği alır ve uygulamanın yeniden başlatılmasını gerektirir." Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Yıl Sonu">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource TabBody}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Yıl sonu sıfırlama" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Yeni eğitim yılına temiz başlamak için işletim verileri silinir: kartlar, hakedişler, yemek kullanımları, geçiş kayıtları, hak devirleri, izinler, grup üyelikleri, SMS ve toplu işlem geçmişi. Öğrenciler silinmez, PASİFE alınır; Sicil Aktar ile yüklenen yeni listedeki öğrenciler yeniden aktif olur." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="KORUNUR: tahsilat ve bakiye hareketleri, veliler, öğrenci sicilleri (pasif) — veli 1-2 yıl önceki ödemesini sorduğunda Raporlar → Gelir ve öğrencinin Ödemeler sekmesi bunları gösterir. KALIR: öğün tanımları, sınıflar, cihazlar, kullanıcılar ve yetkiler, tatil takvimi, SMS şablonları, ayarlar." FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Sıfırlamadan önce otomatik güvenlik yedeği alınır; yedek alınamazsa hiçbir şey silinmez. Yedekten geri yükleme Yedekleme sekmesindedir." Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Sıfırla" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Önce etkilenecek kayıtların sayımını alın, sonra onay metnini yazın." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                <Button Content="Etkilenecekleri Göster" Command="{Binding LoadResetPreviewCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{Binding ResetItems}" Margin="0,10,0,0" Visibility="{Binding HasResetPreview, Converter={StaticResource Bool}}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ResetTotal, StringFormat=Toplam {0:N0} kayıt etkilenecek (öğrenciler pasife alınır).}" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="{Binding HasResetPreview, Converter={StaticResource Bool}}"/>
                                <Separator Margin="0,12,0,10"/>
                                <!-- Onay metni ASCII "SIFIRLA": geri yukleme onayiyla ayni gerekce (klavye duzeni, I/ı). -->
                                <TextBlock Style="{StaticResource Label}" Text="Sıfırlama onayı"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding ResetConfirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sıfırlama onayı"/>
                                <TextBlock Text="{Binding ResetConfirmationHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="Yılı Sıfırla" Command="{Binding YearEndResetCommand}" Style="{StaticResource Destructive}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ResetResultMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Senkronizasyon">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource TabBody}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Merkez sunucu eşitlemesi" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Yerel işlemler belirlenen aralıkla merkez sunucuya gönderilir. Etkinken sunucu adresi ve cihaz kimliği zorunludur." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                <CheckBox Content="Senkronizasyonu etkinleştir" IsChecked="{Binding SyncEnabled}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Sunucu adresi (https://...)"/><TextBox Style="{StaticResource Field}" Text="{Binding SyncEndpoint, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Cihaz kimliği"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding SyncDeviceId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Çalışma aralığı (dakika, 1-1440)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding SyncIntervalText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label}" Text="Erişim gizlisi (boş bırakırsanız değişmez)"/><PasswordBox x:Name="SyncSecretBox" Height="30" Margin="0,3,0,3" PasswordChanged="SyncSecretChanged"/>
                                <TextBlock Text="Gizli bilgi yapılandırıldı" Foreground="{StaticResource AccentBrush}" Visibility="{Binding SyncSecretConfigured, Converter={StaticResource Bool}}"/>
                                <TextBlock Text="Zamanlama değişiklikleri uygulama yeniden başlatıldığında uygulanır; elle çalıştırma kaydedilmiş sunucu adresini hemen kullanır." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCard}"><StackPanel>
                                <TextBlock Text="Durum" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SyncStatusText}" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding SyncLastRunText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal"><Button Content="Şimdi Senkronize Et" Command="{Binding SyncNowCommand}" Style="{StaticResource Primary}"/><Button Content="Çakışmaları Yenile" Command="{Binding RefreshConflictsCommand}" Margin="7,0,0,0"/></StackPanel>
                                <TextBlock Text="Eşitleme kapalıyken 'Şimdi Senkronize Et' pasiftir; önce eşitlemeyi etkinleştirip kaydedin." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasConflicts, Converter={StaticResource Bool}}"><TextBlock Text="Çözüm bekleyen çakışmalar" FontWeight="SemiBold"/><TextBlock Text="Sunucudaki kayıt bu işlemden sonra değişmiş. Yeniden kuyruğa alırsanız işlem tekrar gönderilir." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,7"/><DataGrid ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200" RowHeight="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto" MinWidth="120"/><DataGridTextColumn Header="Kayıt" Binding="{Binding EntityName}" Width="Auto" MinWidth="90"/><DataGridTextColumn Header="İşlem" Binding="{Binding OperationType}" Width="Auto" MinWidth="110"/><DataGridTextColumn Header="Deneme" Binding="{Binding AttemptCount}" Width="Auto" MinWidth="70"/><DataGridTextColumn Header="Neden" Binding="{Binding LastError}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="Seçileni Yeniden Kuyruğa Al" Command="{Binding RequeueConflictCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
                                <TextBlock Text="Çözüm bekleyen çakışma yok." Foreground="{StaticResource FaintBrush}" Margin="0,12,0,0" Visibility="{Binding HasConflicts, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                            </StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Loglar">
                    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Seviye"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding LogLevels}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LogLevel}"/></StackPanel>
                            <StackPanel Width="190" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Saklama süresi (gün, 1-3650)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding LogRetentionText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Width="360" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Dosya yolu (boşsa varsayılan klasör)"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Content="Logları Yenile" Command="{Binding RefreshLogsCommand}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                        </WrapPanel>
                        <!-- Genislikler Auto: hucre basina 22px dolgu (DesignSystem.xaml Padding 11,0)
                             sabit piksellerden calindigi icin "Information" -> "Informatic",
                             "Device/Yemekhane Giris" -> "Device/Yemekhane Gir" olarak kesiliyordu.
                             Ozellikler sutunundaki JSON ise ekran disina tasip yatay kaydirma
                             cubugu da olmadigi icin HIC okunamiyordu: artik Mesaj ile alani
                             paylasir, ToolTip'te tam metin durur. -->
                        <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0" Padding="0,0,0,14"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="Auto" MinWidth="145"/><DataGridTextColumn Header="Seviye" Binding="{Binding Level, Converter={StaticResource EnumText}, ConverterParameter=LogLevel}" Width="Auto" MinWidth="70"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="Auto" MinWidth="160"/><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Özellikler" Binding="{Binding Properties}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Properties}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
                        <TextBlock Text="Henüz log kaydı yok. 'Logları Yenile' ile tekrar deneyin." Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasLogs, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/></Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Yardım / AI Kılavuzu">
                    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Yapay zeka kullanım kılavuzu" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" MaxWidth="1080">
                                Aşağıdaki metin, YemekhanePro'nun tüm ekranlarını, menülerini ve düğmelerini
                                ayrıntılı biçimde anlatır. Kopyalayıp bir yapay zeka sohbetine (ör. ChatGPT,
                                Claude) yapıştırırsanız, "şu işlemi nasıl yaparım" diye sorduğunuzda size
                                programdaki gerçek menü ve düğme adlarıyla adım adım yol tarif edebilir.
                            </TextBlock>
                            <Button Content="Panoya Kopyala" Click="CopyAiGuide" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="AiGuideCopiedText" Text="Kopyalandı." Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="{x:Static services:DeveloperContact.Line}" FontWeight="SemiBold" Margin="0,10,0,0" AutomationProperties.Name="Yazılım desteği iletişim"/>
                        </StackPanel>
                        <TextBox x:Name="AiGuideTextBox" Grid.Row="1" Text="{x:Static services:AiUserGuidePrompt.Text}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" Padding="10" AutomationProperties.Name="Yapay zeka kullanım kılavuzu metni"/>
                    </Grid>
                </TabItem>
            </TabControl>
            <ProgressBar IsIndeterminate="True" Width="220" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Bool}}"/>
        </Grid>
    </controls:PageShell>
</UserControl>
