<UserControl x:Class="Yemekhane.Desktop.Views.CashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    xmlns:local="clr-namespace:Yemekhane.Desktop"
    Language="tr-TR" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/Drawer.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
            </ResourceDictionary>
</UserControl.Resources>
    <Border Background="{StaticResource CanvasBrush}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Kasa" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Gelir, günlük kasa ve işlem denetimi • Europe/Istanbul" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Style="{StaticResource Action}" Content="Rapor Merkezine Aktar" Command="{Binding OpenReportsCommand}" IsEnabled="{Binding IsExportAvailable}" ToolTip="Günlük kasa ve gelir raporlarını aç" AutomationProperties.Name="Rapor merkezini aç"/>
                <!-- Sayfanin birincil eylemi: marka rengi (Primary). Notr Action stiliyle Yenile'den ayirt edilemiyordu. -->
                <Button Style="{StaticResource Primary}" Margin="0,0,7,0" Content="Gelir Ekle" Command="{Binding OpenAddCommand}" IsEnabled="{Binding IsVoidOpen, Converter={StaticResource InverseBool}}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Yeni gelir kaydı aç"/>
                <!-- Eski programdaki "TL Bakiye Yukleme": on odemeli bakiye; hakki olmayan gunde ogun ucreti buradan duser. -->
                <Button Style="{StaticResource Action}" Margin="0,0,7,0" Content="Bakiye Yükle" Command="{Binding OpenTopUpCommand}" IsEnabled="{Binding IsVoidOpen, Converter={StaticResource InverseBool}}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" ToolTip="Öğrenciye ön ödemeli TL bakiyesi yükle" AutomationProperties.Name="Bakiye yükleme çekmecesini aç"/>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,10">
            <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,7,0"><StackPanel><TextBlock Text="BUGÜN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DailyTotal, StringFormat={}{0:C2}}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Daily.TransactionCount, StringFormat={}{0:N0} işlem}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Padding="14,10" Margin="7,0"><StackPanel><TextBlock Text="BU HAFTA" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding WeeklyTotal, StringFormat={}{0:C2}}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding Weekly.TransactionCount, StringFormat={}{0:N0} işlem}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Padding="14,10" Margin="7,0,0,0"><StackPanel><TextBlock Text="BU AY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding MonthlyTotal, StringFormat={}{0:C2}}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding Monthly.TransactionCount, StringFormat={}{0:N0} işlem}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Background="White">
            <TabItem Header="İşlemler">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,7">
                        <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Başlangıç" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding FilterFrom}" AutomationProperties.Name="İşlem başlangıç tarihi"/></StackPanel>
                        <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Bitiş" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding FilterTo}" AutomationProperties.Name="İşlem bitiş tarihi"/></StackPanel>
                        <StackPanel Width="165" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Gelir türü" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding FilterTypeOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFilterType}" ToolTip="Gelir türü (Tümü, aktif ve pasif türler)"/></StackPanel>
                        <StackPanel Width="105" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Öğrenci no" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding FilterStudentNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam öğrenci numarası" AutomationProperties.Name="Öğrenci filtresi"/></StackPanel>

                        <StackPanel Width="115" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Kart no" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding FilterCardNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tam kart numarası" AutomationProperties.Name="Kart filtresi"/></StackPanel>
                        <StackPanel Width="135" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="İptal durumu" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding VoidStatuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilterIsVoided}" ToolTip="İptal durumu"/></StackPanel>
                        <Button Style="{StaticResource Action}" VerticalAlignment="Bottom" Margin="0,0,0,4" Content="Öğrenciyi Bul" Command="{Binding LookupFilterStudentCommand}"/><Button Style="{StaticResource Action}" VerticalAlignment="Bottom" Margin="0,0,0,4" Content="Filtrele" Command="{Binding ApplyFiltersCommand}" IsDefault="True"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource Destructive}" Content="Seçili İşlemi İptal Et" Command="{Binding OpenVoidCommand}" IsEnabled="{Binding IsAddOpen, Converter={StaticResource InverseBool}}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seçili işlemi iptal et"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" x:Name="TransactionsGrid" IsEnabled="{Binding IsAddOpen, Converter={StaticResource InverseBool}}" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Kasa işlem listesi">
                        <DataGrid.InputBindings><KeyBinding Key="Delete" Command="{Binding OpenVoidCommand}"/><KeyBinding Key="Enter" Command="{Binding OpenVoidCommand}"/></DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding TransactionAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto" MinWidth="118"/>
                            <DataGridTextColumn Header="ÖĞRENCİ" Binding="{Binding StudentName}" Width="*" MinWidth="130" MaxWidth="260"/>
                            <!-- Ayni adli ogrenciler (uc ADA AKGUN gibi) yalnizca adla ayirt edilemez; numara her satirda gorunur. -->
                            <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="KART" Binding="{Binding CardNumber}" Width="Auto" MinWidth="92"/>
                            <DataGridTextColumn Header="TÜR" Binding="{Binding IncomeTypeName}" Width="Auto" MinWidth="130"/>
                            <DataGridTextColumn Header="TUTAR" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Description}" Width="*" MinWidth="120" MaxWidth="240"/>
                            <DataGridCheckBoxColumn Header="İPTAL" Binding="{Binding IsVoided}" Width="Auto" MinWidth="60"/>
                            <DataGridTextColumn Header="İPTAL NEDENİ" Binding="{Binding VoidReason}" Width="Auto" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FilterStudentText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Caption}" Text="Düzenleme ve silme desteklenmez." VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/><Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/></StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Günlük Kasa">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="Günlük kasa" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,10"><DatePicker Width="140" SelectedDate="{Binding DailyDate}"/><Button Style="{StaticResource Action}" Content="Göster" Command="{Binding LoadDailyCommand}" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding DailyReport.TotalAmount, StringFormat=Net toplam: {0:C2}}" FontSize="20"/><TextBlock Text="{Binding DailyReport.VoidedAmount, StringFormat=İptal toplamı: {0:C2}}" Foreground="{StaticResource DangerBrush}"/><ItemsControl ItemsSource="{Binding DailyReport.ByIncomeType}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IncomeTypeName}"/><TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C2}}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Özel tarih aralığı" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,10"><DatePicker Width="130" SelectedDate="{Binding CustomFrom}"/><DatePicker Width="130" SelectedDate="{Binding CustomTo}" Margin="7,0"/><Button Style="{StaticResource Action}" Content="Hesapla" Command="{Binding LoadCustomCommand}"/></WrapPanel><TextBlock Text="{Binding Custom.TotalAmount, StringFormat=Net toplam: {0:C2}}" FontSize="20"/><TextBlock Text="{Binding Custom.TransactionCount, StringFormat={}{0:N0} aktif işlem}" Foreground="{StaticResource MutedBrush}"/><ItemsControl ItemsSource="{Binding Custom.ByIncomeType}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IncomeTypeName}"/><TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C2}}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Gelir Türleri" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding ManagedTypes}" SelectedItem="{Binding SelectedManagedType}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="AD" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="AKTİF" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="{Binding TypeFormTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Ad" Style="{StaticResource Label}"/><TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Aktif" IsChecked="{Binding TypeIsActive}" Margin="0,10"/><WrapPanel><Button Style="{StaticResource Action}" Content="Yeni" Command="{Binding NewTypeCommand}"/><Button Style="{StaticResource Action}" Content="Seçileni Düzenle" Command="{Binding EditTypeCommand}"/><Button Style="{StaticResource Action}" Content="Kaydet" Command="{Binding SaveTypeCommand}"/><Button Style="{StaticResource Action}" Content="Pasifleştir" Command="{Binding DeactivateTypeCommand}"/></WrapPanel></StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
                <!-- Hata olmayan sonuc bildirimi: basarili bakiye yuklemesi, iptal sonrasi eksi bakiye uyarisi. -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Kasa durum bildirimi"/>
            </StackPanel>
            <TextBlock Text="Filtrelerle eşleşen kasa işlemi bulunamadı." HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
        <Border Grid.RowSpan="4" Background="{StaticResource SurfaceBrush}" Opacity="0.97" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Kasa verileri yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>

        <controls:Drawer x:Name="AddPanel" Grid.RowSpan="4" IsOpen="{Binding IsAddOpen}" DrawerWidth="400" Title="Gelir Ekle" CloseCommand="{Binding CloseAddCommand}">
            <StackPanel>
                <!-- Once TEK etiket ("Tam ogrenci no veya kart no") IKI kutuyu kapsiyordu:
                     kullanici hangisine ogrenci no hangisine kart no girecegini bilemiyordu.
                     Her kutu kendi etiketini tasir. -->
                <WrapPanel>
                    <StackPanel Width="135" Margin="0,0,7,0"><TextBlock Style="{StaticResource Label}" Text="Öğrenci no" Margin="0,0,0,4"/><TextBox Text="{Binding StudentNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tam öğrenci numarası" ToolTip="Tam öğrenci numarası"/></StackPanel>
                    <StackPanel Width="135" Margin="0,0,7,0"><TextBlock Style="{StaticResource Label}" Text="Kart no" Margin="0,0,0,4"/><TextBox Text="{Binding LookupCardNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tam kart numarası" ToolTip="Tam kart numarası"/></StackPanel>
                    <Button Style="{StaticResource Action}" Content="Doğrula" Command="{Binding LookupStudentCommand}" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <TextBlock Text="{Binding LookupStudentText}" Margin="0,8" TextWrapping="Wrap" AutomationProperties.Name="Doğrulanan öğrenci">
                    <TextBlock.Style>
                        <!-- Dogrulama oncesi yonlendirme metni soluk; dogrulanan kimlik (ad, no, sinif/sube, kart) koyu ve kalin.
                             Onceden bos formda bile turuncu "dogrulanmadi" uyarisi vardi. -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource IdentityText}">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLookupStudent}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Gelir türü" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding IncomeTypes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAddType}"/>
                <TextBlock Text="Tarih ve saat" Style="{StaticResource Label}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding AddDate}" AutomationProperties.Name="İşlem tarihi"/><TextBox Grid.Column="2" Text="{Binding TransactionTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Saat (SS:dd)" AutomationProperties.Name="İşlem saati"/></Grid>
                <TextBlock Text="Tutar" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Türk lirası tutarı" ToolTip="Örnek: 125,50 ₺"/>
                <TextBlock Text="Açıklama" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="62" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                    <CheckBox IsChecked="{Binding AddConfirmed}" AutomationProperties.Name="Gelir kaydını onayla"><TextBlock Text="Öğrenci, tür, tarih ve tutarı kontrol ederek kaydı onaylıyorum." TextWrapping="Wrap"/></CheckBox>
                </Border>
                <TextBlock Text="{Binding AddError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8"/>
                <Button Content="Onayla ve Kaydet" Command="{Binding AddCommand}"
                        Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        IsEnabled="{Binding AddConfirmed}"/>
            </StackPanel>
        </controls:Drawer>

        <controls:Drawer x:Name="TopUpPanel" Grid.RowSpan="4" IsOpen="{Binding IsTopUpOpen}" DrawerWidth="400" Title="Bakiye Yükle" CloseCommand="{Binding CloseTopUpCommand}">
            <StackPanel>
                <TextBlock Text="Para yükle: tüm öğünler için geçerlidir. Günlük hakkı olmayan öğrenci, öğün ücreti bakiyesinden düşülerek geçer." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <StackPanel Width="135" Margin="0,0,7,0"><TextBlock Style="{StaticResource Label}" Text="Öğrenci no" Margin="0,0,0,4"/><TextBox Text="{Binding StudentNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bakiye: tam öğrenci numarası" ToolTip="Tam öğrenci numarası"/></StackPanel>
                    <StackPanel Width="135" Margin="0,0,7,0"><TextBlock Style="{StaticResource Label}" Text="Kart no" Margin="0,0,0,4"/><TextBox Text="{Binding LookupCardNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bakiye: tam kart numarası" ToolTip="Tam kart numarası"/></StackPanel>
                    <Button Style="{StaticResource Action}" Content="Doğrula" Command="{Binding LookupStudentCommand}" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <TextBlock Text="{Binding LookupStudentText}" Margin="0,8" TextWrapping="Wrap" AutomationProperties.Name="Bakiye: doğrulanan öğrenci">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource IdentityText}">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLookupStudent}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="TL tutarı" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding TopUpAmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yüklenecek Türk lirası tutarı" ToolTip="Örnek: 500 veya 1.250,50 ₺"/>
                <TextBlock Text="Bitiş tarihi (isteğe bağlı)" Style="{StaticResource Label}"/>
                <DatePicker SelectedDate="{Binding TopUpExpiresOn}" AutomationProperties.Name="Bakiye bitiş tarihi"/>
                <TextBlock Style="{StaticResource Caption}" Text="Boş bırakılırsa süresiz. Doluysa bu tarihten sonra kalan tutar geçişte kullanılmaz." TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="Açıklama" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding TopUpNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="62" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                    <CheckBox IsChecked="{Binding TopUpConfirmed}" AutomationProperties.Name="Bakiye yüklemesini onayla"><TextBlock Text="Öğrenci ve tutarı kontrol ederek yüklemeyi onaylıyorum; kasaya “Bakiye Yükleme” geliri işlenecek." TextWrapping="Wrap"/></CheckBox>
                </Border>
                <TextBlock Text="{Binding TopUpError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8"/>
                <Button Content="Onayla ve Yükle" Command="{Binding TopUpCommand}"
                        Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        IsEnabled="{Binding TopUpConfirmed}" AutomationProperties.Name="Bakiyeyi yükle"/>
            </StackPanel>
        </controls:Drawer>

        <controls:Drawer x:Name="VoidPanel" Grid.RowSpan="4" IsOpen="{Binding IsVoidOpen}" DrawerWidth="400" Title="İşlemi İptal Et" CloseCommand="{Binding CloseVoidCommand}">
            <StackPanel>
                <TextBlock Text="Bu işlem düzenlenmez veya silinmez; denetim izi korunarak iptal edilir." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                <Border Background="{StaticResource WarningSoftBrush}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTransaction.Amount, StringFormat={}{0:C2}}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding SelectedTransaction.StudentName}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTransaction.StudentName}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Öğrencisiz işlem"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding SelectedTransaction.StudentNo, StringFormat=No {0}, TargetNullValue=No -}"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding SelectedTransaction.CardNumber, StringFormat=Kart: {0}, TargetNullValue=Kart: -}"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding SelectedTransaction.TransactionAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="İptal nedeni (zorunlu)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="75" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                    <CheckBox IsChecked="{Binding VoidConfirmed}" AutomationProperties.Name="İşlem iptalini onayla"><TextBlock Text="Yukarıdaki kesin tutar ve öğrenciye ait işlemi iptal ettiğimi onaylıyorum." TextWrapping="Wrap"/></CheckBox>
                </Border>
                <Button Content="Onayla ve İptal Et" Command="{Binding VoidCommand}"
                        Style="{StaticResource Destructive}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </controls:Drawer>
    </Grid>
    </Border>
</UserControl>
