<UserControl x:Class="Yemekhane.Desktop.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Yemekhane.Desktop.Views"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    FontFamily="Segoe UI" FontSize="12" Focusable="True" PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Tur / davranis kodlari (Official, Delete, Keep...) API sozlesmesidir; ekranda
             EnumTextConverter ile Turkce gorunur. ViewModel degerleri ham kalir. -->
        <converters:EnumTextConverter x:Key="EnumText"/>
        <DataTemplate x:Key="HolidayTypeItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}, ConverterParameter=HolidayType}"/></DataTemplate>
        <DataTemplate x:Key="ExceptionTypeItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}, ConverterParameter=ExceptionType}"/></DataTemplate>
        <DataTemplate x:Key="BehaviorItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}, ConverterParameter=TransferBehavior}"/></DataTemplate>
        <Style x:Key="Chip" TargetType="Border"><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="Background" Value="{StaticResource SunkenBrush}"/></Style>
            </ResourceDictionary>
</UserControl.Resources>
    <Grid>
    <controls:PageShell Title="Operasyon Takvimi" Subtitle="Hakediş, tatil, gezi, izin ve aktarım görünümü">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,9,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Style="{StaticResource Action}" Content="Bugün" Command="{Binding TodayCommand}"/>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.Filters>
            <!-- Ay gezinme cifti (‹ ay adi ›) TEK BIR GRUP olarak solda durur.
                 Onceki duzende "‹" sutun 0'da, "›" ise sutun 3'te (en sagda) idi:
                 aralarina ay basligi VE kapsam secici giriyordu, yani ayni isin
                 iki dugmesi ekranin iki ucuna dagilmisti. Kullanici sonraki aya
                 gecmek icin fareyi 1000px oteye tasimak zorunda kaliyordu. -->
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Önceki ay"/>
                    <TextBlock Text="{Binding MonthTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextAlignment="Center" MinWidth="150" Margin="8,0"/>
                    <Button Content="›" Command="{Binding NextMonthCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Sonraki ay"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Kapsam" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox Width="190" ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScope}"/><Button Content="Uygula" Command="{Binding ApplyScopeCommand}" Style="{StaticResource Action}" Margin="7,0,0,0"/></StackPanel>
            </Grid>
        </controls:PageShell.Filters>

        <controls:PageShell.FooterLeft>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
        </controls:PageShell.FooterLeft>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding DayNames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="6" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding Date}">
                                <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Background" Value="{StaticResource SunkenBrush}"/><Setter Property="Opacity" Value="0.62"/></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <Grid Margin="8,6" MinHeight="72"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                    <StackPanel Grid.Row="1" Margin="0,2,0,0">
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasMeals, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding MealText}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource SunkenBrush}" Visibility="{Binding HasHoliday, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding HolidayText, StringFormat=Tatil · {0}}" Foreground="{StaticResource WarningBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource InfoSoftBrush}" Visibility="{Binding HasTrip, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Gezi" Foreground="{StaticResource InfoBrush}" FontSize="10"/></Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource SunkenBrush}" Visibility="{Binding HasSpecial, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Özel" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding HasLeave, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding Value.LeaveCount, StringFormat=İzin · {0}}" Foreground="{StaticResource WarningBrush}" FontSize="10"/></Border>
                                        <TextBlock Text="{Binding TransferText}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="2,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Takvim yükleniyor..." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel>
                    <Border Background="{StaticResource SunkenBrush}" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Bu ay için operasyon kaydı yok." Foreground="{StaticResource MutedBrush}"/></Border>
                </Grid>
            </Border>
        </Grid>
    </controls:PageShell>

    <!-- Diger ekranlardaki cekmeceyle AYNI kontrol: baslik, Kapat, Esc, karartma. Once
         karartmasiz duz bir Border idi ve "Kapat" basligin ustunde duruyordu. -->
    <controls:Drawer IsOpen="{Binding IsDrawerOpen, Mode=OneWay}" DrawerWidth="440" Title="Gün Operasyonları" CloseCommand="{Binding CloseDrawerCommand}">
        <StackPanel>
            <TextBlock Text="{Binding SelectedDateTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
            <UniformGrid Columns="3"><Border Style="{StaticResource Chip}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Hakediş" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedDetails.Entitlements.Quantity}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Chip}" Margin="5,0"><StackPanel><TextBlock Text="Kullanılan" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedDetails.Entitlements.Used}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource Chip}" Margin="5,0,0,0"><StackPanel><TextBlock Text="İzinli" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedDetails.LeaveCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
            <TextBlock Text="Öğün Dağılımı" FontWeight="SemiBold" Margin="0,18,0,6"/><ItemsControl ItemsSource="{Binding SelectedDetails.Meals}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MealName}"/><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0} hak}" Foreground="{StaticResource MutedBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Olaylar ve İşlemler" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <!-- SelectedOperations: ham kodlar (Title="Trip", Detail="Delete") yerine Turkce satirlar. -->
            <ItemsControl ItemsSource="{Binding SelectedOperations}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Bu gün için tatil, istisna, izin ya da aktarım kaydı yok." Style="{StaticResource Caption}" Visibility="{Binding HasNoOperations, Converter={StaticResource BoolToVisibility}}"/>
            <Separator Margin="0,18,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Tatil oluştur" Command="{Binding OpenHolidayFormCommand}" Style="{StaticResource Action}"/><Button Content="Özel istisna" Command="{Binding OpenExceptionFormCommand}" Style="{StaticResource Action}"/></StackPanel>
            <Button Content="Hakediş etkilerini toplu uygula" Command="{Binding OpenBulkCommand}" Style="{StaticResource Action}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,14,0,0" Visibility="{Binding IsHolidayFormOpen, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Yeni Tatil" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Ad" Margin="0,9,0,3"/><TextBox Text="{Binding HolidayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tür" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding HolidayTypes}" SelectedItem="{Binding HolidayType}" ItemTemplate="{StaticResource HolidayTypeItem}" AutomationProperties.Name="Tatil türü"/><TextBlock Text="Kapsam" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding HolidayScope}" AutomationProperties.Name="Tatil kapsamı"/><TextBlock Text="Hak davranışı" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding TransferBehaviors}" SelectedItem="{Binding TransferBehavior}" ItemTemplate="{StaticResource BehaviorItem}" AutomationProperties.Name="Hak davranışı"/><TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Tatil kaydı hakları kendisi değiştirmez; seçilen davranış kayıt sonrası 'Hakediş etkilerini toplu uygula' ile uygulanır ve geri alınabilir."/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Oluştur" Command="{Binding CreateHolidayCommand}" Style="{StaticResource Action}"/><Button Content="Vazgeç" Command="{Binding CloseHolidayFormCommand}" Style="{StaticResource Action}"/></StackPanel></StackPanel></Border>
            <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,14,0,0" Visibility="{Binding IsExceptionFormOpen, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Özel İstisna" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Tür" Margin="0,9,0,3"/><ComboBox ItemsSource="{Binding ExceptionTypes}" SelectedItem="{Binding ExceptionType}" ItemTemplate="{StaticResource ExceptionTypeItem}" AutomationProperties.Name="İstisna türü"/><TextBlock Text="Kapsam" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding ExceptionScope}" AutomationProperties.Name="İstisna kapsamı"/><TextBlock Text="Hak davranışı" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding ExceptionBehaviors}" SelectedItem="{Binding ExceptionBehavior}" ItemTemplate="{StaticResource BehaviorItem}" AutomationProperties.Name="Hak davranışı"/><TextBlock Text="Açıklama" Margin="0,7,0,3"/><TextBox Text="{Binding ExceptionDescription}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Oluştur" Command="{Binding CreateExceptionCommand}" Style="{StaticResource Action}"/><Button Content="Vazgeç" Command="{Binding CloseExceptionFormCommand}" Style="{StaticResource Action}"/></StackPanel></StackPanel></Border>
            <TextBlock Text="{Binding FormMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <!-- Basari/bilgi: tatil kaydedildi ama haklar henuz degismedi; sonraki adim soylenir. -->
            <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}"><TextBlock x:Name="InfoMessageText" Text="{Binding InfoMessage}" TextWrapping="Wrap"/></Border>
        </StackPanel>
    </controls:Drawer>
    <views:BulkOperationWizardView Panel.ZIndex="20" DataContext="{Binding BulkWizard}"/>
    </Grid>
</UserControl>
