<Window x:Class="Yemekhane.Desktop.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro • Lisans" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="920" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Language="tr-TR"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="YemekhanePro lisans ekranı">
    <!-- Tema pencerenin KENDI sozlugunde tasinir (MainWindow ile ayni desen): pencere
         App.xaml olmadan da (testler, ileride ayri surec) kurulabilsin. Arka plan Window
         yerine ic Grid'e verildi; kok oznitelikler Window.Resources'tan once cozumlenir. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyDeepBrush}" Padding="46">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="76" Height="76" HorizontalAlignment="Left"
                       Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="YemekhanePro logosu"/>
                <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Uygulamayı kullanmaya başlamak için lisansınızı etkinleştirin." Foreground="{StaticResource SidebarTextBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="24" Margin="0,16,20,0"/>

                <!-- Makine kimligi destek icin gereklidir: kullanici telefonda okur.
                     IsReadOnly ama secilebilir olmasi kopyalamaya izin verir. -->
                <TextBlock Text="Bilgisayar kimliği" Foreground="{StaticResource FaintBrush}" Margin="0,30,0,5"/>
                <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource SidebarTextBrush}" FontFamily="Consolas, Courier New" FontSize="15"
                         AutomationProperties.Name="Bilgisayar kimliği"
                         AutomationProperties.HelpText="Destek ile görüşürken bu kimliği bildirin"/>
                <TextBlock Text="Destek ile görüşürken bu kimliği bildirin." Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,6,20,0" TextWrapping="Wrap"/>

                <!-- Lisans DOSYASI icin saticinin makine koduna ihtiyaci vardir; yukaridaki
                     kisa kimlik tek yonlu bir ozettir ve ondan parmak izlerine donulemez.
                     Kod uzun oldugu icin elle yazdirilmaz, panoya kopyalanir. -->
                <Button x:Name="CopyMachineCodeButton" Content="Makine kodunu kopyala" Height="34" Margin="0,22,20,0"
                        Click="CopyMachineCodeClick" Style="{StaticResource Action}"
                        AutomationProperties.Name="Makine kodunu panoya kopyala"
                        AutomationProperties.HelpText="Lisans dosyası isteyecekseniz bu kodu satıcınıza gönderin"/>
                <TextBlock x:Name="CopyHint" Foreground="{StaticResource FaintBrush}" FontSize="11"
                           Margin="0,6,20,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="64,28,64,20">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- Iki uyari seridi birden gorununce icerik satiri asiyordu ve "Giriş yap"
                 dugmesi gorunmez alana itiliyordu (canli denetimde bulundu). Kaydirilabilir. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="Lisans etkinleştirme" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>

                <!-- Kullaniciya uygulamanin NEDEN kilitli oldugu somut olarak soylenir. -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24" TextWrapping="Wrap"/>

                <TextBlock Text="Lisans anahtarı" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="LicenseKeyBox" Height="38" MaxLength="128"
                         Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditable}"
                         FontFamily="Consolas, Courier New" FontSize="14"
                         AutomationProperties.Name="Lisans anahtarı"
                         AutomationProperties.HelpText="Satıcıdan aldığınız lisans anahtarını girin"/>

                <Border Style="{StaticResource WarningBanner}" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding VersionText, Mode=OneTime}" Foreground="{StaticResource FaintBrush}" FontSize="11"
                           HorizontalAlignment="Right" Margin="0,10,0,0"
                           AutomationProperties.Name="Uygulama sürümü"/>

                <Button x:Name="ActivateButton" Content="Etkinleştir" Height="40" Margin="0,18,0,0" IsDefault="True" Click="ActivateClick"
                        IsEnabled="{Binding IsEditable}"
                        Style="{StaticResource Primary}"
                        AutomationProperties.Name="Lisansı etkinleştir"/>

                <!-- Ikinci yol: saticinin bu bilgisayara ozel urettigi lisans dosyasi.
                     Anahtar yolundan farki, dosyanin BASKA makinede calismamasidir. -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="{StaticResource FaintBrush}" VerticalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Grid.Column="1" Text="ya da" Margin="10,0" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                    <Border Grid.Column="2" Height="1" Background="{StaticResource FaintBrush}" VerticalAlignment="Center" Opacity="0.5"/>
                </Grid>

                <Button x:Name="ImportFileButton" Content="Lisans dosyası yükle (.lic)" Height="38" Margin="0,16,0,0"
                        Click="ImportFileClick" IsEnabled="{Binding IsEditable}"
                        Style="{StaticResource Action}"
                        AutomationProperties.Name="Lisans dosyası yükle"
                        AutomationProperties.HelpText="Satıcınızın bu bilgisayar için ürettiği .lic dosyasını seçin"/>

                <TextBlock Text="Lisans anahtarı için internet gerekmez. Satıcınız size bu bilgisayara özel bir .lic dosyası verdiyse ikinci seçeneği kullanın."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="Esc: çıkış" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
