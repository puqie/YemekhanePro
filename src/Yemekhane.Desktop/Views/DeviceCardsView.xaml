<UserControl x:Class="Yemekhane.Desktop.Views.DeviceCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </ResourceDictionary>
</UserControl.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Kart Yükleme Durumu" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,9,0"
                        Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{StaticResource WarningBrush}">
                        <Run Text="{Binding TotalOutstanding, Mode=OneWay}"/><Run Text=" kart bekliyor"/>
                    </TextBlock>
                </Border>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
                <!-- Ekranin tek birincil eylemi: marka rengi (turuncu) ile ayrisir. -->
                <Button Style="{StaticResource Primary}" Content="Şimdi yükle" Command="{Binding PushNowCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="5"
                Padding="11,7" Margin="0,14,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
        <!-- "Simdi yukle" sonucu: cihazlar cevrimdisiyken dugme sessiz kaliyordu. -->
        <Border Grid.Row="1" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="5"
                Padding="11,7" Margin="0,14,0,10"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- Ust: cihaz kartlari (satir basina 3-4 kart); alt: secili cihazin kart listesi TAM genislikte.
             Eskiden liste 380px'lik sag panelde duruyordu; 7 sutunlu bir tablo oraya sigmaz. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cihaz listesi: mudahale gereken cihazlar basta. Cok cihazda dikey kaydirilir, panele yer kalir. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="330" Margin="0,0,12,12" Padding="15" Background="White"
                                    BorderThickness="1" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"/>
                                        <Border CornerRadius="12" Padding="9,4" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <Separator Margin="0,12,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Yüklü" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Loaded}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Bekliyor" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Pending}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hatalı" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Failed}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource Action}" Content="Cihazdaki kartlar"
                                                ToolTip="Bu cihaza yüklenmiş, bekleyen ve hatalı kartların tam listesi"
                                                Command="{Binding DataContext.ShowCardsCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource Action}" Content="Bekleyen kartları göster"
                                                Command="{Binding DataContext.SelectDeviceCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Secili cihaz paneli: "Cihazdaki kartlar" tablosu + "Bekleyen kartlar" kuyrugu -->
            <Border Grid.Row="1" Margin="0,2,0,0" Padding="16,12,16,12" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDevice.DeviceName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TabControl SelectedIndex="{Binding SelectedPanelTab}" BorderThickness="0" Background="Transparent" Padding="0,8,0,0">
                        <!-- Sekme 0: cihazdaki kartlar (eski programdaki "Cihaz Sicil Listesi" karsiligi) -->
                        <TabItem Header="{Binding CardsTabHeader}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource FieldCompact}" Width="260" Margin="0,0,8,0" Text="{Binding CardSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Öğrenci no, ad soyad veya kart numarası (baştan eşleşir)" AutomationProperties.Name="Cihazdaki kartlarda ara">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCardsCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource Action}" Content="Ara" Command="{Binding SearchCardsCommand}"/>
                                    <TextBlock Grid.Column="2" Text="Kaynak: sunucudaki kart-cihaz durum tablosu. Cihaz belleğinin doğrudan okunması turnike adaptörüne bağlıdır." Foreground="{StaticResource FaintBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <!-- Alt dolgu: son satir tablo kenarinda yarim kalmasin (rapor tablosuyla ayni kural). -->
                                    <DataGrid x:Name="DeviceCardsGrid" Padding="0,0,0,8" ItemsSource="{Binding DeviceCards}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Cihazdaki kartlar">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="70"/>
                                            <DataGridTextColumn Header="AD SOYAD" Binding="{Binding StudentName}" Width="Auto" MinWidth="150"/>
                                            <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="60"/>
                                            <DataGridTextColumn Header="KART NO" Binding="{Binding CardNumber}" Width="Auto" MinWidth="100"/>
                                            <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="Auto" MinWidth="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLoaded}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="SON SENKRON" Binding="{Binding LastSyncedText}" Width="Auto" MinWidth="130"/>
                                            <!-- HATA yildiz sutundur (kalan alani doldurur); eylem sutunu SABIT genisliktedir.
                                                 Ikisi de esnek olunca dugme sutunu panelin sag kenarindan tasip kirpiliyordu. -->
                                            <DataGridTextColumn Header="HATA" Binding="{Binding LastError}" Width="*" MinWidth="90"/>
                                            <DataGridTemplateColumn Header="" Width="128">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Action}" Content="Yeniden yükle" Padding="8,3" Margin="0" IsEnabled="{Binding CanResync}" ToolTip="{Binding ResyncHint}" ToolTipService.ShowOnDisabled="True"
                                                                Command="{Binding DataContext.ResyncCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Bu cihaz için kayıtlı kart yok." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsCardsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="3" VerticalAlignment="Top" Visibility="{Binding IsCardsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding CardsPageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousCardsPageCommand}"/>
                                    <Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextCardsPageCommand}"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <!-- Sekme 1: bekleyen kart kuyrugu -->
                        <TabItem Header="{Binding PendingTabHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" Background="{StaticResource SunkenBrush}" CornerRadius="5">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/>
                                                <!-- No + sinif + kart: ayni adli ogrenciler ancak boyle ayirt edilir. -->
                                                <TextBlock Text="{Binding IdentityText}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionText}" Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AttemptText}" FontSize="10"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRetried}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="240" Height="3"/>
                <TextBlock Text="Kart durumu yükleniyor..." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
