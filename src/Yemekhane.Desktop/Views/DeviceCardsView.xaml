<UserControl x:Class="Yemekhane.Desktop.Views.DeviceCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </ResourceDictionary>
</UserControl.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Kart Yükleme Durumu" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,9,0"
                        Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{StaticResource WarningBrush}">
                        <Run Text="{Binding TotalOutstanding, Mode=OneWay}"/><Run Text=" kart bekliyor"/>
                    </TextBlock>
                </Border>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource Action}" Content="Şimdi yükle" Command="{Binding PushNowCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="5"
                Padding="11,7" Margin="0,14,0,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Cihaz listesi: mudahale gereken cihazlar basta -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="330" Margin="0,0,12,12" Padding="15" Background="White"
                                    BorderThickness="1" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"/>
                                        <Border CornerRadius="12" Padding="9,4" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <Separator Margin="0,12,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Yüklü" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Loaded}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Bekliyor" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Pending}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hatalı" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Failed}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Style="{StaticResource Action}" Content="Bekleyen kartları göster"
                                            Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.SelectDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Secili cihazin bekleyen kart kuyrugu -->
            <Border Grid.Column="1" Width="380" Margin="10,0,0,0" Padding="16" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedDevice.DeviceName}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Bekleyen kartlar" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        <Separator Margin="0,12,0,8"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" Background="{StaticResource SunkenBrush}" CornerRadius="5">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CardNumber}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionText}" Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AttemptText}" FontSize="10"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRetried}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="240" Height="3"/>
                <TextBlock Text="Kart durumu yükleniyor..." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
