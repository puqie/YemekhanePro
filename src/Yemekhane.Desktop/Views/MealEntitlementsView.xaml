<UserControl x:Class="Yemekhane.Desktop.Views.MealEntitlementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Yemekhane.Desktop.Views"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls" xmlns:local="clr-namespace:Yemekhane.Desktop"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/Drawer.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/Modal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:AllInverseBoolConverter x:Key="AllInverseBool"/>
        <!-- Ham API kodlarini (Active, Manual...) ekranda Turkce gosterir. -->
        <converters:EnumTextConverter x:Key="EnumText"/>
            </ResourceDictionary>
</UserControl.Resources>
    <Border Background="{StaticResource CanvasBrush}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Yemek Hakedişleri" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Öğrenci bazlı hak, kullanım ve kalan miktar yönetimi" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                <Button Style="{StaticResource Destructive}" Content="Seçileni İptal Et" Command="{Binding RequestCancelCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seçili hakları iptal et">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllInverseBool}">
                            <Binding Path="IsGrantOpen"/>
                            <Binding Path="BulkWizard.IsOpen" FallbackValue="False"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Style="{StaticResource Action}" Content="+ Hızlı Hakediş" Command="{Binding OpenGrantCommand}" Visibility="{Binding CanBulk, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Hızlı hakediş çekmecesini aç">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllInverseBool}">
                            <Binding Path="IsCancelConfirmationOpen"/>
                            <Binding Path="BulkWizard.IsOpen" FallbackValue="False"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Style="{StaticResource Action}" Content="Toplu İşlem" Command="{Binding OpenBulkCommand}" Visibility="{Binding CanBulk, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Toplu işlem sihirbazını aç">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllInverseBool}">
                            <Binding Path="IsGrantOpen"/>
                            <Binding Path="IsCancelConfirmationOpen"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,10">
            <WrapPanel>
                <!-- Filtre alanlarina GORUNUR etiket eklendi. Once yalnizca ToolTip
                     vardi: dokuz bos kutu yan yana duruyor, kullanici fareyi uzerine
                     getirip beklemeden hangisinin ne oldugunu bilemiyordu. Ogrenciler
                     ekranindaki etiketli desenin aynisi. -->
                <!-- 125px'te "26.08.2026" metni takvim simgesini kesiyordu; 140 ikisine yeter. -->
                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Başlangıç" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding StartsOn}" ToolTip="Başlangıç tarihi"/></StackPanel>
                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Bitiş" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding EndsOn}" ToolTip="Bitiş tarihi"/></StackPanel>
                <!-- TEK ARAMA KUTUSU: ad, ogrenci no, kart no ve sinif birlikte aranir.
                     Once bunlar dort ayri kutuydu; kullanici aradigi seyin hangi kutuya
                     ait oldugunu bilmek zorundaydi ve yanlis kutuya yazinca SESSIZCE bos
                     sonuc aliyordu. Dort kutu yerine bir kutu ayrica %125 olcekte
                     tasmayi da onler. MinWidth ile daralinca kucuk ekranda da kullanilir
                     kalir; Width sabit degil ki dar pencerede kutu kaybolmasin. -->
                <StackPanel MinWidth="240" Width="300" Margin="0,0,10,8">
                    <TextBlock Style="{StaticResource Label}" Text="Ara" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldCompact}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ad, öğrenci no, kart no veya sınıf yazın"
                             AutomationProperties.Name="Ara"
                             AutomationProperties.HelpText="Ad, öğrenci numarası, kart numarası veya sınıf adında birden arar"/>
                </StackPanel>
                <!-- Grup ve Ogun kutulari "Tümü" ogesiyle baslar: bos bir acilir kutu kullaniciya
                     "secilmemis" gibi gorunuyordu ve bir kez secim yapinca filtreyi geri
                     kaldirmanin yolu yoktu (WPF ComboBox'ta secim UI'dan sifirlanamaz). -->
                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Grup" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding GroupFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGroupFilter}" ToolTip="Grup"/></StackPanel>
                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Öğün" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding MealFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMealFilter}" ToolTip="Öğün"/></StackPanel>
                <StackPanel Width="95" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Durum" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Statuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Status}" ToolTip="Durum"/></StackPanel>
                <Button Style="{StaticResource Action}" Content="Filtrele" Command="{Binding SearchCommand}" IsDefault="True" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>

        <!-- Row 2 tek bir StackPanel: yeni SATIR eklenmez, cunku alttaki ogeler
             Grid.Row="3"/"4" diye SABIT indeksler; satir eklemek duzeni sessizce kaydirirdi. -->
        <StackPanel Grid.Row="2">
        <UniformGrid Columns="3" Margin="0,0,0,10">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="TOPLAM HAK" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding TotalQuantity, StringFormat=N0}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="KULLANILAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding ConsumedQuantity, StringFormat=N0}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="KALAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding RemainingQuantity, StringFormat=N0}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/></StackPanel></Border>
        </UniformGrid>

        <!-- SECILI OGRENCININ DONEMI: "veli soruyor, kac ogun kaldi, ne zaman bitiyor".
             Tek ogrenci seciliyken gorunur; cok secimde hangi ogrencinin rakami oldugu
             belirsiz olacagi icin gizlenir. -->
        <ItemsControl ItemsSource="{Binding Periods}" Margin="0,0,0,10"
                      Visibility="{Binding HasPeriods, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding StudentName, Mode=OneWay}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding MealName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding PeriodText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding RenewFromText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="KALAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding RemainingText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="SON GÜN" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding LastDateText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DaysLeftText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- BITISI YAKLASANLAR: veli aramadan ONCE yenilemeyi gormek icin. Suresi coktan
             gecmis olanlar esikten bagimsiz listeye girer; gec fark etmek de ayni derttir. -->
        <Expander IsExpanded="{Binding IsExpiringOpen}" Margin="0,0,0,10"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock Text="Bitişi yaklaşan hakedişler" FontWeight="SemiBold"/>
            </Expander.Header>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Kaç gün içinde bitecekler:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ExpiringDaysText, UpdateSourceTrigger=LostFocus}" Width="60" Margin="8,0,0,0"
                                 AutomationProperties.Name="Gün eşiği"/>
                        <TextBlock Text="{Binding ExpiringMessage}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Expiring}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" MaxHeight="260"
                              Visibility="{Binding HasExpiring, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ÖĞRENCİ" Binding="{Binding StudentName}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="56"/>
                            <DataGridTextColumn Header="ÖĞÜN" Binding="{Binding MealName}" Width="Auto" MinWidth="90"/>
                            <DataGridTextColumn Header="KALAN" Binding="{Binding RemainingText}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="SON GÜN" Binding="{Binding LastDateText}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding DaysLeftText}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="VELİ TEL" Binding="{Binding ParentPhone}" Width="Auto" MinWidth="100"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <!-- Suresi GECMIS satirlar kirmizi: yenileme gecikmis demektir. -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Expander>
        </StackPanel>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="12,10,12,0" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedItems.Count, StringFormat=Seçili: {0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" x:Name="SelectedCountText"/>
                        <Button Content="Seçimi temizle" Command="{Binding ClearSelectionCommand}" Padding="8,3" Margin="10,0,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
                <!-- Secim satirin kendi IsSelected ozelligindedir, tablonun satir seciminde DEGIL:
                     onay kutusu DataGridRow.IsSelected'e bagliyken ayni tiklama hem satiri
                     seciyor hem tiki degistiriyordu ve tik aninda geri kapaniyordu. Grid
                     IsReadOnly="False" olmali ki onay kutusu duzenlenebilsin; metin sutunlari
                     tek tek salt okunur isaretlendi. -->
                <DataGrid x:Name="EntitlementsGrid" Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Single" SelectionUnit="Cell"
                    AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                    GridLinesVisibility="Horizontal"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Yemek hakediş listesi">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="SEÇ" FontSize="{StaticResource FontXs}"/></DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              AutomationProperties.Name="Satırı seç"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- TARIH ve OGUN genisletildi: "09.09.2026" 82px'e sigmiyor
                             ("09.09.202" olarak kesiliyordu), "Ogle Yemegi" de oyle
                             ("Ogle Yem"). Yer, tek/iki karakter tasiyan SINIF ile
                             kisa degerli KAYNAK sutunlarindan alindi. -->
                        <!-- Width="Auto": DataGridCell stilinde her hucrede 22px yatay
                             dolgu var (Padding 11,0). Sabit piksel verildiginde bu dolgu
                             metinden calindigi icin "09.09.2026" 95px'te bile
                             "09.09.202" olarak kesiliyordu. Auto icerigi VE dolguyu
                             birlikte olcer; kesme kalmaz. -->
                        <DataGridTextColumn IsReadOnly="True" Header="TARİH" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto" MinWidth="95"/>
                        <DataGridTextColumn IsReadOnly="True" Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="56"/>
                        <DataGridTextColumn IsReadOnly="True" Header="KART NO" Binding="{Binding CardNumber}" Width="Auto" MinWidth="88"/>
                        <DataGridTextColumn IsReadOnly="True" Header="ÖĞÜN" Binding="{Binding MealName}" Width="Auto" MinWidth="90"/>
                        <DataGridTextColumn IsReadOnly="True" Header="AD SOYAD" Binding="{Binding StudentName}" Width="*" MinWidth="130" MaxWidth="240"/>
                        <DataGridTextColumn IsReadOnly="True" Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="50"/>
                        <DataGridTextColumn IsReadOnly="True" Header="ADET" Binding="{Binding Quantity}" Width="Auto" MinWidth="46"/>
                        <DataGridTextColumn IsReadOnly="True" Header="KULL." Binding="{Binding ConsumedQuantity}" Width="Auto" MinWidth="46"/>
                        <DataGridTextColumn IsReadOnly="True" Header="KALAN" Binding="{Binding RemainingQuantity}" Width="Auto" MinWidth="64"/>
                        <DataGridTextColumn IsReadOnly="True" Header="DURUM" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=Status}" Width="Auto" MinWidth="62"/>
                        <!-- Auto: "Hızlı Hakediş" 80px'te "WPF Quic" gibi kesiliyordu. -->
                        <DataGridTextColumn IsReadOnly="True" Header="KAYNAK" Binding="{Binding Source, Converter={StaticResource EnumText}, ConverterParameter=Source}" Width="Auto" MinWidth="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Hakedişler yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <TextBlock Grid.RowSpan="2" Text="Filtrelerle eşleşen hakediş bulunamadı." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,9,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                <!-- Basari geri bildirimi: "135 hak olusturuldu" gibi. Cekmece kapandigi icin
                     onceden bu bilgi hicbir yerde gorunmuyordu. -->
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/><Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/></StackPanel></Grid>

        <controls:Drawer Grid.RowSpan="5" IsOpen="{Binding IsGrantOpen}" DrawerWidth="400" Title="Hızlı Hakediş" CloseCommand="{Binding CloseGrantCommand}">
            <StackPanel>
                <TextBlock Text="Hedef" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding TargetTypes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding TargetType}"/>
                <StackPanel Visibility="{Binding IsManualTarget, Converter={StaticResource BoolToVisibility}}">
                    <!-- OGRENCI SECIMI: hakedis listesi ogrenci-GUN satiridir, ayni ogrenci 300 gun
                         icin 300 kez gorunur ve oradan secilemez. Burasi ayri bir listedir: her
                         ogrenci TEK satir, ad/sinif/numara ile aranir, secim aramalar arasinda korunur. -->
                    <TextBlock Text="Öğrenci ara (ad, soyad, sınıf ya da no)" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="Ara" Margin="7,0,0,0"
                                Command="{Binding SearchStudentsCommand}" AutomationProperties.Name="Hakediş için öğrenci ara"/>
                        <TextBox Text="{Binding StudentPickerSearch, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Hakediş öğrenci arama metni">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchStudentsCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <Grid Margin="0,6,0,0" Visibility="{Binding HasPickerRows, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid ItemsSource="{Binding StudentPicker}" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="170"
                                  AutomationProperties.Name="Hakediş öğrenci listesi">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="SEÇ" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                                <DataGridTextColumn IsReadOnly="True" Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="64"/>
                                <DataGridTextColumn IsReadOnly="True" Header="AD SOYAD" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn IsReadOnly="True" Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="60"/>
                                <DataGridTextColumn IsReadOnly="True" Header="ŞUBE" Binding="{Binding SectionName}" Width="Auto" MinWidth="52"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding PickerSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Seçimi temizle" Command="{Binding ClearPickerCommand}" Padding="8,3" Margin="10,0,0,0"
                                Visibility="{Binding HasPickerRows, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- Varsayilan KAPALI: yeni arama secimi sifirlar. Acikken kullanici
                             gormedigi ogrenciye hak verebiliyordu; cogul sinif secimi icin
                             bilerek isaretlenir. -->
                        <CheckBox Content="Seçimi koru (birden çok sınıf)" IsChecked="{Binding KeepSelectionAcrossSearches}"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="İşaretliyse yeni arama önceki seçimi silmez; birden çok sınıfa aynı anda hak vermek için."
                                  AutomationProperties.Name="Seçimi koru"/>
                    </WrapPanel>
                    <!-- GORUNMEYEN SECIM UYARISI: onceki aramadan tasinan secili ogrenciler
                         adiyla yazilir. Bu serit olmadan kullanici "ela" ararken hala secili
                         olan "ceylin"e de hak veriyor ve bunu fark etmiyordu. -->
                    <Border Background="{StaticResource WarningSoftBrush}" Padding="10,8" Margin="0,6,0,0" CornerRadius="4"
                            Visibility="{Binding HasHiddenSelection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding HiddenSelectionWarning}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Öğrenci numaraları (elle)" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                    <Border Background="{StaticResource InfoSoftBrush}" Padding="10,8" x:Name="SelectionSummaryPanel"
                            Visibility="{Binding SelectedItems.Count, Converter={x:Static local:SelectionCountToVisibilityConverter.Instance}}">
                        <TextBlock x:Name="SelectionSummaryText" TextWrapping="Wrap"
                                   Text="{Binding SelectedItems.Count, StringFormat=Seçili {0} öğrenciye verilecek.}"/>
                    </Border>
                    <!-- Kullanicinin elinde ogrenci KIMLIGI (GUID) yoktur, NUMARASI vardir. Kutu
                         numara kabul eder (5012, 5013); sunucu numarayi cozer, bilinmeyen numarayi
                         adiyla reddeder. Kimlik girisi (derin baglanti) da calismaya devam eder. -->
                    <TextBox x:Name="ManualStudentIdsBox" Text="{Binding ManualStudentIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="58"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             ToolTip="Öğrenci numaralarını virgülle ayırarak girin (örn. 5012, 5013)."
                             AutomationProperties.Name="Öğrenci numaraları"
                             Visibility="{Binding SelectedItems.Count, Converter={x:Static local:SelectionCountToVisibilityConverter.Instance}, ConverterParameter=Invert}"/>
                    <TextBlock x:Name="ManualStudentIdsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Virgülle ayırarak öğrenci numarası girin (örn. 5012, 5013) ya da listeden satır seçip Hızlı Hakediş'i açın."
                               Visibility="{Binding SelectedItems.Count, Converter={x:Static local:SelectionCountToVisibilityConverter.Instance}, ConverterParameter=Invert}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsClassTarget, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Sınıf" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedItem="{Binding GrantClass}"/></StackPanel>
                <StackPanel Visibility="{Binding IsGradeTarget, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Kademe / sınıf seviyesi" Style="{StaticResource Label}"/><TextBox Text="{Binding Grade}" ToolTip="Örnek: 5"/></StackPanel>
                <StackPanel Visibility="{Binding IsGroupTarget, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Grup" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedItem="{Binding GrantGroup}"/></StackPanel>
                <TextBlock Text="Öğün" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MealTypes}" DisplayMemberPath="Name" SelectedItem="{Binding GrantMeal}"/>
                <!-- Ogun bedeli Tanimlar ekraninda girilir; sifirsa satir gizli (ucretsiz ogun). -->
                <TextBlock x:Name="GrantMealPriceText" Text="{Binding GrantMealPriceText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Visibility="{Binding HasGrantMealPrice, Converter={StaticResource BoolToVisibility}}"/>
                <!-- Ucretli ogunde: bedel kasaya OGRENCI BASINA gelir olarak islenebilir ve
                     veliye bilgi SMS'i gonderilebilir. Once bedel yalnizca ekranda yaziyordu;
                     kasaya hicbir sey yansimiyordu. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding CanCharge, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="Ücreti kasaya gelir olarak işle" IsChecked="{Binding ChargeToCash}"
                              AutomationProperties.Name="Ücreti kasaya gelir olarak işle"/>
                    <CheckBox Content="Veliye bilgi SMS'i gönder" IsChecked="{Binding NotifyParents}" Margin="0,6,0,0"
                              AutomationProperties.Name="Veliye bilgi SMS'i gönder"/>
                </StackPanel>
                <!-- BITIS TARIHI yerine GUN SAYISI: kullanici "10 gunluk yemek hakki"
                     diye dusunur, bitis tarihini takvimden hafta sonlarini sayarak
                     bulmak zorunda kalmamali. Sayim IS GUNU uzerinden yapilir, yani
                     "10 gun" her zaman 10 hak demektir. Hesaplanan aralik hemen
                     altta gosterilir ki kullanici uygulamadan once gorebilsin. -->
                <TextBlock Text="Başlangıç" Style="{StaticResource Label}"/>
                <DatePicker SelectedDate="{Binding GrantStartsOn}" AutomationProperties.Name="Hakediş başlangıç tarihi"/>
                <TextBlock Text="Kaç gün" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                <TextBox x:Name="DayCountBox" Width="110" HorizontalAlignment="Left"
                         Text="{Binding DayCountText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Örnek: 10, 15, 20. Hafta sonu seçimine göre iş günü sayılır."
                         AutomationProperties.Name="Gün sayısı"/>
                <TextBlock x:Name="GrantRangeText" Text="{Binding GrantRangeText}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Hesaplanan tarih aralığı"/>
                <!-- Metin olarak baglanir: int baglamada "abc" sessizce reddedilip ESKI adet kalirdi. -->
                <TextBlock Text="Günlük adet (1-10)" Style="{StaticResource Label}"/><TextBox x:Name="QuantityBox" Width="110" HorizontalAlignment="Left" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Günlük adet"/>
                <WrapPanel Margin="0,10,0,0"><CheckBox Content="Cumartesi dahil" IsChecked="{Binding IncludeSaturday}" Margin="0,0,18,0"/><CheckBox Content="Pazar dahil" IsChecked="{Binding IncludeSunday}"/></WrapPanel>
                <Separator Margin="0,16"/>
                <Button Content="Etkileri Önizle" Command="{Binding PreviewCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"
                        ToolTip="Uygulamadan önce kaç öğrenciyi, kaç günü ve kaç hakkı etkileyeceğini gösterir."/>
                <Border Background="{StaticResource InfoSoftBrush}" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Önizleme" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="PreviewTotalText" Text="{Binding PreviewTotalText}" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="{Binding HasPreviewTotal, Converter={StaticResource BoolToVisibility}}"/><Button Margin="0,10,0,0" Content="Uygula" Command="{Binding ApplyCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"/></StackPanel></Border>
                <TextBlock Text="{Binding PreviewMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </controls:Drawer>

        <!-- Iptal onayi: ortak Modal (dar olcu; once elle yazilmis Border + karartma). -->
        <controls:Modal Grid.RowSpan="5" Style="{StaticResource ModalNarrow}" Title="Hakları iptal et"
                        IsOpen="{Binding IsCancelConfirmationOpen, Mode=OneWay}" CloseCommand="{Binding CloseCancelCommand}">
                <StackPanel>
                    <TextBlock Text="{Binding CancelConfirmationText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="10,8" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                            <Run Text="{Binding StudentNo, Mode=OneWay}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding StudentName, Mode=OneWay}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding ClassName, Mode=OneWay}"/>
                                            <Run Text=" • Kart "/>
                                            <Run Text="{Binding CardNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            <controls:Modal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vazgeç" Command="{Binding CloseCancelCommand}" Style="{StaticResource Action}"/><Button Content="İptali Onayla" Command="{Binding ConfirmCancelCommand}" Style="{StaticResource Destructive}"/></StackPanel>
            </controls:Modal.Footer>
        </controls:Modal>
        <views:BulkOperationWizardView Grid.RowSpan="5" Panel.ZIndex="20" DataContext="{Binding BulkWizard}"/>
    </Grid>
    </Border>
</UserControl>
