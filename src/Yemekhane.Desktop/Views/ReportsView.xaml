<UserControl x:Class="Yemekhane.Desktop.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    Language="tr-TR" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="FilterGroup" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <!-- Diger ekranlarla ayni etiket stili: once burada 10px BUYUK HARF etiketler vardi. -->
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <!-- Rapor tablosu 9 sutuna kadar cikar; tasarim sisteminin 11px hucre dolgusu (sutun basina 22px)
             1440px'te tek basina ~200px yiyor ve Gunluk Gecis yatay kaydirmaya dusuyordu. Yalnizca bu
             tabloda dolgu 7px'e cekilir; diger ekranlar tasarim sisteminin varsayilanini kullanmaya devam eder. -->
        <Style x:Key="ReportCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="7,0"/></Style>
        <Style x:Key="ReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="7,0"/></Style>
            </ResourceDictionary>
</UserControl.Resources>
    <Border Background="{StaticResource CanvasBrush}">
    <!-- Sag ve alt kenar bosluklari PageShell'in kendi 22/18 dolgusundan gelir; burada tekrar verilirse
         kenar bosluklari ikiye katlanir (44px) ve tabloya kalan genislik 36px azalir. -->
    <Grid Margin="22,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Style="{StaticResource Panel}" Padding="8" Margin="0,0,0,18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="7,6,7,13"><TextBlock Text="RAPOR TÜRLERİ" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding ReportCountText}" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"/></StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReport}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Rapor türleri">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                    <!-- Alt baslik yalnizca doluysa yer kaplar (bos Run satir yuksekligi eklemez). -->
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <controls:PageShell Grid.Column="1" Title="Rapor Merkezi" Subtitle="{Binding SelectedReport.Name, StringFormat={}{0} • sunucu filtreli görünüm • Europe/Istanbul}">
            <controls:PageShell.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,9,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
                    <Button Style="{StaticResource Action}" Content="PDF" Command="{Binding ExportPdfCommand}" ToolTip="Geçerli filtrelerin tamamını PDF aktar (Ctrl+P komutu hazır)"/>
                    <Button Style="{StaticResource Action}" Content="Excel" Command="{Binding ExportExcelCommand}" ToolTip="Geçerli filtrelerin tamamını Excel aktar (Ctrl+E komutu hazır)"/>
                    <Button Style="{StaticResource Action}" Content="CSV" Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
            </controls:PageShell.Actions>

            <controls:PageShell.Filters>
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowDateFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Başlangıç"/><DatePicker Style="{StaticResource FieldCompactDate}" Width="135" SelectedDate="{Binding StartDate}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowDateFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Bitiş"/><DatePicker Style="{StaticResource FieldCompactDate}" Width="135" SelectedDate="{Binding EndDate}"/></StackPanel>
                        <!-- Sicil Listesi: tarih filtresi yok; neden sessiz kalmasin diye yazilir. -->
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowDateNote, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Tarih"/><TextBlock Text="Tarih filtresi uygulanmaz; tüm sicil listelenir." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Height="29" Padding="0,7,0,0"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowActiveStateFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Durum"/><ComboBox Style="{StaticResource FieldCompactCombo}" Width="105" ItemsSource="{Binding ActiveStates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedActiveState}" AutomationProperties.Name="Öğrenci durumu"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowStudentFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Öğrenci no"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding StudentNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowCardFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Kart no"/><TextBox Style="{StaticResource FieldCompact}" Width="115" Text="{Binding CardNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowNameFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Ad"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowNameFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Soyad"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowOrganizationFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Sınıf"/><TextBox Style="{StaticResource FieldCompact}" Width="80" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowOrganizationFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Şube"/><TextBox Style="{StaticResource FieldCompact}" Width="80" Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowOrganizationFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Bölüm"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowOrganizationFilters, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Görev"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding Job, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowMealFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Öğün"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding MealType, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowDeviceFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Cihaz"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding Device, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowDecisionFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Karar"/><TextBox Style="{StaticResource FieldCompact}" Width="90" Text="{Binding Decision, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterGroup}" Visibility="{Binding ShowStatusFilter, Converter={StaticResource BoolToVisibility}}"><TextBlock Style="{StaticResource FilterLabel}" Text="Durum"/><TextBox Style="{StaticResource FieldCompact}" Width="105" Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource Action}" Content="Sıfırla" Command="{Binding ResetCommand}"/><Button Style="{StaticResource Primary}" Padding="16,6" Content="Uygula" Command="{Binding ApplyCommand}" IsDefault="True"/></StackPanel>
                </StackPanel>
            </controls:PageShell.Filters>

            <controls:PageShell.FooterLeft>
                <StackPanel><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"/></StackPanel>
            </controls:PageShell.FooterLeft>
            <controls:PageShell.FooterRight>
                <StackPanel Orientation="Horizontal"><ComboBox Width="66" Height="29" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" ToolTip="Sayfa boyutu"/><TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/><Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/><Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/></StackPanel>
            </controls:PageShell.FooterRight>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}" Padding="13,9" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Action}" Content="Seçilenleri Kopyala" Command="{Binding CopySelectedCommand}"/>
                            <Menu Background="White" VerticalAlignment="Center"><MenuItem Header="Kolonlar" ItemsSource="{Binding Columns}"><MenuItem.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Click="ColumnVisibility_Click"/></DataTemplate></Setter.Value></Setter></Style></MenuItem.ItemContainerStyle></MenuItem></Menu>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <Grid>
                        <!-- Padding alt degeri 16: yatay kaydirma cubugu DataGrid'in ICINDE cizilir ve
                             sutunlar sigmadiginda son gorunur satirin USTUNE biner; o satir hicbir
                             zaman tam okunamiyordu. Alt dolgu cubuga kendi yerini acar. -->
                        <DataGrid x:Name="ReportGrid" Padding="0,0,0,16" CellStyle="{StaticResource ReportCell}" ColumnHeaderStyle="{StaticResource ReportHeader}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Sorting="ReportGrid_Sorting" SelectionChanged="ReportGrid_SelectionChanged" ColumnReordered="ReportGrid_ColumnReordered" AutomationProperties.Name="Dinamik rapor tablosu">
                            <DataGrid.InputBindings><KeyBinding Modifiers="Control" Key="C" Command="{Binding CopySelectedCommand}"/><KeyBinding Modifiers="Control" Key="P" Command="{Binding ExportPdfCommand}"/><KeyBinding Modifiers="Control" Key="E" Command="{Binding ExportExcelCommand}"/></DataGrid.InputBindings>
                        </DataGrid>
                        <TextBlock Text="Bu filtrelerle kayıt bulunamadı. Tarih aralığını veya filtreleri değiştirin." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Background="{StaticResource SurfaceBrush}" Opacity="0.97" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Rapor yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                    </Grid>
                </Border>
            </Grid>
        </controls:PageShell>
    </Grid>
    </Border>
</UserControl>
