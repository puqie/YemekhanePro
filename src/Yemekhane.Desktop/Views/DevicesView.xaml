<UserControl x:Class="Yemekhane.Desktop.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F5F7" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Action" TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DDE2"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="Field" TargetType="Control"><Setter Property="Margin" Value="0,3,0,9"/><Setter Property="MinHeight" Value="30"/></Style>
    </UserControl.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Cihazlar ve Turnikeler" FontSize="22" FontWeight="SemiBold" Foreground="#18222D"/><TextBlock Text="Bağlantılar, çalışma durumu ve saha yapılandırması" Foreground="#65717E" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FFF3E5" CornerRadius="12" Padding="9,4" Margin="0,0,9,0" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Canlı bağlantı çevrimdışı" Foreground="#7C6225"/></Border>
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource Action}" Content="+ Cihaz ekle" Command="{Binding AddCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#EEF4F3" BorderBrush="#D6E4E1" BorderThickness="1" CornerRadius="5" Padding="11,7" Margin="0,14,0,10" Visibility="{Binding SimulatorAllowed, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Simulator seçeneği Development ortamına özeldir ve gerçek cihaz bağlantısı olarak raporlanmaz." Foreground="#315F59"/></Border>
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="350" MinHeight="220" Margin="0,0,12,12" Padding="15" Background="White" BorderBrush="#DDE2E6" BorderThickness="1" CornerRadius="7">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#18222D"/><TextBlock Text="{Binding Model}" Foreground="#65717E" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="12" Padding="9,4" Background="#EEF1F3"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#7A8792"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="#1E7A54"/></DataTrigger><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Fill" Value="#C4483F"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StatusText}" Foreground="#46535F"/></StackPanel></Border></Grid>
                                <Separator Grid.Row="1" Margin="0,12,0,10"/>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Bağlantı" Foreground="#7A8792"/><TextBlock Grid.Column="1" Text="{Binding Endpoint}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="Konum" Foreground="#7A8792" Margin="0,7,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Location}" Margin="0,7,0,0"/></Grid>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,13,0,0"><Button Style="{StaticResource Action}" Content="Bağlan" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Action}" Content="Kes" Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Action}" Content="Test" Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Action}" Content="Yeniden" Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel>
                                <Grid Grid.Row="4" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="Ayarlar" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Action}" Content="Loglar" Command="{Binding DataContext.LogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Action}" Content="Pasifleştir" Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel><StackPanel HorizontalAlignment="Right"><ProgressBar IsIndeterminate="True" Width="55" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding OperationMessage}" Foreground="#65717E" FontSize="10" MaxWidth="160" TextWrapping="Wrap" ToolTip="{Binding OperationMessage}"/></StackPanel></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="240" Height="3"/><TextBlock Text="Cihazlar yükleniyor..." Foreground="#65717E" Margin="0,12,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Kayıtlı cihaz yok" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="İlk cihazı ekleyerek bağlantı yönetimine başlayın." Foreground="#65717E" Margin="0,6,0,0"/></StackPanel>
            <Border Width="460" Padding="24" Background="White" BorderBrush="#DDE2E6" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Cihazlar kullanılamıyor" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#9C342F" TextWrapping="Wrap" Margin="0,9,0,13"/><Button Style="{StaticResource Action}" Content="Tekrar dene" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
        </Grid>

        <Border Grid.RowSpan="3" Background="#66000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="20">
            <Border Width="510" MaxHeight="760" Padding="22" Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <Grid><TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold"/><Button Content="Kapat" Command="{Binding CloseEditorCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right"/></Grid>
                <TextBlock Text="Ad" Margin="0,16,0,0"/><TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tür"/><ComboBox Style="{StaticResource Field}" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedType}"/>
                <StackPanel Visibility="{Binding IsEthernet, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="IP adresi"/><TextBox Style="{StaticResource Field}" Text="{Binding IpAddress}"/><TextBlock Text="Port"/><TextBox Style="{StaticResource Field}" Text="{Binding Port}"/></StackPanel>
                <StackPanel Visibility="{Binding IsCom, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="COM portu"/><TextBox Style="{StaticResource Field}" Text="{Binding ComPort}"/><TextBlock Text="Baud"/><TextBox Style="{StaticResource Field}" Text="{Binding BaudRate}"/></StackPanel>
                <TextBlock Text="Konum"/><TextBox Style="{StaticResource Field}" Text="{Binding Location}"/><TextBlock Text="Yön"/><ComboBox Style="{StaticResource Field}" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"/>
                <WrapPanel><CheckBox Content="Aktif" IsChecked="{Binding IsActive}" Margin="0,5,18,10"/><CheckBox Content="Otomatik bağlan" IsChecked="{Binding AutoConnect}" Margin="0,5,18,10"/><CheckBox Content="Turnike bağlı" IsChecked="{Binding HasTurnstile}" Margin="0,5,0,10"/></WrapPanel>
                <Border Background="#FFF3E5" Padding="9" Margin="0,0,0,10" Visibility="{Binding IsSimulator, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Development simulator: üretimde oluşturulamaz." Foreground="#7C6225"/></Border>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9C342F" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="Kaydet" Command="{Binding SaveCommand}" Padding="15,8" HorizontalAlignment="Right" Background="#C33A02" Foreground="White" BorderThickness="0"/>
            </StackPanel></ScrollViewer></Border>
        </Border>
        <Border Grid.RowSpan="3" Width="470" HorizontalAlignment="Right" Background="White" BorderBrush="#CBD2D8" BorderThickness="1,0,0,0" Padding="20" Visibility="{Binding IsLogsOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Cihaz logları" FontSize="20" FontWeight="SemiBold"/><Button Content="Kapat" Command="{Binding CloseLogsCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right"/></Grid><ListView Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,14,0,0" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="#E1E5E9" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><Grid><TextBlock Text="{Binding EventType}" FontWeight="SemiBold"/><TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" HorizontalAlignment="Right" Foreground="#7A8792"/></Grid><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#46535F" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
    </Grid>
</UserControl>
