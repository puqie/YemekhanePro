<Window x:Class="Yemekhane.Desktop.Views.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro • Parola sıfırlama" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png"
        Width="560" Height="620" MinWidth="480" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Language="tr-TR"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Parola sıfırlama ekranı">
    <!-- Tema pencerenin KENDI sozlugunde tasinir (LoginWindow ile ayni desen): pencere
         App.xaml olmadan da (testler) kurulabilsin. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- Uyari seridi ve dosya adi birden gorununce icerik tasabiliyor; kaydirilabilir
             birakildi (LoginWindow'da ayni sorun canli denetimde bulunmustu). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="40,28,40,0">
            <StackPanel MaxWidth="440">
                <TextBlock Text="Parolanızı sıfırlayın" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,20"
                           Text="Satıcınızın bu bilgisayar için ürettiği lisans dosyasını seçin. Dosya bu bilgisayara ait değilse sıfırlama yapılmaz."/>

                <TextBlock Text="1 • Lisans dosyası" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <Button x:Name="ChooseFileButton" Content="Lisans dosyası seç (.lic)" Height="38" Click="ChooseFileClick"
                        AutomationProperties.Name="Lisans dosyası seç"
                        AutomationProperties.HelpText="Satıcınızın bu bilgisayar için ürettiği .lic dosyasını seçin"/>
                <TextBlock Text="{Binding SelectedFileName}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.Name="Seçilen lisans dosyası"/>

                <TextBlock Text="2 • Sıfırlanacak kullanıcı adı" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,5"/>
                <TextBox x:Name="UsernameBox" Height="38" MaxLength="100"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Kullanıcı adı"
                         AutomationProperties.HelpText="Parolası sıfırlanacak hesabın kullanıcı adı"/>

                <TextBlock Text="3 • Yeni parola" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,5"/>
                <PasswordBox x:Name="NewPasswordBox" Height="38" MaxLength="256" PasswordChar="●"
                             PasswordChanged="PasswordChanged"
                             AutomationProperties.Name="Yeni parola"
                             AutomationProperties.HelpText="En az 12 karakter"/>
                <TextBlock Text="Yeni parola (tekrar)" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="38" MaxLength="256" PasswordChar="●"
                             PasswordChanged="PasswordChanged"
                             AutomationProperties.Name="Yeni parola tekrar"
                             AutomationProperties.HelpText="Aynı parolayı yeniden girin"/>
                <TextBlock Text="{Binding PasswordHint}" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"/>

                <Border Style="{StaticResource WarningBanner}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Border>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button x:Name="ResetButton" Content="Parolayı sıfırla" Height="40" Margin="0,18,0,0" IsDefault="True"
                        Click="ResetClick" Style="{StaticResource Primary}"
                        AutomationProperties.Name="Parolayı sıfırla"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,20"
                           Text="Sıfırlama kayıt altına alınır. İşlem sonrası bu hesabın önceki oturumları geçersiz olur."/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="Esc: vazgeç" Margin="0,6,40,10" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
    </Grid>
</Window>
