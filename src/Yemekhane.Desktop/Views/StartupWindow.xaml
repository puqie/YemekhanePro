<Window x:Class="Yemekhane.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png"
        Width="440" Height="240" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" Language="tr-TR"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="YemekhanePro başlatılıyor">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource NavyDeepBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="36,0">
            <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png"
                   Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="YemekhanePro logosu"/>
            <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
            <!-- Ilerleme METNI onemlidir: ilk acilista veritabani olusturulur ve
                 gocler uygulanir; yavas bir bilgisayarda bu dakikalar surer. Metin
                 olmasaydi kullanici bos ekrana bakip programin dondugunu sanardi
                 (sahada tam olarak bu sikayet geldi). -->
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SidebarTextBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Başlatma durumu"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,18,0,0"
                         Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
