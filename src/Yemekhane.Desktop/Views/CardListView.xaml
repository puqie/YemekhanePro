<UserControl x:Class="Yemekhane.Desktop.Views.CardListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- KARTLAR: okuldaki tum kartlarin aktif/pasif durumu tek listede; satirdan pasiflestir /
         aktiflestir. Saha: turnike "Kart pasif" deyince operator karti nereden acacagini
         bilmiyordu; pasif kartlar yalnizca ogrencinin Kartlar sekmesinde salt okunur gorunuyordu. -->
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Kartlar" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Action}" Content="Yenile" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="5"
                    Padding="11,7" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>
            <!-- Pasiflestirme / geri acma sonucu: dugme sessiz kalmasin. -->
            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="5"
                    Padding="11,7" Margin="0,14,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource FieldCompact}" Width="280" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Öğrenci no, ad soyad, kart no veya baskı no (baştan eşleşir)" AutomationProperties.Name="Kartlarda ara">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
            </TextBox>
            <ComboBox Grid.Column="1" Width="130" Margin="0,0,8,0" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="Durum süzgeci" ToolTip="Tümü / Aktif / Pasif"/>
            <Button Grid.Column="2" Style="{StaticResource Action}" Content="Filtrele" Command="{Binding SearchCommand}"/>
            <TextBlock Grid.Column="3" Text="Pasifleştirmek için satırdaki düğmeye basıp neden yazın; pasif kartı Aktifleştir ile geri açın."
                       Foreground="{StaticResource FaintBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3">
            <!-- Sutun genislikleri 1300px gorunume gore: BASKI NO sutunu yok (arama onu da kapsar),
                 ISLEM sabit genislikte ki neden kutusu + Onayla + Vazgec kirpilmasin. -->
            <DataGrid x:Name="CardsGrid" Padding="0,0,0,8" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Kart listesi">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="AD SOYAD" Binding="{Binding StudentName}" Width="Auto" MinWidth="150"/>
                    <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="55"/>
                    <DataGridTextColumn Header="KART NO" Binding="{Binding CardNumber}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="Auto" MinWidth="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsPassive}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="GEÇERLİLİK" Binding="{Binding PeriodText}" Width="Auto" MinWidth="150"/>
                    <DataGridTextColumn Header="NEDEN" Binding="{Binding ReasonText}" Width="*" MinWidth="70"/>
                    <DataGridTemplateColumn Header="İŞLEM" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Aktif kart: Pasiflestir -> neden + Onayla / Vazgec (iki adim; sunucu nedeni zorunlu tutar). -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource Action}" Content="Pasifleştir" Padding="8,3" Margin="0"
                                                Visibility="{Binding IsDeactivateIdle, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Kartı pasife alır; turnike artık tanımaz. Neden sorulur."
                                                Command="{Binding DataContext.ArmDeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDeactivateArmed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Width="130" Height="26" MinHeight="0" Padding="4,1" VerticalContentAlignment="Center" Margin="0,0,6,0" Text="{Binding DeactivateReason, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Neden zorunlu: kayıp, hasarlı, yanlış kart..." AutomationProperties.Name="Pasifleştirme nedeni"/>
                                            <Button Style="{StaticResource Destructive}" Content="Onayla" Padding="8,3" Margin="0,0,6,0" IsEnabled="{Binding CanConfirmDeactivate}"
                                                    Command="{Binding DataContext.ConfirmDeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource Action}" Content="Vazgeç" Padding="8,3" Margin="0"
                                                    Command="{Binding DataContext.CancelDeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Pasif kart: Aktiflestir. Ogrencinin baska aktif karti varsa sunucu reddeder, mesaj ustte. -->
                                    <Button Style="{StaticResource Action}" Content="Aktifleştir" Padding="8,3" Margin="0" HorizontalAlignment="Left"
                                            Visibility="{Binding IsPassive, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Kartı yeniden aktif eder; turnike yine tanır. Öğrencinin başka aktif kartı varsa reddedilir."
                                            Command="{Binding DataContext.ReactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Filtreye uyan kart yok." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            <ProgressBar IsIndeterminate="True" Width="220" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="{Binding PageText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Style="{StaticResource Action}" Content="Önceki" Command="{Binding PreviousPageCommand}"/>
            <Button Style="{StaticResource Action}" Content="Sonraki" Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
