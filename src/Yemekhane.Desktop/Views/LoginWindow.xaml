<Window x:Class="Yemekhane.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro • Giriş" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="920" Height="570" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Language="tr-TR"
        Background="#F5F6F7" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="YemekhanePro giriş ekranı">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Background="#17232C" Padding="46">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="76" Height="76" HorizontalAlignment="Left"
                       Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="YemekhanePro logosu"/>
                <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Yemekhane operasyonlarını güvenli, hızlı ve tek noktadan yönetin." Foreground="#C9D2D8" FontSize="16" TextWrapping="Wrap" LineHeight="24" Margin="0,16,20,0"/>
                <TextBlock Text="Yerel API bağlantısı • Europe/Istanbul" Foreground="#8FA0AB" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="64,42">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" MaxWidth="340">
                <TextBlock Text="Oturum açın" FontSize="27" FontWeight="SemiBold" Foreground="#18212A"/>
                <TextBlock Text="Yetkili kullanıcı bilgilerinizle devam edin." Foreground="#5D6975" Margin="0,7,0,24"/>
                <TextBlock Text="Kullanıcı adı" Foreground="#3E4A55" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Height="38" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                         AutomationProperties.Name="Kullanıcı adı" AutomationProperties.HelpText="YemekhanePro kullanıcı adınızı girin"/>
                <TextBlock Text="Parola" Foreground="#3E4A55" Margin="0,14,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="38" MaxLength="256" PasswordChar="●"
                              AutomationProperties.Name="Parola" AutomationProperties.HelpText="Parolanızı güvenli alana girin"/>
                <Border Background="#E7F5F2" BorderBrush="#84BEB5" BorderThickness="1" Padding="10" Margin="0,14,0,0"
                        Visibility="{Binding HasSetupMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SetupMessage}" Foreground="#174F48" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#FFF2E1" BorderBrush="#E6C48F" BorderThickness="1" Padding="10" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#713F0A" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding VersionText, Mode=OneTime}" Foreground="#8A96A0" FontSize="11"
                           HorizontalAlignment="Right" Margin="0,10,0,0"
                           AutomationProperties.Name="Uygulama sürümü"/>
                <Button Content="Giriş yap" Height="40" Margin="0,18,0,0" IsDefault="True" Click="LoginClick"
                        Background="#12675F" Foreground="White" BorderBrush="#0E574F" FontWeight="SemiBold"
                        AutomationProperties.Name="Giriş yap"/>
                <TextBlock Text="Bağlantı kurulamazsa bilgileriniz gönderilmez; yeniden deneyebilirsiniz." Foreground="#687681" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Esc: çıkış" Foreground="#7B8791" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
