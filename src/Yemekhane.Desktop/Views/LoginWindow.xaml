<Window x:Class="Yemekhane.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YemekhanePro • Giriş" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="920" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Language="tr-TR"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="YemekhanePro giriş ekranı">
    <!-- Tema pencerenin KENDI sozlugunde tasinir (MainWindow ile ayni desen): pencere
         App.xaml olmadan da (testler, ileride ayri surec) kurulabilsin. Arka plan Window
         yerine ic Grid'e verildi; kok oznitelikler Window.Resources'tan once cozumlenir. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyDeepBrush}" Padding="46">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="76" Height="76" HorizontalAlignment="Left"
                       Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="YemekhanePro logosu"/>
                <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Yemekhane operasyonlarını güvenli, hızlı ve tek noktadan yönetin." Foreground="{StaticResource SidebarTextBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="24" Margin="0,16,20,0"/>
                <TextBlock Text="Yerel API bağlantısı • Europe/Istanbul" Foreground="{StaticResource FaintBrush}" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="64,28,64,20">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- Iki uyari seridi birden gorununce icerik satiri asiyordu ve "Giriş yap"
                 dugmesi gorunmez alana itiliyordu (canli denetimde bulundu). Kaydirilabilir. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" MaxWidth="340">
                <TextBlock Text="Oturum açın" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Yetkili kullanıcı bilgilerinizle devam edin." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/>
                <TextBlock Text="Kullanıcı adı" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Height="38" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                         AutomationProperties.Name="Kullanıcı adı" AutomationProperties.HelpText="YemekhanePro kullanıcı adınızı girin"/>
                <TextBlock Text="Parola" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                <!-- PasswordBox icerigini ASLA gostermez (tasarimi geregi). Ilk kurulumda
                     uretilen tek kullanimlik parola buraya dolduruluyordu ve kullanici onu
                     HIC OKUYAMIYORDU: "not alin" deniyor ama okunacak bir yer yoktu, program
                     kapaninca parola kayboluyordu. Cozum, ustune bir TextBox koyup goz
                     dugmesiyle takas etmek; ikisi ayni anda GORUNMEZ. -->
                <Grid>
                    <PasswordBox x:Name="PasswordBox" Height="38" MaxLength="256" PasswordChar="●"
                                 Padding="0,0,38,0"
                                 PasswordChanged="PasswordChanged"
                                 AutomationProperties.Name="Parola" AutomationProperties.HelpText="Parolanızı güvenli alana girin"/>
                    <TextBox x:Name="PasswordTextBox" Height="38" MaxLength="256" Visibility="Collapsed"
                             Padding="0,0,38,0"
                             TextChanged="PasswordTextChanged"
                             AutomationProperties.Name="Parola (görünür)" AutomationProperties.HelpText="Parolanız açık metin olarak gösteriliyor"/>
                    <Button x:Name="TogglePasswordButton" Width="32" Height="32" Margin="0,0,3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Content="👁" FontSize="15" Click="TogglePasswordClick"
                            ToolTip="Parolayı göster / gizle"
                            AutomationProperties.Name="Parolayı göster veya gizle"/>
                </Grid>
                <Border Style="{StaticResource InfoBanner}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentEdgeBrush}" Margin="0,14,0,0"
                        Visibility="{Binding HasSetupMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SetupMessage}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource WarningBanner}" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding VersionText, Mode=OneTime}" Foreground="{StaticResource FaintBrush}" FontSize="11"
                           HorizontalAlignment="Right" Margin="0,10,0,0"
                           AutomationProperties.Name="Uygulama sürümü"/>
                <Button Content="Giriş yap" Height="40" Margin="0,18,0,0" IsDefault="True" Click="LoginClick"
                        Style="{StaticResource Primary}"
                        AutomationProperties.Name="Giriş yap"/>
                <!-- Parolasini unutan okul, bu dugme olmadan programa HIC giremiyordu:
                     bootstrap parolasi yalnizca bos veritabaninda uretilir, yeniden
                     kurmak da kurtarmaz. Kanit olarak lisans dosyasi istenir. -->
                <Button Content="Parolamı unuttum" Height="34" Margin="0,10,0,0" Click="ForgotPasswordClick"
                        HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentHoverBrush}" Cursor="Hand"
                        AutomationProperties.Name="Parolamı unuttum"
                        AutomationProperties.HelpText="Lisans dosyanızla parolanızı sıfırlayın"/>
                <TextBlock Text="Bağlantı kurulamazsa bilgileriniz gönderilmez; yeniden deneyebilirsiniz." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="Esc: çıkış" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
