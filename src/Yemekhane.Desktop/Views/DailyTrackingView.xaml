<UserControl x:Class="Yemekhane.Desktop.Views.DailyTrackingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </ResourceDictionary>
</UserControl.Resources>

    <controls:PageShell Title="Günlük Takip" Subtitle="Bugünün geçiş akışı • Europe/Istanbul">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="Canlı bağlantı durumu"/>
                </Border>
                <CheckBox Content="Ses" IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Geçiş sesleri; varsayılan kapalıdır"/>
                <Button Style="{StaticResource Action}" Command="{Binding ToggleLiveCommand}" Content="{Binding LiveText}" AutomationProperties.Name="Canlı akışı duraklat veya sürdür"/>
                <Button Style="{StaticResource Action}" Command="{Binding RefreshCommand}" Content="Yenile" AutomationProperties.Name="Günlük takip verisini yenile"/>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.Filters>
            <WrapPanel>
                <StackPanel Width="230" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Ara" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kart, öğrenci no veya ad ara" ToolTip="Kart, öğrenci no veya ad ara"/></StackPanel>
                <StackPanel Width="105" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Karar" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Decisions}" SelectedItem="{Binding SelectedDecision}" IsEditable="False" AutomationProperties.Name="Karar filtresi"/></StackPanel>
                <StackPanel Width="145" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Öğün" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding MealTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedMealTypeId}" AutomationProperties.Name="Öğün filtresi"/></StackPanel>
                <StackPanel Width="145" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Cihaz" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDeviceId}" AutomationProperties.Name="Cihaz filtresi"/></StackPanel>
                <StackPanel Width="130" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Sınıf" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedClassId}" AutomationProperties.Name="Sınıf filtresi"/></StackPanel>
                <Button Style="{StaticResource Action}" Command="{Binding ApplyFiltersCommand}" Content="Filtrele" IsDefault="True" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </WrapPanel>
        </controls:PageShell.Filters>

        <controls:PageShell.FooterLeft>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </controls:PageShell.FooterLeft>
        <controls:PageShell.FooterRight>
            <Button Command="{Binding LoadMoreCommand}" Content="Daha eski kayıtları yükle" Style="{StaticResource Action}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"/>
        </controls:PageShell.FooterRight>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,6,0"><StackPanel><TextBlock Text="TOPLAM" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Summary.Total}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Padding="14,10" Margin="6,0"><StackPanel><TextBlock Text="ONAY • ALLOW" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding Summary.Allowed}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
                <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="14,10" Margin="6,0,0,0"><StackPanel><TextBlock Text="RED • DENY" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="{Binding Summary.Denied}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <DataGrid x:Name="AccessGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                        AutomationProperties.Name="Bugünün erişim kayıtları">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenStudentCommand}" CommandParameter="{Binding SelectedItem, ElementName=AccessGrid}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenStudentCommand}" CommandParameter="{Binding SelectedItem, ElementName=AccessGrid}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="Öğrenci ayrıntı rotası için Enter veya çift tıklama"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Saat" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="105"/>
                            <DataGridTextColumn Header="Kart No" Binding="{Binding CardNumber}" Width="115"/>
                            <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentNo}" Width="95"/>
                            <DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentName}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Sınıf" Binding="{Binding ClassName}" Width="90"/>
                            <DataGridTextColumn Header="Öğün" Binding="{Binding MealType}" Width="95"/>
                            <DataGridTemplateColumn Header="Durum" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border CornerRadius="9" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Decision}" Value="ALLOW"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✕ DENY"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Decision}" Value="ALLOW"><Setter Property="Text" Value="✓ ALLOW"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason}" Width="180"/>
                            <DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="220" Height="3"/><TextBlock Text="Kayıtlar yükleniyor..." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    <TextBlock Text="Bugün bu filtrelerle eşleşen geçiş kaydı yok." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="Günlük takip için geçerli bir oturum ve access.read izni gerekiyor." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" Visibility="{Binding LoginRequired, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </controls:PageShell>
</UserControl>
