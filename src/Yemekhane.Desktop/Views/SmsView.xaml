<UserControl x:Class="Yemekhane.Desktop.Views.SmsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    xmlns:vm="clr-namespace:Yemekhane.Desktop.ViewModels"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Bool"/>
        <!-- Ham API kodlarini (Sent, RetryScheduled...) ekranda Turkce gosterir. -->
        <converters:EnumTextConverter x:Key="EnumText"/>
            </ResourceDictionary>
</UserControl.Resources>
    <controls:PageShell Title="SMS Merkezi" Subtitle="Veli bildirimlerini önizleyin, kuyruğa alın ve teslimatı izleyin">
        <controls:PageShell.Actions>
            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Visibility="{Binding IsOffline, Converter={StaticResource Bool}}"><TextBlock Text="Çevrimdışı" Foreground="{StaticResource WarningBrush}"/></Border>
        </controls:PageShell.Actions>

        <TabControl>
            <TabItem Header="Gönder" Visibility="{Binding CanSend, Converter={StaticResource Bool}}">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
                        <TextBlock Text="1. Alıcı kapsamı" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <!-- Alanlara GORUNUR etiket eklendi. Once yalnizca ToolTip vardi: alti bos
                             kutu yan yana duruyordu ve kullanici SMS gonderme akisinin yarisini
                             tahminle dolduruyordu; yanlis veliye mesaj gitme riski vardi. -->
                        <!-- Hedef turu: ekranda Turkce ad (Name), sunucuya İngilizce kod (Value).
                             Once ComboBox ham "Manual/Class/Group" gosteriyordu. -->
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Hedef türü" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding TargetTypes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding TargetType}" AutomationProperties.Name="SMS hedef türü"/></StackPanel>
                            <StackPanel Width="220" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Öğrenci ara (no, ad, soyad)" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Öğrenci arama veya filtre"/></StackPanel>
                            <Button Content="Ara" Command="{Binding SearchStudentsCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <!-- Sinif/Grup secicileri yalnizca ilgili hedef turunde gorunur: Manuel secimde
                             iki BOS acilir kutu duruyordu. -->
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,10,8" Visibility="{Binding IsClassTarget, Converter={StaticResource Bool}}"><TextBlock Style="{StaticResource Label}" Text="Sınıf" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedClass}" ToolTip="Sınıf hedefi"/></StackPanel>
                            <StackPanel Width="220" Margin="0,0,10,8" Visibility="{Binding IsGroupTarget, Converter={StaticResource Bool}}"><TextBlock Style="{StaticResource Label}" Text="Grup" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGroup}" ToolTip="Grup hedefi"/></StackPanel>
                        </WrapPanel>
                        <!-- Ayni ad-soyadli ogrenciler yaygin oldugundan (dort ayri "ADA AKGUN")
                             SINIF/SUBE sutunlari alici secimini ayirt edici kilar; yanlis veliye
                             SMS gitmesini onler. Genislikler Auto: DataGridCell stilinde hucre
                             basina 22px yatay dolgu (DesignSystem.xaml Padding="11,0") var, sabit
                             piksel genislik bu dar alanda metni keser. -->
                        <!-- 190 -> 150: filtre alanlarina gorunur etiket eklenince form ~72px uzadi
                             ve "Alicilari ve mesaji onizle" dugmesi alt kenardan tasti. Liste
                             yine dort satir gosterir, kalani kaydirilir. -->
                        <Grid Height="150"><DataGrid ItemsSource="{Binding Students}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" AutomationProperties.Name="Manuel SMS öğrenci seçimi"><DataGrid.Columns><DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="No" Binding="{Binding StudentNo}" IsReadOnly="True" Width="Auto" MinWidth="70"/><DataGridTextColumn Header="Öğrenci" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="120"/><DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" IsReadOnly="True" Width="Auto"/><DataGridTextColumn Header="ŞUBE" Binding="{Binding SectionName}" IsReadOnly="True" Width="Auto"/></DataGrid.Columns></DataGrid><TextBlock Text="Eşleşen aktif öğrenci bulunamadı." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsSendTargetsEmpty, Converter={StaticResource Bool}}"/></Grid>
                        <!-- Secim aramadan bagimsiz tutulur; kullanici kac ogrencinin isaretli
                             oldugunu gorur ve tek tikla temizler. Once "ada" arayip isaretlenen
                             ogrenci, "ali" aramasindan sonra sessizce dusuyordu. -->
                        <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding SelectedStudentText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="Seçimi temizle" Command="{Binding ClearSelectionCommand}" Padding="8,3"/></WrapPanel>
                        <TextBlock Text="2. Mesaj" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox Content="Şablon kullan" IsChecked="{Binding UseTemplate}" Margin="0,0,0,8"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding SendTemplates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate}" AutomationProperties.Name="SMS şablonu" IsEnabled="{Binding UseTemplate}"/>
                        <TextBlock Text="Şablon değişkenleri (şablonda kullanılıyorsa doldurun)" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                        <WrapPanel>
                            <StackPanel Width="130" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Son tarih (gg.aa.yyyy)" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Şablondaki son tarih değişkeni" IsEnabled="{Binding UseTemplate}"/></StackPanel>
                            <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Giriş saati (SS:dd)" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding EntryTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Şablondaki giriş saati değişkeni" IsEnabled="{Binding UseTemplate}"/></StackPanel>
                            <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Tutar (₺)" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Şablondaki tutar değişkeni" IsEnabled="{Binding UseTemplate}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Mesaj metni (şablon kullanılmıyorsa)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="95" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Özel SMS mesajı"/>
                        <Grid><TextBlock Text="{Binding EncodingHint}" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Left"/><TextBlock Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"><Run Text="{Binding CharacterCount, Mode=OneWay}"/><Run Text=" karakter • "/><Run Text="{Binding SegmentCount, Mode=OneWay}"/><Run Text=" SMS segmenti"/></TextBlock></Grid>
                        <WrapPanel Margin="0,12,0,0"><Button Content="Alıcıları ve mesajı önizle" Command="{Binding PreviewCommand}" Style="{StaticResource Primary}"/><ProgressBar IsIndeterminate="True" Width="120" Height="3" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsSendLoading, Converter={StaticResource Bool}}"/></WrapPanel>
                        <TextBlock Text="{Binding SendError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Gönderim önizlemesi" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Önizleme oluşturmadan hiçbir SMS kuyruğa alınmaz." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/>
                            <!-- Hata bandi burada da gosterilir: sol sutundaki hata metni 900px
                                 yukseklikte ekranin altinda, kaydirmadan gorunmuyordu (ekran
                                 goruntusunde dogrulandi). Sag panel her zaman gorunur. -->
                            <Border Style="{StaticResource DangerBanner}" Margin="0,0,0,12" Visibility="{Binding HasSendError, Converter={StaticResource Bool}}"><TextBlock Text="{Binding SendError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/></Border>
                            <Grid Visibility="{Binding HasPreview, Converter={StaticResource Bool}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <UniformGrid Columns="4"><StackPanel><TextBlock Text="EŞLEŞEN" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Preview.MatchedStudents}" FontSize="22"/></StackPanel><StackPanel><TextBlock Text="ALICI" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Preview.RecipientCount}" FontSize="22" Foreground="{StaticResource AccentBrush}"/></StackPanel><StackPanel><TextBlock Text="TELEFON YOK" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Preview.NoPhoneCount}" FontSize="22" Foreground="{StaticResource DangerBrush}"/></StackPanel><StackPanel><TextBlock Text="MÜKERRER" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Preview.DuplicatePhoneCount}" FontSize="22" Foreground="{StaticResource WarningBrush}"/></StackPanel></UniformGrid>
                                <TextBlock Grid.Row="1" Text="Telefonu olmayan veya aynı telefonu paylaşan öğrencilere SMS gitmez; alıcı sayısı bu yüzden eşleşenden az olabilir." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <StackPanel Grid.Row="2" Margin="0,14,0,10"><TextBlock Text="Örnek mesajlar (ilk 5 alıcı)" FontWeight="SemiBold" Margin="0,0,0,4"/><ItemsControl ItemsSource="{Binding Preview.Examples}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8"><StackPanel><TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ParentName, StringFormat=Veli: {0}}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Phone}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                <StackPanel Grid.Row="3"><CheckBox IsChecked="{Binding IsConfirmed}" Margin="0,5,0,10"><TextBlock Text="Alıcı sayısını ve örnek mesajları kontrol ettim; kuyruğa alınmasını onaylıyorum." TextWrapping="Wrap"/></CheckBox><Button Content="SMS'leri kuyruğa al" Command="{Binding EnqueueCommand}" HorizontalAlignment="Left" Style="{StaticResource Primary}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding EnqueueResultText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Şablonlar" Visibility="{Binding CanManage, Converter={StaticResource Bool}}">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <!-- Liste salt okunur: SmsTemplateDetails degismez bir kayittir, hucre icinde
                         yazilan metin hicbir yere gitmiyordu. Duzenleme sag paneldedir. -->
                    <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><CheckBox Content="Pasifleri göster" IsChecked="{Binding IncludeInactive}" Margin="0,0,12,0" VerticalAlignment="Center"/><Button Content="Yenile" Command="{Binding RefreshTemplatesCommand}"/><Button Content="Yeni şablon" Command="{Binding NewTemplateCommand}"/><Button Content="Seçileni düzenle" Command="{Binding EditTemplateCommand}"/><TextBlock Text="Çift tıklayarak da düzenleyebilirsiniz." Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/></WrapPanel><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplateRow}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="Auto" MinWidth="140"/><DataGridTextColumn Header="Metin" Binding="{Binding Body}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Body}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="Auto" MinWidth="60"/></DataGrid.Columns><DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditTemplateCommand}"/></DataGrid.InputBindings></DataGrid><TextBlock Text="Henüz SMS şablonu yok. Sağdaki düzenleyiciden ilk şablonu oluşturun." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsTemplatesEmpty, Converter={StaticResource Bool}}"/><ProgressBar IsIndeterminate="True" Width="160" Height="3" VerticalAlignment="Center" Visibility="{Binding IsTemplatesLoading, Converter={StaticResource Bool}}"/></Grid></Grid>
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="{Binding TemplateEditorTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Ad" Style="{StaticResource Label}" Margin="0,12,0,4"/><TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Metin" Style="{StaticResource Label}" Margin="0,10,0,4"/><TextBox Text="{Binding TemplateBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto"/>
                        <!-- Degiskenler İngilizce jetonlardir ({{StudentName}}); kullaniciya Turkce
                             adiyla dugme olarak sunulur, tiklayinca metne jeton eklenir. Once
                             yalnizca ham jeton listesi yaziyordu ve ne anlama geldigi belirsizdi. -->
                        <TextBlock Text="Değişken ekle (gönderimde gerçek değerle değiştirilir):" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{x:Static vm:SmsViewModel.TemplateVariables}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" ToolTip="{Binding Token}" Command="{Binding DataContext.InsertVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Token}" Padding="8,3" Margin="0,0,6,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Örnek: Sayın {{ParentName}}, {{StudentName}} için son ödeme tarihi {{ExpiryDate}}." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <WrapPanel><Button Content="Kaydet" Command="{Binding SaveTemplateCommand}" Style="{StaticResource Primary}"/><Button Content="Pasifleştir" Command="{Binding DeactivateTemplateCommand}" Margin="8,0,0,0"/></WrapPanel>
                        <TextBlock Text="{Binding TemplateError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Geçmiş" Visibility="{Binding CanRead, Converter={StaticResource Bool}}">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- Filtre alanlarina gorunur etiket eklendi: dort kutunun (ogrenci, telefon,
                         saglayici, durum) hicbirinde etiket yoktu, yalnizca ToolTip vardi. -->
                    <WrapPanel>
                        <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Başlangıç" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding HistoryFrom}"/></StackPanel>
                        <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Bitiş" Margin="0,0,0,4"/><DatePicker Style="{StaticResource FieldCompactDate}" SelectedDate="{Binding HistoryTo}"/></StackPanel>
                        <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Öğrenci" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding HistoryStudent}" ToolTip="Öğrenci adı veya no"/></StackPanel>
                        <StackPanel Width="130" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Telefon" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding HistoryPhone}" ToolTip="Telefon"/></StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Sağlayıcı" Margin="0,0,0,4"/><TextBox Style="{StaticResource FieldCompact}" Text="{Binding HistoryProvider}" ToolTip="SMS sağlayıcısı"/></StackPanel>
                        <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Durum" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding HistoryStatuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding HistoryStatus}"/></StackPanel>
                        <!-- Kaynak: elle / toplu / otomatik kural. Otomatik SMS'ler (hak uyarisi, gelir, kart)
                             ayni kuyruga duser; operator hangisinin kural urunu oldugunu buradan ayirir. -->
                        <StackPanel Width="190" Margin="0,0,10,8"><TextBlock Style="{StaticResource Label}" Text="Kaynak" Margin="0,0,0,4"/><ComboBox Style="{StaticResource FieldCompactCombo}" ItemsSource="{Binding HistorySources}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding HistorySource}" AutomationProperties.Name="SMS kaynak filtresi"/></StackPanel>
                        <Button Content="Filtrele / Yenile" Command="{Binding RefreshHistoryCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto" MinWidth="120"/><DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="Auto" MinWidth="110"/><DataGridTextColumn Header="Sağlayıcı" Binding="{Binding Provider}" Width="Auto" MinWidth="80"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source, Converter={StaticResource EnumText}, ConverterParameter=SmsSource}" Width="Auto" MinWidth="90"/><DataGridTemplateColumn Header="Durum" Width="Auto" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="9" Padding="7,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SunkenBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Sent"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="RetryScheduled"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Sending"><Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=SmsStatus}" HorizontalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Hata" Binding="{Binding Error}" Width="Auto" MinWidth="80" MaxWidth="260"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Error}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Deneme" Binding="{Binding AttemptCount}" Width="Auto" MinWidth="80"/><DataGridTemplateColumn Header="İşlem" Width="Auto" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><!-- Yalnizca basarisiz kayitta gorunur; digerlerinde pasif bir dugme kafa karistiriyordu. --><Button Content="Tekrar dene" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="Bu filtrelerle SMS kaydı bulunamadı." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsHistoryEmpty, Converter={StaticResource Bool}}"/><ProgressBar IsIndeterminate="True" Width="180" Height="3" VerticalAlignment="Center" Visibility="{Binding IsHistoryLoading, Converter={StaticResource Bool}}"/></Grid>
                    <Grid Grid.Row="2" Margin="0,9,0,0"><TextBlock Text="{Binding HistoryError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Önceki" Command="{Binding PreviousHistoryPageCommand}"/><TextBlock Text="{Binding HistoryPageText}" VerticalAlignment="Center" Margin="4,0,12,0"/><Button Content="Sonraki" Command="{Binding NextHistoryPageCommand}"/></StackPanel></Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </controls:PageShell>
</UserControl>
