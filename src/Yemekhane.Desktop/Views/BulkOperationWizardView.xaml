<UserControl x:Class="Yemekhane.Desktop.Views.BulkOperationWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:Yemekhane.Desktop"
             xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
             xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
    FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Bool"/>
            <!-- API kodlari (CancelEntitlements, Delete, Completed...) ekranda Turkce gorunur;
                 ViewModel'deki degerler sunucu sozlesmesi oldugu icin ham kalir. -->
            <converters:EnumTextConverter x:Key="EnumText"/>
            <DataTemplate x:Key="OperationItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}, ConverterParameter=BulkOperation}"/></DataTemplate>
            <DataTemplate x:Key="BehaviorItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}, ConverterParameter=TransferBehavior}"/></DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource Bool}}">
        <Border Background="{StaticResource ScrimStrongBrush}" controls:WindowScrim.Extend="True"/>
        <Border Width="640" MaxHeight="740" Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="Toplu Takvim İşlemi" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding StepTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="Kapat" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Bool}}"><TextBlock Text="1. İşlem türü" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Uygulanacak takvim operasyonunu seçin." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" ItemTemplate="{StaticResource OperationItem}" Height="32" AutomationProperties.Name="İşlem türü"/><TextBlock Text="Açıklama" Margin="0,12,0,4"/><TextBox Text="{Binding Description}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Açıklama"/></StackPanel>
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Bool}}"><TextBlock Text="2. Kapsam" FontWeight="SemiBold" FontSize="16"/><ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScope}" Margin="0,12,0,0" Height="32" AutomationProperties.Name="Kapsam"/><StackPanel Visibility="{Binding IsManualScope, Converter={StaticResource Bool}}"><TextBlock Text="Öğrenci numaraları" Margin="0,12,0,4"/><TextBox Text="{Binding ManualStudentIds, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Öğrenci numaraları" ToolTip="Öğrenci numaralarını virgülle ayırarak girin (örn. 5012, 5013)."/><TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Virgülle ayırarak öğrenci numarası girin (örn. 5012, 5013). Hakedişler listesinden satır seçerek açtıysanız seçili öğrenciler hazır gelir."/></StackPanel></StackPanel>
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Bool}}"><TextBlock Text="3. Tarihler ve öğün" FontWeight="SemiBold" FontSize="16"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><StackPanel Width="170"><TextBlock Text="Başlangıç" Style="{StaticResource Label}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding StartsOn}"/></StackPanel><StackPanel Width="170" Margin="10,0,0,0"><TextBlock Text="Bitiş" Style="{StaticResource Label}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding EndsOn}"/></StackPanel></StackPanel><TextBlock Text="Ek tarih listesi (yyyy-AA-gg, isteğe bağlı)" Margin="0,12,0,4"/><TextBox Text="{Binding ExplicitDates}" AutomationProperties.Name="Ek tarih listesi"/><TextBlock Text="Öğün" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding MealFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMealFilter}" AutomationProperties.Name="Öğün"/></StackPanel>
                    <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource Bool}}"><TextBlock Text="4. Hak davranışı" FontWeight="SemiBold" FontSize="16"/><ComboBox ItemsSource="{Binding TransferBehaviors}" SelectedItem="{Binding TransferBehavior}" ItemTemplate="{StaticResource BehaviorItem}" Margin="0,12,0,0" AutomationProperties.Name="Hak davranışı"/><StackPanel Visibility="{Binding IsSpecifiedDate, Converter={StaticResource Bool}}"><TextBlock Text="Hedef tarih" Margin="0,12,0,4"/><DatePicker SelectedDate="{Binding TargetDate}"/></StackPanel></StackPanel>
                    <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource Bool}}"><TextBlock Text="5. Kesin önizleme" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Preview.StudentCount, StringFormat={}{0:N0} öğrenci}" Margin="0,12,0,2"/><TextBlock Text="{Binding Preview.EntitlementCount, StringFormat={}{0:N0} hak kaydı}"/><TextBlock Text="{Binding Preview.Quantity, StringFormat={}{0:N0} kullanılabilir hak}"/><TextBlock Text="{Binding Preview.CancelledCount, StringFormat={}{0:N0} iptal}"/><TextBlock Text="{Binding Preview.TransferredCount, StringFormat={}{0:N0} aktarım}"/>
                        <!-- Ogrenci GUID ile degil no + ad + sinif ile gosterilir; ayni adli ogrenciler
                             ancak boyle ayirt edilir. Tarih sutunlari Auto: sabit 90px'te hucre dolgusu
                             yuzunden "09.09.2026" kesiliyordu. -->
                        <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview.Entitlements}" AutoGenerateColumns="False" IsReadOnly="True" Height="200" Margin="0,10,0,0" HeadersVisibility="Column" AutomationProperties.Name="Etkilenecek haklar"><DataGrid.Columns><DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="Auto" MinWidth="60"/><DataGridTextColumn Header="AD SOYAD" Binding="{Binding StudentName}" Width="*" MinWidth="120"/><DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="Auto" MinWidth="58"/><DataGridTextColumn Header="TARİH" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto" MinWidth="95"/><DataGridTextColumn Header="ADET" Binding="{Binding AffectedQuantity}" Width="Auto" MinWidth="58"/><DataGridTextColumn Header="HEDEF" Binding="{Binding TargetDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto" MinWidth="95"/></DataGrid.Columns></DataGrid><ItemsControl ItemsSource="{Binding Preview.Warnings}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource Bool}}"><TextBlock Text="6. Onay" FontWeight="SemiBold" FontSize="16"/><Border Background="{StaticResource WarningSoftBrush}" Padding="16" Margin="0,12,0,0"><TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" FontSize="15"/></Border></StackPanel>
                    <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource Bool}}"><TextBlock Text="7. Sonuç" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Bu işlem Geçmiş penceresinden geri alınabilir." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" Opacity="0.97" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="240" Height="4" IsIndeterminate="True"/><TextBlock Text="Toplu işlem yürütülüyor..." Margin="0,10,0,0"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="2"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="350" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Geçmiş" Command="{Binding OpenHistoryCommand}" Visibility="{Binding CanHistory, Converter={StaticResource Bool}}"/><Button Content="Geri" Command="{Binding BackCommand}"/><Button Content="İleri" Command="{Binding NextCommand}" Visibility="{Binding IsStep6, Converter={x:Static desktop:InverseBooleanToVisibilityConverter.Instance}}" IsDefault="True"/><Button Style="{StaticResource Primary}" Content="Onayla ve Uygula" Command="{Binding ApplyCommand}" Visibility="{Binding IsStep6, Converter={StaticResource Bool}}" IsDefault="True" Margin="7,0,0,0"/></StackPanel></Grid>
            </Grid>
        </Border>
        <Border Width="760" MaxHeight="580" Background="White" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsHistoryOpen, Converter={StaticResource Bool}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Toplu İşlem Geçmişi" FontSize="19" FontWeight="SemiBold"/><Button Content="Kapat" Command="{Binding CloseHistoryCommand}" HorizontalAlignment="Right"/></Grid>
                <!-- Islem ve Durum sutunlari Turkce (BulkOperation / Status sozlukleri); "Reverted"
                     ya da "CancelEntitlements" kullaniciya bir sey soylemiyordu. -->
                <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" HeadersVisibility="Column" AutomationProperties.Name="Toplu işlem geçmişi"><DataGrid.Columns><DataGridTextColumn Header="TARİH" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto" MinWidth="130"/><DataGridTextColumn Header="İŞLEM" Binding="{Binding Operation, Converter={StaticResource EnumText}, ConverterParameter=BulkOperation}" Width="*" MinWidth="140"/><DataGridTextColumn Header="ÖĞRENCİ" Binding="{Binding StudentCount}" Width="Auto" MinWidth="80"/><DataGridTextColumn Header="HAK" Binding="{Binding Quantity}" Width="Auto" MinWidth="60"/><DataGridTextColumn Header="DURUM" Binding="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=Status}" Width="Auto" MinWidth="100"/><!-- Sabit genislik: Auto olcumu yildiz sutundan sonra geldigi icin "Geri Al" dugmesi pencere kenarinda kesiliyordu. --><DataGridTemplateColumn Header="" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Geri Al" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" Padding="8,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                <!-- Geri alma sonucu/hatasi burada gosterilir; onceden yalnizca 7. adimda
                     goruntulendigi icin Gecmis penceresinden "Geri Al" diyen kullanici
                     hicbir geri bildirim almiyordu. -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="{Binding HasResult, Converter={StaticResource Bool}}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Bool}}"/><TextBlock Text="Geçmişte kayıt yok." Style="{StaticResource Caption}" Visibility="{Binding History.Count, Converter={x:Static desktop:SelectionCountToVisibilityConverter.Instance}, ConverterParameter=Invert}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
