<UserControl x:Class="Yemekhane.Desktop.Views.BulkOperationWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Bool"/><Style x:Key="Button" TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style></UserControl.Resources>
    <Grid Background="#CC17202A" Visibility="{Binding IsOpen, Converter={StaticResource Bool}}">
        <Border Width="620" MaxHeight="720" Background="White" BorderBrush="#CBD2D8" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="Toplu Takvim İşlemi" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding StepTitle}" Foreground="#65717E" Margin="0,3,0,0"/></StackPanel><Button Content="Kapat" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Style="{StaticResource Button}"/></Grid>
                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Bool}}"><TextBlock Text="1. İşlem türü" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Uygulanacak takvim operasyonunu seçin." Foreground="#65717E" Margin="0,4,0,12"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" Height="32"/><TextBlock Text="Açıklama" Margin="0,12,0,4"/><TextBox Text="{Binding Description}" Height="55" AcceptsReturn="True"/></StackPanel>
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Bool}}"><TextBlock Text="2. Kapsam" FontWeight="SemiBold" FontSize="16"/><ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScope}" Margin="0,12,0,0" Height="32"/><StackPanel Visibility="{Binding IsManualScope, Converter={StaticResource Bool}}"><TextBlock Text="Öğrenci kimlikleri" Margin="0,12,0,4"/><TextBox Text="{Binding ManualStudentIds}" Height="80" AcceptsReturn="True"/></StackPanel></StackPanel>
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Bool}}"><TextBlock Text="3. Tarihler ve öğün" FontWeight="SemiBold" FontSize="16"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><DatePicker SelectedDate="{Binding StartsOn}" Width="170"/><DatePicker SelectedDate="{Binding EndsOn}" Width="170" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Ek tarih listesi (yyyy-AA-gg)" Margin="0,12,0,4"/><TextBox Text="{Binding ExplicitDates}"/><TextBlock Text="Öğün (boşsa tümü)" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding MealTypes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMealType}"/></StackPanel>
                    <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource Bool}}"><TextBlock Text="4. Hak davranışı" FontWeight="SemiBold" FontSize="16"/><ComboBox ItemsSource="{Binding TransferBehaviors}" SelectedItem="{Binding TransferBehavior}" Margin="0,12,0,0"/><StackPanel Visibility="{Binding IsSpecifiedDate, Converter={StaticResource Bool}}"><TextBlock Text="Hedef tarih" Margin="0,12,0,4"/><DatePicker SelectedDate="{Binding TargetDate}"/></StackPanel></StackPanel>
                    <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource Bool}}"><TextBlock Text="5. Kesin önizleme" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Preview.StudentCount, StringFormat={}{0:N0} öğrenci}" Margin="0,12,0,2"/><TextBlock Text="{Binding Preview.EntitlementCount, StringFormat={}{0:N0} hak kaydı}"/><TextBlock Text="{Binding Preview.Quantity, StringFormat={}{0:N0} kullanılabilir hak}"/><TextBlock Text="{Binding Preview.CancelledCount, StringFormat={}{0:N0} iptal}"/><TextBlock Text="{Binding Preview.TransferredCount, StringFormat={}{0:N0} aktarım}"/><DataGrid ItemsSource="{Binding Preview.Entitlements}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentId}" Width="*"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/><DataGridTextColumn Header="Adet" Binding="{Binding AffectedQuantity}" Width="55"/><DataGridTextColumn Header="Hedef" Binding="{Binding TargetDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/></DataGrid.Columns></DataGrid><ItemsControl ItemsSource="{Binding Preview.Warnings}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#9C5A2F" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource Bool}}"><TextBlock Text="6. Onay" FontWeight="SemiBold" FontSize="16"/><Border Background="#FFF5E8" Padding="16" Margin="0,12,0,0"><TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" FontSize="15"/></Border></StackPanel>
                    <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource Bool}}"><TextBlock Text="7. Sonuç" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#156B63"/></StackPanel>
                    <Border Background="#EFFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="240" Height="4" IsIndeterminate="True"/><TextBlock Text="Toplu işlem yürütülüyor..." Margin="0,10,0,0"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="2"><TextBlock Text="{Binding ErrorMessage}" Foreground="#A1322D" TextWrapping="Wrap" MaxWidth="350" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Geçmiş" Command="{Binding OpenHistoryCommand}" Visibility="{Binding CanHistory, Converter={StaticResource Bool}}" Style="{StaticResource Button}"/><Button Content="Geri" Command="{Binding BackCommand}" Style="{StaticResource Button}"/><Button Content="İleri" Command="{Binding NextCommand}" Style="{StaticResource Button}" IsDefault="True"/><Button Content="Onayla ve Uygula" Command="{Binding ApplyCommand}" Visibility="{Binding IsStep6, Converter={StaticResource Bool}}" Style="{StaticResource Button}" Background="#DDEFEA" IsDefault="True"/></StackPanel></Grid>
            </Grid>
        </Border>
        <Border Width="700" MaxHeight="560" Background="White" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsHistoryOpen, Converter={StaticResource Bool}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Toplu İşlem Geçmişi" FontSize="19" FontWeight="SemiBold"/><Button Content="Kapat" Command="{Binding CloseHistoryCommand}" HorizontalAlignment="Right" Style="{StaticResource Button}"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/><DataGridTextColumn Header="İşlem" Binding="{Binding Operation}" Width="*"/><DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentCount}" Width="75"/><DataGridTextColumn Header="Hak" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="90"/><DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Geri Al" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" Padding="8,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
        </Border>
    </Grid>
</UserControl>
