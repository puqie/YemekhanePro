<UserControl x:Class="Yemekhane.Desktop.Views.StudentImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="clr-namespace:Yemekhane.Desktop"
    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls"
    FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:PageShell Title="Sicil Aktar" Subtitle="Excel veya CSV dosyasından öğrenci ve kart kayıtlarını içe aktarın">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="İşleniyor…" Foreground="{StaticResource WarningBrush}"/>
                </Border>
                <Button Style="{StaticResource Action}" Content="Baştan Başla" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.FooterLeft>
            <StackPanel>
                <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                        Margin="0,0,0,6" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </controls:PageShell.FooterLeft>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Yetki uyarisi -->
        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6"
                Padding="12">
            <Border.Visibility>
                <Binding Path="CanImport" Converter="{x:Static desktop:InverseBooleanToVisibilityConverter.Instance}"/>
            </Border.Visibility>
            <TextBlock Text="Bu ekranı kullanmak için öğrenci yazma yetkisi gereklidir." Foreground="{StaticResource WarningBrush}"/>
        </Border>

        <!-- 1. adim: dosya secimi -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,14,0,10">
            <StackPanel>
                <TextBlock Text="1 · Dosya seçin" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Action}" Content="Dosya Seç…" Command="{Binding ChooseFileCommand}"/>
                    <TextBlock Text="{Binding FileName, TargetNullValue='Henüz dosya seçilmedi'}"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="4,0,14,0"/>
                    <Button Style="{StaticResource Action}" Content="Önizle" Command="{Binding PreviewCommand}"
                            IsDefault="True"/>
                </StackPanel>
                <TextBlock Text="Desteklenen biçimler: .xlsx ve .csv · En fazla 10 MB"
                           Foreground="{StaticResource FaintBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. adim: ozet -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,0,0,10"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="2 · Uygulamadan önce kontrol edin" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                           Margin="0,0,0,10"/>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Okunan satır"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource SuccessBrush}"
                                   Text="{Binding NewCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Yeni kayıt"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource InfoBrush}"
                                   Text="{Binding UpdateCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Güncellenecek"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Foreground="{StaticResource DangerBrush}"
                                   Text="{Binding ErrorCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Hatalı satır"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Content="Hatalı satırları atla, geçerli olanları aktar"
                              IsChecked="{Binding ApplyValidRows}" VerticalAlignment="Center" Margin="0,0,14,0"
                              Visibility="{Binding HasErrorRows, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource Action}" Content="Hata Raporunu İndir"
                            Command="{Binding DownloadErrorsCommand}"
                            Visibility="{Binding HasErrorRows, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource Action}" Content="İçe Aktar" Command="{Binding ApplyCommand}"
                            Background="{StaticResource InfoBrush}" Foreground="White" BorderBrush="{StaticResource InfoBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Satirlar -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" CanUserSortColumns="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Satır" Binding="{Binding RowNumber}" Width="60"/>
                        <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="110"/>
                        <DataGridTextColumn Header="Kart No" Binding="{Binding CardNumber}" Width="130"/>
                        <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="140"/>
                        <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="140"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110"/>
                        <DataGridTemplateColumn Header="Açıklama" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Errors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bos durum: baglama duyarli mesaj -->
                <TextBlock Text="Önizlemek için bir dosya seçin." Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPreview, Converter={x:Static desktop:InverseBooleanToVisibilityConverter.Instance}}"/>
                <TextBlock Text="Dosyada aktarılacak satır bulunamadı." Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
        </Grid>
    </controls:PageShell>
</UserControl>
