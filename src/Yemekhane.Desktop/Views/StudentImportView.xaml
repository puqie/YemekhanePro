<UserControl x:Class="Yemekhane.Desktop.Views.StudentImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="clr-namespace:Yemekhane.Desktop"
    Background="#F4F5F7" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style x:Key="Action" TargetType="Button">
                <Setter Property="Padding" Value="11,6"/><Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DDE2"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="Metric" TargetType="TextBlock">
                <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#18222D"/>
            </Style>
            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#65717E"/><Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Baslik -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Sicil Aktar" FontSize="22" FontWeight="SemiBold" Foreground="#18222D"/>
                <TextBlock Text="Excel veya CSV dosyasından öğrenci ve kart kayıtlarını içe aktarın"
                           Foreground="#65717E" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FFF3E5" CornerRadius="12" Padding="9,4" Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="İşleniyor…" Foreground="#8A681D"/>
                </Border>
                <Button Style="{StaticResource Action}" Content="Baştan Başla" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Yetki uyarisi -->
        <Border Grid.Row="1" Background="#FFF3E5" BorderBrush="#F0D9AE" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,14,0,0">
            <Border.Visibility>
                <Binding Path="CanImport" Converter="{x:Static desktop:InverseBooleanToVisibilityConverter.Instance}"/>
            </Border.Visibility>
            <TextBlock Text="Bu ekranı kullanmak için öğrenci yazma yetkisi gereklidir." Foreground="#8A681D"/>
        </Border>

        <!-- 1. adim: dosya secimi -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,14,0,10">
            <StackPanel>
                <TextBlock Text="1 · Dosya seçin" FontWeight="SemiBold" Foreground="#18222D" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Action}" Content="Dosya Seç…" Command="{Binding ChooseFileCommand}"/>
                    <TextBlock Text="{Binding FileName, TargetNullValue='Henüz dosya seçilmedi'}"
                               VerticalAlignment="Center" Foreground="#65717E" Margin="4,0,14,0"/>
                    <Button Style="{StaticResource Action}" Content="Önizle" Command="{Binding PreviewCommand}"
                            IsDefault="True"/>
                </StackPanel>
                <TextBlock Text="Desteklenen biçimler: .xlsx ve .csv · En fazla 10 MB"
                           Foreground="#96A1AC" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. adim: ozet -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,0,0,10"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="2 · Uygulamadan önce kontrol edin" FontWeight="SemiBold" Foreground="#18222D"
                           Margin="0,0,0,10"/>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding TotalCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Okunan satır"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Metric}" Foreground="#1F7A4D"
                                   Text="{Binding NewCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Yeni kayıt"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Metric}" Foreground="#1D5FA8"
                                   Text="{Binding UpdateCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Güncellenecek"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Metric}" Foreground="#B3261E"
                                   Text="{Binding ErrorCount, StringFormat={}{0:N0}}"/>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="Hatalı satır"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Content="Hatalı satırları atla, geçerli olanları aktar"
                              IsChecked="{Binding ApplyValidRows}" VerticalAlignment="Center" Margin="0,0,14,0"
                              Visibility="{Binding HasErrorRows, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource Action}" Content="Hata Raporunu İndir"
                            Command="{Binding DownloadErrorsCommand}"
                            Visibility="{Binding HasErrorRows, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource Action}" Content="İçe Aktar" Command="{Binding ApplyCommand}"
                            Background="#1D5FA8" Foreground="White" BorderBrush="#1D5FA8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Satirlar -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                          HorizontalGridLinesBrush="#EEF1F4" BorderThickness="0" CanUserSortColumns="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" AlternatingRowBackground="#FAFBFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Satır" Binding="{Binding RowNumber}" Width="60"/>
                        <DataGridTextColumn Header="NO" Binding="{Binding StudentNo}" Width="110"/>
                        <DataGridTextColumn Header="Kart No" Binding="{Binding CardNumber}" Width="130"/>
                        <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="140"/>
                        <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="140"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110"/>
                        <DataGridTemplateColumn Header="Açıklama" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Errors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" Foreground="#B3261E"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bos durum: baglama duyarli mesaj -->
                <TextBlock Text="Önizlemek için bir dosya seçin." Foreground="#96A1AC"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPreview, Converter={x:Static desktop:InverseBooleanToVisibilityConverter.Instance}}"/>
                <TextBlock Text="Dosyada aktarılacak satır bulunamadı." Foreground="#96A1AC"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Durum ve hata -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <Border Background="#FDECEA" BorderBrush="#F5C6C2" BorderThickness="1" CornerRadius="6" Padding="10"
                    Margin="0,0,0,6" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B3261E" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1F7A4D" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
