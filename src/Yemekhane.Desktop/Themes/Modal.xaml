<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls">

    <!-- Drawer.xaml ile ayni gerekce: Source= ile yuklenen sozlugun StaticResource aramalari
         yalnizca kendi birlestirdigi sozlukleri gorur; DesignSystem burada da birlestirilir. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignSystem.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Ortalanmis engelleyici diyalog. Karartma ScrimStrongBrush (~%80) ve pencere geneline
         yayilir (WindowScrim.Extend): once cihaz duzenleyicisi yalnizca sayfayi karartiyor,
         log paneli hic karartmiyordu. Sabit MaxHeight YOK: kart, sayfanin verdigi yukseklige
         siginir ve icerik kaydirilir; 640 px'lik ekranda 760 px'lik sabit sinir tasiyordu. -->
    <Style TargetType="{x:Type controls:Modal}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Modal}">
                    <Grid>
                        <Border x:Name="PART_Scrim" Background="{StaticResource ScrimStrongBrush}"
                                controls:WindowScrim.Extend="True"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="22" Margin="24"
                                Width="{TemplateBinding ModalWidth}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                KeyboardNavigation.TabNavigation="Cycle">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,84,0">
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="PART_Subtitle" Text="{TemplateBinding Subtitle}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PART_Close" Content="Kapat"
                                            Style="{StaticResource Action}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            AutomationProperties.Name="Pencereyi kapat"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ContentPresenter/>
                                </ScrollViewer>
                                <ContentPresenter x:Name="PART_Footer" Grid.Row="2"
                                                  Content="{TemplateBinding Footer}" Margin="0,18,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CanClose" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Uc standart olcu: dar onay/mesaj, orta form, genis sihirbaz/liste. -->
    <Style x:Key="ModalNarrow" TargetType="{x:Type controls:Modal}" BasedOn="{StaticResource {x:Type controls:Modal}}">
        <Setter Property="ModalWidth" Value="440"/>
    </Style>
    <Style x:Key="ModalMedium" TargetType="{x:Type controls:Modal}" BasedOn="{StaticResource {x:Type controls:Modal}}">
        <Setter Property="ModalWidth" Value="520"/>
    </Style>
    <Style x:Key="ModalWide" TargetType="{x:Type controls:Modal}" BasedOn="{StaticResource {x:Type controls:Modal}}">
        <Setter Property="ModalWidth" Value="680"/>
    </Style>
</ResourceDictionary>
