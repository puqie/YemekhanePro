<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Yemekhane.Desktop">

    <!-- ============================================================
         RENK PALETI  (logo: lacivert #0B131C..#2F3B49, turuncu #E71500..#FF880F)
         Metinde kullanilan turuncu koyulastirildi: logonun parlak turuncusu
         beyaz zeminde 3.36:1 kontrast verir, WCAG AA esigi 4.5:1'dir.
         ============================================================ -->
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CanvasBrush"       Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SunkenBrush"       Color="#EDEFF2"/>
    <SolidColorBrush x:Key="InkBrush"          Color="#18212A"/>
    <SolidColorBrush x:Key="MutedBrush"        Color="#5D6975"/>
    <SolidColorBrush x:Key="FaintBrush"        Color="#8A96A0"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#D8DEE3"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#BCC5CD"/>

    <SolidColorBrush x:Key="AccentBrush"       Color="#C33A02"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#A33002"/>
    <SolidColorBrush x:Key="AccentPressBrush"  Color="#8A2802"/>
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#FDEDE3"/>
    <SolidColorBrush x:Key="AccentEdgeBrush"   Color="#F0A874"/>

    <SolidColorBrush x:Key="NavyBrush"         Color="#18222D"/>
    <SolidColorBrush x:Key="NavyDeepBrush"     Color="#0B131C"/>
    <SolidColorBrush x:Key="NavyLiftBrush"     Color="#2F3B49"/>

    <SolidColorBrush x:Key="SuccessBrush"      Color="#176B4D"/>
    <SolidColorBrush x:Key="SuccessSoftBrush"  Color="#EAF5F0"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="#9C342F"/>
    <SolidColorBrush x:Key="DangerSoftBrush"   Color="#FCEEEC"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="#7C5B16"/>
    <SolidColorBrush x:Key="WarningSoftBrush"  Color="#FDF3E3"/>
    <SolidColorBrush x:Key="InfoBrush"         Color="#285F8F"/>
    <SolidColorBrush x:Key="InfoSoftBrush"     Color="#EBF2F9"/>

    <!-- Secim/uzerine gelme: marka turuncusunun cok acik tonlari.
         Onceden teal kalmisti ve logoyla celisiyordu. -->
    <SolidColorBrush x:Key="HoverBrush"        Color="#F7F0EB"/>
    <SolidColorBrush x:Key="SelectionBrush"    Color="#FBE3D4"/>

    <!-- ============================================================
         OLCU SISTEMI  Tum bosluklar 4'un katidir; goz hizalamayi boyle yakalar.
         ============================================================ -->
    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">19</sys:Double>
    <sys:Double x:Key="Font2Xl">25</sys:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="Radius">6</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>

    <!-- ============================================================
         TIPOGRAFI
         ============================================================ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font2Xl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontLg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSm}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontXs}"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontXs}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font2Xl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ============================================================
         YUZEYLER
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Bildirim serifleri: anlamsal renk + yumusak zemin -->
    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#B9CFE4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#E6C48F"/>
    </Style>
    <Style x:Key="DangerBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#E4B3AE"/>
    </Style>
    <Style x:Key="SuccessBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#A9CFBE"/>
    </Style>

    <!-- ============================================================
         ODAK  Klavyeyle gezinen kullanici nerede oldugunu gormeli.
         ============================================================ -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                            CornerRadius="4" Margin="-3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BUTONLAR
         ============================================================ -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Birincil eylem: sayfada YALNIZCA BIR tane olmali. -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <!-- Yikici eylem gorsel olarak ayrilmali: yanlislikla basilmamali. -->
    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="#E4B3AE"/>
    </Style>

    <!-- ============================================================
         GIRIS ALANLARI
         ============================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentEdgeBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SunkenBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Formlarda alanlarin dar kalmamasi icin: 90px'lik kutular okunmuyordu. -->
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="260"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="260"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <!-- ============================================================
         SEKMELER  Stillenmezse Windows'un varsayilan (95 gorunumlu) temasi cikar.
         ============================================================ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,14,0,0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" Padding="15,9"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2.5" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         ILERLEME  Varsayilan WPF ProgressBar YESILDIR; marka disiydi.
         ============================================================ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource SunkenBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============================================================
         TABLO
         ============================================================ -->
    <Style TargetType="DataGrid">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EAEEF1"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="AlternatingRowBackground" Value="#FBFCFD"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontXs}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         LISTELER
         ============================================================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontMd}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RadiusSm}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         KAYDIRMA CUBUGU  Varsayilan gri Windows cubugu tasarimla celisiyordu.
         ============================================================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#C2CAD2" CornerRadius="5" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/><Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         IPUCU
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="{StaticResource FontSm}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}" MaxWidth="340">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
</ResourceDictionary>
