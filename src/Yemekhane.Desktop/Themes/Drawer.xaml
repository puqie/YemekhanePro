<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls">

    <!-- StaticResource'un bu dosyadaki ControlTemplate icinde cozulebilmesi icin
         DesignSystem.xaml BURADA da birlestirilir: bir Source= ile yuklenen
         ResourceDictionary'nin ic StaticResource aramalari, kendi dosyasinda
         bildirdigi sozlukleri gorur; onu sonradan birlestiren App.xaml'in
         SIBLING sozlukleri gorulmez. Bu, App.xaml'in Drawer.xaml'i
         DesignSystem.xaml'den SONRA merge etmesine ragmen ScrimBrush/
         SurfaceBrush/SectionTitle/Action gibi anahtarlarin "bulunamiyor"
         hatasi vermesine yol aciyordu. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignSystem.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Cekmece: sagdan acilan panel. Karartma (scrim) katmani cekmeceyi engelleyici
         olmayan bir bindirme olarak isaretler: ScrimBrush (~%40) kullanilir,
         ScrimStrongBrush (~%80) yalnizca engelleyici diyaloglar icindir. -->
    <Style TargetType="{x:Type controls:Drawer}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Drawer}">
                    <Grid>
                        <!-- Karartma katmani: disina tiklayinca kapanir. -->
                        <Border x:Name="PART_Scrim" Background="{StaticResource ScrimBrush}"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1,0,0,0"
                                Width="{TemplateBinding DrawerWidth}"
                                HorizontalAlignment="Right" Padding="20">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="PART_Close" Content="Kapat"
                                            Style="{StaticResource Action}"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="Çekmeceyi kapat"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ContentPresenter/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Uc standart olcu. Dar: hizli bakis/onay. Orta: coklu alanli formlar.
         Genis: form ve detay. Once 15 cekmece 6 farkli genislikte (390, 430,
         440, 470, 650) kendi kendini tekrar ediyordu; artik ucu var. -->
    <Style x:Key="DrawerNarrow" TargetType="{x:Type controls:Drawer}" BasedOn="{StaticResource {x:Type controls:Drawer}}">
        <Setter Property="DrawerWidth" Value="400"/>
    </Style>
    <Style x:Key="DrawerMedium" TargetType="{x:Type controls:Drawer}" BasedOn="{StaticResource {x:Type controls:Drawer}}">
        <Setter Property="DrawerWidth" Value="520"/>
    </Style>
    <Style x:Key="DrawerWide" TargetType="{x:Type controls:Drawer}" BasedOn="{StaticResource {x:Type controls:Drawer}}">
        <Setter Property="DrawerWidth" Value="640"/>
    </Style>
</ResourceDictionary>
