<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Yemekhane.Desktop.Controls">

    <!-- StaticResource'un bu dosyadaki ControlTemplate icinde cozulebilmesi icin
         DesignSystem.xaml BURADA da birlestirilir: bir Source= ile yuklenen
         ResourceDictionary'nin ic StaticResource aramalari, kendi dosyasinda
         bildirdigi sozlukleri gorur; onu sonradan birlestiren App.xaml'in
         SIBLING sozlukleri gorulmez. Drawer.xaml ayni tuzaga dustu ve
         DesignSystem.xaml'i kendi icinde merge ederek cozdu; PageShell.xaml
         de ayni deseni izler. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignSystem.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Ortak sayfa iskeleti: Header (Title/Subtitle solda, Actions saginda),
         Filters (opsiyonel kart, Filters null ise tamamen coker), Content
         (ContentPresenter), Footer (FooterLeft solda hata, FooterRight
         saginda sayfalama; her ekranda AYNI konumda). -->
    <Style TargetType="{x:Type controls:PageShell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageShell}">
                    <Border Background="{StaticResource CanvasBrush}">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="PART_FiltersRow" Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: baslik + alt baslik solda, eylemler saginda. -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}"
                                                   VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Filters: opsiyonel kart. Filters null ise satir tamamen coker,
                                 bos bir kart yer kaplamaz. -->
                            <Border x:Name="PART_FiltersCard" Grid.Row="1" Style="{StaticResource Card}"
                                    Margin="0,0,0,12">
                                <ContentPresenter Content="{TemplateBinding Filters}"/>
                            </Border>

                            <!-- Content: sayfa govdesi. -->
                            <ContentPresenter Grid.Row="2"/>

                            <!-- Footer: FooterLeft (hata) solda, FooterRight (sayfalama) saginda;
                                 her ekranda ayni konumda. -->
                            <!-- Iki AYRI sutun: onceden iki ContentPresenter da AYNI hucredeydi,
                                 yani ust uste cizilebiliyorlardi. Soldaki hata/durum metni 900px'e
                                 kadar uzayabildigi icin (bkz. SettingsView FooterLeft MaxWidth=900)
                                 uzun bir sunucu hatasi sagdaki "Kaydet" dugmesinin uzerine binebilir
                                 ve dugme tiklanamaz hale gelebilirdi. Sag sutun Auto: once kendi
                                 genisligini alir, kalan sol tarafa duser. -->
                            <Grid Grid.Row="3" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding FooterLeft}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding FooterRight}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Filters" Value="{x:Null}">
                            <Setter TargetName="PART_FiltersCard" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_FiltersRow" Property="Height" Value="0"/>
                            <Setter TargetName="PART_FiltersCard" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
