<Application x:Class="Yemekhane.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yemekhane.Desktop"
             xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
             Startup="OnStartup" DispatcherUnhandledException="OnDispatcherUnhandledException"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignSystem.xaml"/>
                <ResourceDictionary Source="Themes/Drawer.xaml"/>
                <ResourceDictionary Source="Themes/PageShell.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StudentIdentityConverter x:Key="StudentIdentity" />
            <converters:StatusBadgeConverter x:Key="StatusBadge" />
            <converters:StatusBrushConverter x:Key="StatusBrush" />
            <!-- Ham API kodlarini (ALLOW, Active, Information...) ekranda Turkce gosterir. -->
            <converters:EnumTextConverter x:Key="EnumText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
