<Window x:Class="Yemekhane.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yemekhane.Desktop.Views"
        xmlns:desktop="clr-namespace:Yemekhane.Desktop"
        xmlns:converters="clr-namespace:Yemekhane.Desktop.Converters"
        Title="YemekhanePro • Operasyon Merkezi" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="1440" Height="900"
        MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen"
         Language="tr-TR" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
         UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="YemekhanePro operasyon merkezi">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yemekhane.Desktop;component/Themes/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Cihaz durumlari API'den ham Ingilizce gelir (Error, Reconnecting, Offline).
             Cihazlar ve Ayarlar ekranlarinda cevriliyordu, Dashboard'da kalmisti. -->
        <converters:EnumTextConverter x:Key="EnumText" />
        <!-- Bildirim zamanlari API'den UTC gelir; StringFormat ofseti cevirmez ve 06:09 yerine 03:09 gosterirdi. -->
        <converters:LocalTimeConverter x:Key="LocalTime" />
        <!-- DesignSystem.xaml'in implicit DataGrid stilini GENISLETIR (BasedOn),
             yerine gecmez: implicit stiller birbirini genisletmez, degistirir.
             Once bu stil temayi tumden degistiriyordu ve dashboard'daki
             DataGrid'ler EnableRowVirtualization/EnableColumnVirtualization/
             VirtualizingPanel.*/ScrollViewer.CanContentScroll/FontSize gibi
             ozellikleri sessizce kaybediyordu (Task 3'un baska yerde duzelttigi
             sanal listeleme kaybi). Burada yalnizca dashboard'a ozgu, temada
             OLMAYAN veya kasitli olarak FARKLI degerler kalir. -->
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="18,22,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,28" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-64.png" Width="34" Height="34" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="YemekhanePro logosu"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Yemekhane yönetimi" Foreground="{StaticResource FaintBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="NavigationButtons" Grid.Row="2">
                    <TextBlock Text="GÜNLÜK İŞ" Style="{StaticResource NavGroupTitle}"/>
                    <Button Tag="dashboard" Style="{StaticResource NavItem}" Content="Dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            AutomationProperties.Name="Dashboard sayfasını aç" />
                    <Button Tag="daily-tracking" Style="{StaticResource NavItem}" Content="Günlük Takip"
                            Command="{Binding NavigateDailyTrackingCommand}"
                            AutomationProperties.Name="Günlük Takip sayfasını aç" />
                    <Button Tag="students" Style="{StaticResource NavItem}" Content="Öğrenciler"
                            Command="{Binding NavigateStudentsCommand}"
                            AutomationProperties.Name="Öğrenciler sayfasını aç" />
                    <Button Tag="cash" Style="{StaticResource NavItem}" Content="Kasa"
                            Command="{Binding NavigateCashCommand}"
                            AutomationProperties.Name="Kasa sayfasını aç"
                            Visibility="{Binding CanNavigateCash, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="TANIMLAR" Style="{StaticResource NavGroupTitle}"/>
                    <Button Tag="entitlements" Style="{StaticResource NavItem}" Content="Yemek Hakedişleri"
                            Command="{Binding NavigateEntitlementsCommand}"
                            AutomationProperties.Name="Yemek hakedişleri sayfasını aç"
                            Visibility="{Binding CanNavigateEntitlements, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="holiday-transfer" Style="{StaticResource NavItem}" Content="Takvim / Tatil"
                            Command="{Binding NavigateCalendarCommand}"
                            AutomationProperties.Name="Operasyon takvimini aç"
                            Visibility="{Binding CanNavigateCalendar, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="student-import" Style="{StaticResource NavItem}" Content="Sicil Aktar"
                            Command="{Binding NavigateStudentImportCommand}"
                            AutomationProperties.Name="Sicil aktarma ekranini ac"
                            Visibility="{Binding CanNavigateStudentImport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="definitions" Style="{StaticResource NavItem}" Content="Tanımlar"
                            Command="{Binding NavigateDefinitionsCommand}"
                            AutomationProperties.Name="Tanımlar sayfasını aç"
                            Visibility="{Binding CanNavigateDefinitions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="SİSTEM" Style="{StaticResource NavGroupTitle}"/>
                    <Button Tag="devices" Style="{StaticResource NavItem}" Content="Cihazlar / Turnikeler"
                            Command="{Binding NavigateDevicesCommand}"
                            AutomationProperties.Name="Cihazlar ve turnikeler sayfasını aç" />
                    <Button Tag="device-cards" Style="{StaticResource NavItem}" Content="Kart Yükleme Durumu"
                            Command="{Binding NavigateDeviceCardsCommand}"
                            AutomationProperties.Name="Kart yükleme durumu sayfasını aç" />
                    <Button Tag="sms" Style="{StaticResource NavItem}" Content="SMS Merkezi"
                            Command="{Binding NavigateSmsCommand}"
                            AutomationProperties.Name="SMS merkezini aç"
                            Visibility="{Binding CanNavigateSms, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="reports" Style="{StaticResource NavItem}" Content="Raporlar"
                            Command="{Binding NavigateReportsCommand}"
                            AutomationProperties.Name="Rapor merkezini aç"
                            Visibility="{Binding CanNavigateReports, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="settings" Style="{StaticResource NavItem}" Content="Ayarlar"
                            Command="{Binding NavigateSettingsCommand}"
                            AutomationProperties.Name="Sistem ayarlarını aç"
                            Visibility="{Binding CanNavigateSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{StaticResource NavyLiftBrush}" BorderThickness="0,1,0,0" Padding="4,14,0,0">
                    <StackPanel>
                        <Button Content="Kısayollar  F1" Click="OpenShortcutHelp" Foreground="{StaticResource SidebarTextBrush}" Background="Transparent" BorderBrush="{StaticResource NavyLiftBrush}" Padding="8,5" Margin="0,0,0,12" Cursor="Hand" AutomationProperties.Name="Klavye kısayollarını göster"/>
                        <TextBlock Text="OTURUM" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="SemiBold" />
                        <!-- Memur "JWT" bilmez; kim giris yapmis onu gormek ister. -->
                        <TextBlock x:Name="SessionUserText" Text="Güvenli yerel bağlantı" Foreground="{StaticResource SidebarTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DashboardHost" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Dashboard basligi diger ekranlarin PageShell basligiyla ayni yerde ve
                 stilde: once beyaz 64px'lik ayri bir serit icinde 18px baslikla duruyordu. -->
            <Grid Margin="22,18,22,14">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Operasyon Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Bugünün yemekhane görünümü • Europe/Istanbul" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NotificationButton" Style="{StaticResource Action}" Command="{Binding DataContext.ToggleCommand, ElementName=NotificationHost}"
                            Width="42" Height="34" Padding="0" Margin="0,0,8,0" AutomationProperties.Name="Bildirim merkezini aç">
                        <Grid>
                            <!-- Renkli emoji yerine tek renk sistem simgesi; rozet dugmenin sag ust kosesinde. -->
                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                    Visibility="{Binding DataContext.HasUnread, ElementName=NotificationHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding DataContext.UnreadCount, ElementName=NotificationHost}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Border Background="{StaticResource HoverBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsOffline}" Value="False"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Action}" Command="{Binding RefreshCommand}" Content="Yenile" Margin="0" AutomationProperties.Name="Dashboard verisini yenile" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- HorizontalScrollBarVisibility Auto -> Disabled: Auto oldugunda ScrollViewer
                     icerige SONSUZ genislik verir. O zaman DataGrid "istedigin kadar genis ol"
                     diye olculur, Width="*" ve sabit piksel genislikler anlamini yitirir ve
                     sutunlar WPF'in 20px'lik varsayilan MinWidth'ine coker: Canli Gecisler,
                     Sinif Kullanim Ozeti ve Son Hatalar tablolarinin sutun basliklari hic
                     gorunmuyordu (olculdu: ActualWidth=20). Disabled ile icerik pencere
                     genisligine sigar; zaten Grid'in MinWidth=1000 tanimi alt siniri korur. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinWidth="1000" Margin="22,0,22,18" Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="330" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,14">
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0" Padding="13,11"><StackPanel><TextBlock Text="AKTİF ÖĞRENCİ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.ActiveStudents, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="HAK SAHİBİ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.EntitledStudents, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="HAKEDİŞ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.EntitlementQuantity, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="KULLANILAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Used, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="KALAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Remaining, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="İZİNLİ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.OnLeave, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0,0,0" Padding="13,11"><StackPanel><TextBlock Text="REDDEDİLEN" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Denied, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="13,10" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="Hızlı İşlemler" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding QuickActions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource Action}" Content="{Binding Label}" Command="{Binding Command}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding UnavailableReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions>
                                    <Grid Margin="14,0"><TextBlock Text="Canlı Geçişler" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock Text="son 20" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.RecentAccess}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Saat" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80"/>
                                            <DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentName}" Width="*" MinWidth="130"/>
                                            <DataGridTextColumn Header="No" Binding="{Binding StudentNo}" Width="70"/>
                                            <DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="Auto" MinWidth="105"/>
                                            <DataGridTextColumn Header="Karar" Binding="{Binding Decision, Converter={StaticResource EnumText}, ConverterParameter=Decision}" Width="Auto" MinWidth="95"/>
                                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason, Converter={StaticResource EnumText}, ConverterParameter=Reason}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" Text="Bugün henüz geçiş kaydı yok." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition /></Grid.RowDefinitions>
                                     <Grid Margin="14,0"><TextBlock Text="Cihaz Durumu" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Content="Yönet" Command="{Binding NavigateDevicesCommand}" Style="{StaticResource Action}" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    <UniformGrid Grid.Row="1" Columns="3" Margin="12,0,12,8">
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Online}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/><TextBlock Text="Çevrimiçi" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Offline}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Çevrimdışı" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Error}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/><TextBlock Text="Hata" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel>
                                    </UniformGrid>
                                    <ListView Grid.Row="2" ItemsSource="{Binding Snapshot.Devices}" BorderThickness="0" Margin="7,0"><ListView.ItemTemplate><DataTemplate><Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="9" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Status, Converter={StaticResource EnumText}, ConverterParameter=DeviceStatus}" Foreground="{StaticResource MutedBrush}"/></Border></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Sınıf Kullanım Özeti" Style="{StaticResource SectionTitle}" Margin="14,0" VerticalAlignment="Center"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.ClassUsage}"><DataGrid.Columns><DataGridTextColumn Header="Sınıf" Binding="{Binding ClassName}" Width="*"/><DataGridTextColumn Header="Kullanılan" Binding="{Binding Used}" Width="100"/><DataGridTextColumn Header="Hakediş" Binding="{Binding EntitlementQuantity}" Width="100"/></DataGrid.Columns></DataGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Son Hatalar" Style="{StaticResource SectionTitle}" Margin="14,0" VerticalAlignment="Center"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.RecentErrors}"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="110"/><DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="Auto" MinWidth="110"/><DataGridTextColumn Header="Seviye" Binding="{Binding Severity, Converter={StaticResource EnumText}, ConverterParameter=LogLevel}" Width="Auto" MinWidth="72"/><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="3" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Dashboard yükleniyor…" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Width="460" Padding="28" Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoginRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel><TextBlock Text="Oturum sona erdi" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Güvenli oturum artık geçerli değil. Uygulamayı yeniden açarak tekrar giriş yapın." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="19" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Width="460" Padding="28" Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel><TextBlock Text="Dashboard kullanılamıyor" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/><Button Style="{StaticResource Action}" Command="{Binding RefreshCommand}" Content="Tekrar dene" HorizontalAlignment="Left"/></StackPanel>
                </Border>
            </Grid>
        </Grid>
        <views:DailyTrackingView x:Name="DailyTrackingHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:StudentsView x:Name="StudentsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:MealEntitlementsView x:Name="MealEntitlementsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:CalendarView x:Name="CalendarHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:DevicesView x:Name="DevicesHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:DeviceCardsView x:Name="DeviceCardsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:SmsView x:Name="SmsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:CashView x:Name="CashHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:ReportsView x:Name="ReportsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:SettingsView x:Name="SettingsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:StudentImportView x:Name="StudentImportHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:DefinitionsView x:Name="DefinitionsHost" Grid.Column="1" Visibility="Collapsed"/>
        <Grid x:Name="NotificationHost" Grid.Column="1" Panel.ZIndex="90" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="390" MaxHeight="650" Margin="0,58,18,0"
              Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Bildirimler" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="En yeni operasyon olayları" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        <Button Content="Tümünü okundu işaretle" Command="{Binding MarkAllReadCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Action}" Padding="8,4"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,9,0,3">
                        <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Canlı bağlantı yok; son kaydedilen bildirimler gösteriliyor." Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" Visibility="{Binding IsOffline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Grid Grid.Row="2"><ListBox ItemsSource="{Binding Items}" BorderThickness="0" MaxHeight="520">
                        <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                            <Grid Margin="2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource HoverBrush}" CornerRadius="11" Padding="6,3" VerticalAlignment="Top"><TextBlock Text="{Binding Severity, Converter={StaticResource EnumText}, ConverterParameter=NotificationSeverity}" FontSize="9" TextAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding LatestAt, Converter={StaticResource LocalTime}, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource FaintBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}×{0}}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Visibility="{Binding Count, Converter={x:Static desktop:RepeatCountToVisibilityConverter.Instance}}"/>
                            </Grid></Button></DataTemplate></ListBox.ItemTemplate>
                    </ListBox><TextBlock Text="Henüz bildirim yok." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="GlobalSearchHost" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource ScrimStrongBrush}" />
            <Border Width="680" MaxHeight="620" VerticalAlignment="Top" Margin="0,105,0,0"
                    Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="18" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="GlobalSearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Padding="13,10" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                 AutomationProperties.Name="Global arama" />
                        <TextBlock Text="Öğrenci, kart, sınıf, tarih veya modül ara..." Foreground="{StaticResource FaintBrush}"
                                   Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="2" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ListBox x:Name="SearchResults" Grid.Row="2" Margin="0,10,0,0" BorderThickness="0"
                             ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             KeyboardNavigation.DirectionalNavigation="Contained" MaxHeight="470">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="8,10,8,5"/>
                        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="{StaticResource AccentSoftBrush}" CornerRadius="14"><TextBlock Text="{Binding Icon}" FontSize="9" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="4,12,4,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="↑↓ seç  •  Enter aç  •  Esc kapat" HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}"/></Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ShortcutHelpHost" Grid.ColumnSpan="2" Panel.ZIndex="200" Visibility="Collapsed">
            <Border Background="{StaticResource ScrimStrongBrush}" MouseLeftButtonDown="CloseShortcutHelp"/>
            <!-- Durum sutunu 190 px'te "Yalnızca Raporlar ve ..." gibi metinleri kesiyordu; genisletildi ve sarmalanir. -->
            <Border Width="700" MaxHeight="680" Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Klavye Kısayolları" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Durumlar geçerli ekran ve oturum yetkilerine göre güncellenir." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Content="Kapat" Click="CloseShortcutHelp" Style="{StaticResource Action}" HorizontalAlignment="Right"/></Grid>
                    <ItemsControl x:Name="ShortcutHelpList" Grid.Row="1" Margin="0,16,0,10">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><Border Background="{StaticResource HoverBrush}" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Gesture}" FontFamily="Consolas" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="Enter, çok satırlı metin alanlarında satır eklemeyi korur." Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Oturum suresi dolunca ekranin ustune cikar; alttaki ekranlar ve formlar
             oldugu gibi kalir. Kisayol katmanlarindan (200) ustte: Esc bunu kapatamaz,
             cunku kapatmanin tek yolu yeniden giris ya da uygulamadan cikistir. -->
        <Grid x:Name="SessionExpiredHost" Grid.ColumnSpan="2" Panel.ZIndex="300" Visibility="Collapsed">
            <Border Background="{StaticResource ScrimStrongBrush}"/>
            <Border Width="480" Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Oturum süresi doldu" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Güvenlik için oturumunuz kapatıldı. Yeniden giriş yaptığınızda açık ekranlar ve doldurduğunuz formlar kaldığı yerden devam eder." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="19" Margin="0,10,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Uygulamayı kapat" Click="CloseApplication" Style="{StaticResource Action}" Margin="0,0,10,0" AutomationProperties.Name="Uygulamayı kapat"/>
                        <Button x:Name="ReloginButton" Content="Yeniden giriş yap" Click="RequestRelogin" Style="{StaticResource Primary}" IsDefault="True" AutomationProperties.Name="Yeniden giriş yap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
