<Window x:Class="Yemekhane.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yemekhane.Desktop.Views"
        Title="YemekhanePro • Operasyon Merkezi" Icon="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-256.png" Width="1440" Height="900"
        MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen"
         Language="tr-TR" Background="#F5F6F7" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
         UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="YemekhanePro operasyon merkezi">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="Ink" Color="#18222D" />
        <SolidColorBrush x:Key="Muted" Color="#65717E" />
        <SolidColorBrush x:Key="Line" Color="#E1E5E9" />
        <SolidColorBrush x:Key="Accent" Color="#C33A02" />
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button" x:Key="QuietButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F2" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#18222D">
            <Grid Margin="18,22,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,28" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Yemekhane.Desktop;component/Assets/logo-64.png" Width="34" Height="34" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="YemekhanePro logosu"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YEMEKHANEPRO" Foreground="White" FontWeight="Bold" FontSize="17" />
                        <TextBlock Text="Yemekhane yönetimi" Foreground="#93A0AD" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="OPERASYON" Foreground="#73808D" FontWeight="SemiBold" FontSize="10" Margin="5,0,0,9" />
                <StackPanel x:Name="NavigationButtons" Grid.Row="2">
                    <Button Tag="dashboard" Command="{Binding NavigateDashboardCommand}" Background="#2F3B49" BorderThickness="0" Padding="11,10" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Dashboard sayfasını aç">
                        <TextBlock Text="▦   Dashboard" Foreground="#E7FFFA" FontWeight="SemiBold" />
                    </Button>
                    <Button Tag="daily-tracking" Command="{Binding NavigateDailyTrackingCommand}" Content="Günlük Takip" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Günlük Takip sayfasını aç" />
                    <Button Tag="students" Command="{Binding NavigateStudentsCommand}" Content="Öğrenciler" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Öğrenciler sayfasını aç" />
                    <Button Tag="entitlements" Command="{Binding NavigateEntitlementsCommand}" Content="Yemek Hakedişleri" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Yemek hakedişleri sayfasını aç" Visibility="{Binding CanNavigateEntitlements, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="holiday-transfer" Command="{Binding NavigateCalendarCommand}" Content="Takvim / Tatil" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Operasyon takvimini aç" Visibility="{Binding CanNavigateCalendar, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="devices" Command="{Binding NavigateDevicesCommand}" Content="Cihazlar / Turnikeler" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Cihazlar ve turnikeler sayfasını aç" />
                    <Button Tag="device-cards" Command="{Binding NavigateDeviceCardsCommand}" Content="Kart Yükleme Durumu" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Kart yükleme durumu sayfasını aç" />
                    <Button Tag="sms" Command="{Binding NavigateSmsCommand}" Content="SMS Merkezi" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="SMS merkezini aç" Visibility="{Binding CanNavigateSms, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="cash" Command="{Binding NavigateCashCommand}" Content="Kasa" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Kasa sayfasını aç" Visibility="{Binding CanNavigateCash, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="reports" Command="{Binding NavigateReportsCommand}" Content="Raporlar" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Rapor merkezini aç" Visibility="{Binding CanNavigateReports, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Tag="settings" Command="{Binding NavigateSettingsCommand}" Content="Ayarlar" Foreground="#D6DBE0" Background="Transparent" BorderThickness="0" Padding="11,10" Margin="0,7,0,0" HorizontalContentAlignment="Left" Cursor="Hand" AutomationProperties.Name="Sistem ayarlarını aç" Visibility="{Binding CanNavigateSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="#34414C" BorderThickness="0,1,0,0" Padding="4,14,0,0">
                    <StackPanel>
                        <Button Content="Kısayollar  F1" Click="OpenShortcutHelp" Foreground="#D6DBE0" Background="Transparent" BorderBrush="#4A5864" Padding="8,5" Margin="0,0,0,12" Cursor="Hand" AutomationProperties.Name="Klavye kısayollarını göster"/>
                        <TextBlock Text="API OTURUMU" Foreground="#73808D" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="JWT ile güvenli bağlantı" Foreground="#B4BEC7" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DashboardHost" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Operasyon Dashboard" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Bugünün yemekhane görünümü • Europe/Istanbul" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NotificationButton" Style="{StaticResource QuietButton}" Command="{Binding DataContext.ToggleCommand, ElementName=NotificationHost}"
                                Width="42" Height="34" Padding="0" Margin="0,0,8,0" AutomationProperties.Name="Bildirim merkezini aç">
                            <Grid><TextBlock Text="🔔" FontFamily="Segoe UI Emoji" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="#B23A32" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0"
                                        Visibility="{Binding DataContext.HasUnread, ElementName=NotificationHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DataContext.UnreadCount, ElementName=NotificationHost}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Border Background="#F7F4F2" CornerRadius="12" Padding="9,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse"><Setter Property="Fill" Value="#C4483F" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsOffline}" Value="False"><Setter Property="Fill" Value="#1E7A54" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" Content="↻  Yenile" AutomationProperties.Name="Dashboard verisini yenile" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid MinWidth="1000" Margin="22,18" Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="330" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,14">
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0" Padding="13,11"><StackPanel><TextBlock Text="AKTİF ÖĞRENCİ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.ActiveStudents, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="HAK SAHİBİ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.EntitledStudents, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="HAKEDİŞ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.EntitlementQuantity, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="KULLANILAN" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Used, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="#C33A02" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="KALAN" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Remaining, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="#356890" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0" Padding="13,11"><StackPanel><TextBlock Text="İZİNLİ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.OnLeave, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="#8A681D" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Panel}" Margin="7,0,0,0" Padding="13,11"><StackPanel><TextBlock Text="REDDEDİLEN" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Snapshot.Kpis.Denied, StringFormat=N0}" FontSize="25" FontWeight="SemiBold" Foreground="#A4403A" Margin="0,4,0,0"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="13,10" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="Hızlı İşlemler" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding QuickActions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource QuietButton}" Content="{Binding Label}" Command="{Binding Command}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding UnavailableReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions>
                                    <Grid Margin="14,0"><TextBlock Text="Canlı Geçişler" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock Text="son 20" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.RecentAccess}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Saat" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="98"/>
                                            <DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentName}" Width="*" MinWidth="130"/>
                                            <DataGridTextColumn Header="No" Binding="{Binding StudentNo}" Width="70"/>
                                            <DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="105"/>
                                            <DataGridTextColumn Header="Karar" Binding="{Binding Decision}" Width="68"/>
                                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" Text="Bugün henüz geçiş kaydı yok." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition /></Grid.RowDefinitions>
                                     <Grid Margin="14,0"><TextBlock Text="Cihaz Durumu" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Content="Yönet" Command="{Binding NavigateDevicesCommand}" Style="{StaticResource QuietButton}" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    <UniformGrid Grid.Row="1" Columns="3" Margin="12,0,12,8">
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Online}" FontSize="21" FontWeight="SemiBold" Foreground="#1E7A54" HorizontalAlignment="Center"/><TextBlock Text="Çevrimiçi" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Offline}" FontSize="21" FontWeight="SemiBold" Foreground="#65717E" HorizontalAlignment="Center"/><TextBlock Text="Çevrimdışı" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Snapshot.DeviceSummary.Error}" FontSize="21" FontWeight="SemiBold" Foreground="#A4403A" HorizontalAlignment="Center"/><TextBlock Text="Hata" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
                                    </UniformGrid>
                                    <ListView Grid.Row="2" ItemsSource="{Binding Snapshot.Devices}" BorderThickness="0" Margin="7,0"><ListView.ItemTemplate><DataTemplate><Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding Type}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><Border Grid.Column="1" Background="#F7F4F2" CornerRadius="9" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/></Border></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Sınıf Kullanım Özeti" Style="{StaticResource SectionTitle}" Margin="14,0" VerticalAlignment="Center"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.ClassUsage}"><DataGrid.Columns><DataGridTextColumn Header="Sınıf" Binding="{Binding ClassName}" Width="*"/><DataGridTextColumn Header="Kullanılan" Binding="{Binding Used}" Width="100"/><DataGridTextColumn Header="Hakediş" Binding="{Binding EntitlementQuantity}" Width="100"/></DataGrid.Columns></DataGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Son Hatalar" Style="{StaticResource SectionTitle}" Margin="14,0" VerticalAlignment="Center"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.RecentErrors}"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="110"/><DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="110"/><DataGridTextColumn Header="Seviye" Binding="{Binding Severity}" Width="72"/><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="3" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Dashboard yükleniyor…" Foreground="{StaticResource Muted}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Width="460" Padding="28" Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoginRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel><TextBlock Text="Oturum sona erdi" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="Güvenli oturum artık geçerli değil. Uygulamayı yeniden açarak tekrar giriş yapın." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="19" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Width="460" Padding="28" Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel><TextBlock Text="Dashboard kullanılamıyor" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,16"/><Button Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" Content="Tekrar dene" HorizontalAlignment="Left"/></StackPanel>
                </Border>
            </Grid>
        </Grid>
        <views:DailyTrackingView x:Name="DailyTrackingHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:StudentsView x:Name="StudentsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:MealEntitlementsView x:Name="MealEntitlementsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:CalendarView x:Name="CalendarHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:DevicesView x:Name="DevicesHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:DeviceCardsView x:Name="DeviceCardsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:SmsView x:Name="SmsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:CashView x:Name="CashHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:ReportsView x:Name="ReportsHost" Grid.Column="1" Visibility="Collapsed"/>
        <views:SettingsView x:Name="SettingsHost" Grid.Column="1" Visibility="Collapsed"/>
        <Grid x:Name="NotificationHost" Grid.Column="1" Panel.ZIndex="90" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="390" MaxHeight="650" Margin="0,58,18,0"
              Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD2D8" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Bildirimler" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="En yeni operasyon olayları" Foreground="#65717E"/></StackPanel>
                        <Button Content="Tümünü okundu işaretle" Command="{Binding MarkAllReadCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Padding="8,4"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,9,0,3">
                        <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Canlı bağlantı yok; son kaydedilen bildirimler gösteriliyor." Foreground="#8A681D" Margin="0,6,0,0" Visibility="{Binding IsOffline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="#A4403A" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Grid Grid.Row="2"><ListBox ItemsSource="{Binding Items}" BorderThickness="0" MaxHeight="520">
                        <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                            <Grid Margin="2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="#F7F4F2" CornerRadius="11" Padding="6,3" VerticalAlignment="Top"><TextBlock Text="{Binding Severity}" FontSize="9" TextAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Foreground="#65717E" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding LatestAt, StringFormat={}{0:dd.MM HH:mm}}" Foreground="#89939D" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}×{0}}" Foreground="#C33A02" FontWeight="SemiBold" Visibility="{Binding Count}"/>
                            </Grid></Button></DataTemplate></ListBox.ItemTemplate>
                    </ListBox><TextBlock Text="Henüz bildirim yok." Foreground="#65717E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="GlobalSearchHost" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#99000000" />
            <Border Width="680" MaxHeight="620" VerticalAlignment="Top" Margin="0,105,0,0"
                    Background="White" BorderBrush="#CBD2D8" BorderThickness="1" CornerRadius="10"
                    Padding="18" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="GlobalSearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Padding="13,10" BorderBrush="#AEB8C1" BorderThickness="1"
                                 AutomationProperties.Name="Global arama" />
                        <TextBlock Text="Öğrenci, kart, sınıf, tarih veya modül ara..." Foreground="#89939D"
                                   Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="2" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ListBox x:Name="SearchResults" Grid.Row="2" Margin="0,10,0,0" BorderThickness="0"
                             ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             KeyboardNavigation.DirectionalNavigation="Contained" MaxHeight="470">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#65717E" Margin="8,10,8,5"/>
                        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="#FDEDE3" CornerRadius="14"><TextBlock Text="{Binding Icon}" FontSize="9" Foreground="#C33A02" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#18222D"/><TextBlock Text="{Binding Subtitle}" Foreground="#65717E" Margin="0,2,0,0"/></StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="4,12,4,0"><TextBlock Text="{Binding StatusText}" Foreground="#65717E"/><TextBlock Text="↑↓ seç  •  Enter aç  •  Esc kapat" HorizontalAlignment="Right" Foreground="#89939D"/></Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ShortcutHelpHost" Grid.ColumnSpan="2" Panel.ZIndex="200" Visibility="Collapsed">
            <Border Background="#99000000" MouseLeftButtonDown="CloseShortcutHelp"/>
            <Border Width="610" MaxHeight="650" Background="White" BorderBrush="#CBD2D8" BorderThickness="1" CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Klavye Kısayolları" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Durumlar geçerli ekran ve oturum yetkilerine göre güncellenir." Foreground="#65717E" Margin="0,4,0,0"/></StackPanel><Button Content="Kapat" Click="CloseShortcutHelp" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid>
                    <ItemsControl x:Name="ShortcutHelpList" Grid.Row="1" Margin="0,16,0,10">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Border Background="#F7F4F2" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Gesture}" FontFamily="Consolas" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#65717E" VerticalAlignment="Center" TextAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="#A4403A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="Enter, çok satırlı metin alanlarında satır eklemeyi korur." Foreground="#65717E"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
