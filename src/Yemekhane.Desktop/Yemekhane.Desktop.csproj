<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Yemekhane.Application\Yemekhane.Application.csproj" />
    <ProjectReference Include="..\Yemekhane.Infrastructure\Yemekhane.Infrastructure.csproj" />
    <ProjectReference Include="..\Yemekhane.Devices\Yemekhane.Devices.csproj" />
    <ProjectReference Include="..\Yemekhane.Reports\Yemekhane.Reports.csproj" />
    <ProjectReference Include="..\Yemekhane.Sync\Yemekhane.Sync.csproj" />
    <ProjectReference Include="..\Yemekhane.Licensing\Yemekhane.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\logo-256.png" />
    <Resource Include="Assets\logo-64.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Gomulmezse Windows genel bir pencere simgesi gosterir ve kullanici
         gorev cubugunda uygulamayi ayirt edemez. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- Lisans imza sirri KAYNAKTA bos kalir: depoya gercek bir sir girerse onu goren
       herkes sahte lisans uretebilir ve koruma anlamini yitirir.

       Sir yayin sirasinda enjekte edilir:
           dotnet publish -p:LicensingSigningSecret=<sir>

       Enjekte EDILMEZSE yayinlanan uygulama acilista durur (LicenseGate acik hata
       verir). Bu yuzden hedef, sir verilmediginde uyari uretir: hatanin musteride
       degil yayin sirasinda fark edilmesi gerekir. -->
  <Target Name="InjectLicensingSigningSecret" AfterTargets="Publish">
    <Warning Condition="'$(LicensingSigningSecret)' == ''"
             Text="LicensingSigningSecret verilmedi. Yayinlanan uygulama acilista duracaktir. Kullanim: dotnet publish -p:LicensingSigningSecret=&lt;sir&gt;" />

    <!-- Yayin ciktisindaki appsettings.json icinde yalnizca bos sir alani degistirilir;
         kaynak dosyaya DOKUNULMAZ. -->
    <WriteLinesToFile Condition="'$(LicensingSigningSecret)' != ''"
                      File="$(PublishDir)appsettings.json"
                      Lines="$([System.IO.File]::ReadAllText('$(PublishDir)appsettings.json').Replace('&quot;SigningSecret&quot;: &quot;&quot;', '&quot;SigningSecret&quot;: &quot;$(LicensingSigningSecret)&quot;'))"
                      Overwrite="true"
                      Encoding="UTF-8" />

    <!-- ACIK ANAHTAR: verilirse kuruluma gomulur ve HMAC sirri YERINE kullanilir.
         Acik anahtar lisansi dogrular ama URETEMEZ; musteri kurulum klasorunu acip
         okusa bile kendine lisans yazamaz. HMAC sirri okunsaydi yazabilirdi. -->
    <WriteLinesToFile Condition="'$(LicensingPublicKey)' != ''"
                      File="$(PublishDir)appsettings.json"
                      Lines="$([System.IO.File]::ReadAllText('$(PublishDir)appsettings.json').Replace('&quot;PublicKey&quot;: &quot;&quot;', '&quot;PublicKey&quot;: &quot;$(LicensingPublicKey)&quot;'))"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

</Project>
