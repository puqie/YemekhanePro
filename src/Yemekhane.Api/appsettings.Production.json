{
  "Deployment": {
    "Mode": "Local",
    "TimeZone": "Europe/Istanbul",
    "ForwardedHeadersEnabled": false,
    "KnownProxies": [],
    "CorsOrigins": []
  },
  "LocalDatabase": {
    "DataDirectory": "%LOCALAPPDATA%\\YemekhanePro",
    "BusyTimeoutSeconds": 5
  },
  "Devices": {
    "HealthIntervalSeconds": 30,
    "OperationTimeoutSeconds": 15
  },
  "Sync": {
    "Enabled": false,
    "Endpoint": "",
    "IntervalMinutes": 5,
    "TimeoutSeconds": 30
  },
  "Sms": {
    "Provider": "Http",
    "Endpoint": "https://sms.invalid/",
    "TimeoutSeconds": 30,
    "DispatchIntervalSeconds": 10
  },
  "Backup": {
    "ScheduleEnabled": true,
    "Schedule": "Daily",
    "Time": "02:00:00",
    "RetentionCount": 14
  },
  "Schedulers": {
    "NotificationRetentionHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "%LOCALAPPDATA%\\YemekhanePro\\logs",
      "RetentionDays": 30,
      "FileSizeLimitBytes": 52428800
    }
  }
}
